From: Yong Liu <lyrids@me.com>
Subject: [PATCH] wifi: ath11k: serialize RX fragments and defer peer timer destruction

Keep fragment RX, flush and TID cleanup under base_lock. Nonblocking timer
deletion avoids dropping peer protection and avoids waiting on a callback
which needs the same lock. Ignore an expired callback if RX rearmed its
timer while the callback waited for the lock.

Initialize fragment timers before publishing every peer. Route all peer
free sites through a work item which shuts timers down synchronously
without base_lock before freeing the allocation. Drain this work through
the existing core workqueue lifetime. Stop datapath RX before TID cleanup.

Signed-off-by: Yong Liu <lyrids@me.com>

--- a/drivers/net/wireless/ath/ath11k/peer.h
+++ b/drivers/net/wireless/ath/ath11k/peer.h
@@ -6,6 +6,8 @@
 
 #ifndef ATH11K_PEER_H
 #define ATH11K_PEER_H
+
+#include <linux/workqueue.h>
 
 struct ath11k_peer {
 	struct list_head list;
@@ -35,8 +37,12 @@
 	u16 sec_type_grp;
 	bool is_authorized;
 	bool dp_setup_done;
+
+	/* Preserve the offsets of existing peer members. */
+	struct work_struct delete_work;
 };
 
+void ath11k_peer_free(struct ath11k_base *ab, struct ath11k_peer *peer);
 void ath11k_peer_unmap_event(struct ath11k_base *ab, u16 peer_id);
 void ath11k_peer_map_event(struct ath11k_base *ab, u8 vdev_id, u16 peer_id,
 			   u8 *mac_addr, u16 ast_hash, u16 hw_peer_id);
--- a/drivers/net/wireless/ath/ath11k/peer.c
+++ b/drivers/net/wireless/ath/ath11k/peer.c
@@ -8,6 +8,7 @@
 
 #include <linux/soc/qcom/nss_wifi.h>
 #include "peer.h"
+#include "dp_rx.h"
 #include "debug.h"
 
 static struct ath11k_peer *ath11k_peer_find_list_by_id(struct ath11k_base *ab,
@@ -95,6 +96,33 @@
 	return NULL;
 }
 
+static void ath11k_peer_delete_work(struct work_struct *work)
+{
+	struct ath11k_peer *peer = container_of(work, struct ath11k_peer,
+					      delete_work);
+	int i;
+
+	/* No peer lock is held: callbacks can acquire it and finish. */
+	for (i = 0; i <= IEEE80211_NUM_TIDS; i++)
+		timer_shutdown_sync(&peer->rx_tid[i].frag_timer);
+
+	kfree(peer);
+}
+
+void ath11k_peer_free(struct ath11k_base *ab, struct ath11k_peer *peer)
+{
+	lockdep_assert_held(&ab->base_lock);
+
+	/* Callers have removed the peer from their lookup/list ownership.
+	 * Stop RX before releasing cached fragments. The worker retains the
+	 * allocation until even a callback already waiting on base_lock exits.
+	 * core_free() drains this workqueue before freeing ab.
+	 */
+	peer->dp_setup_done = false;
+	ath11k_peer_frags_flush(ab, peer);
+	queue_work(ab->workqueue, &peer->delete_work);
+}
+
 void ath11k_peer_unmap_event(struct ath11k_base *ab, u16 peer_id)
 {
 	struct ath11k_peer *peer;
@@ -112,7 +140,7 @@
 		   peer->vdev_id, peer->addr, peer_id);
 
 	list_del(&peer->list);
-	kfree(peer);
+	ath11k_peer_free(ab, peer);
 	wake_up(&ab->peer_mapping_wq);
 
 exit:
@@ -131,6 +159,8 @@
 		if (!peer)
 			goto exit;
 
+		INIT_WORK(&peer->delete_work, ath11k_peer_delete_work);
+		ath11k_peer_rx_frag_init(ab, peer);
 		peer->vdev_id = vdev_id;
 		peer->peer_id = peer_id;
 		peer->ast_hash = ast_hash;
@@ -257,7 +287,7 @@
 
 		ath11k_peer_rhash_delete(ab, peer);
 		list_del(&peer->list);
-		kfree(peer);
+		ath11k_peer_free(ab, peer);
 		ar->num_peers--;
 	}
 
--- a/drivers/net/wireless/ath/ath11k/dp_rx.h
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.h
@@ -50,7 +50,8 @@
 				       const u8 *peer_addr,
 				       enum set_key_cmd key_cmd,
 				       struct ieee80211_key_conf *key);
-void ath11k_peer_frags_flush(struct ath11k *ar, struct ath11k_peer *peer);
+void ath11k_peer_rx_frag_init(struct ath11k_base *ab, struct ath11k_peer *peer);
+void ath11k_peer_frags_flush(struct ath11k_base *ab, struct ath11k_peer *peer);
 void ath11k_peer_rx_tid_cleanup(struct ath11k *ar, struct ath11k_peer *peer);
 void ath11k_peer_rx_tid_delete(struct ath11k *ar,
 			       struct ath11k_peer *peer, u8 tid);
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -898,19 +898,18 @@
 	__skb_queue_purge(&rx_tid->rx_frags);
 }
 
-void ath11k_peer_frags_flush(struct ath11k *ar, struct ath11k_peer *peer)
+void ath11k_peer_frags_flush(struct ath11k_base *ab, struct ath11k_peer *peer)
 {
 	struct dp_rx_tid *rx_tid;
 	int i;
 
-	lockdep_assert_held(&ar->ab->base_lock);
+	lockdep_assert_held(&ab->base_lock);
 
 	for (i = 0; i <= IEEE80211_NUM_TIDS; i++) {
 		rx_tid = &peer->rx_tid[i];
 
-		spin_unlock_bh(&ar->ab->base_lock);
-		timer_delete_sync(&rx_tid->frag_timer);
-		spin_lock_bh(&ar->ab->base_lock);
+		/* The callback also takes base_lock. Do not wait for it here. */
+		timer_delete(&rx_tid->frag_timer);
 
 		ath11k_dp_rx_frags_cleanup(rx_tid, true);
 	}
@@ -926,12 +925,9 @@
 	for (i = 0; i <= IEEE80211_NUM_TIDS; i++) {
 		rx_tid = &peer->rx_tid[i];
 
+		timer_delete(&rx_tid->frag_timer);
 		ath11k_peer_rx_tid_delete(ar, peer, i);
 		ath11k_dp_rx_frags_cleanup(rx_tid, true);
-
-		spin_unlock_bh(&ar->ab->base_lock);
-		timer_delete_sync(&rx_tid->frag_timer);
-		spin_lock_bh(&ar->ab->base_lock);
 	}
 }
 
@@ -3342,8 +3338,12 @@
 						      frag_timer);
 
 	spin_lock_bh(&rx_tid->ab->base_lock);
-	if (rx_tid->last_frag_no &&
-	    rx_tid->rx_frag_bitmap == GENMASK(rx_tid->last_frag_no, 0)) {
+	/* An expired callback may have waited for RX to rearm this timer.
+	 * It must not discard fragments belonging to that newer expiry.
+	 */
+	if (timer_pending(&rx_tid->frag_timer) ||
+	    (rx_tid->last_frag_no &&
+	     rx_tid->rx_frag_bitmap == GENMASK(rx_tid->last_frag_no, 0))) {
 		spin_unlock_bh(&rx_tid->ab->base_lock);
 		return;
 	}
@@ -3351,12 +3351,26 @@
 	spin_unlock_bh(&rx_tid->ab->base_lock);
 }
 
+void ath11k_peer_rx_frag_init(struct ath11k_base *ab, struct ath11k_peer *peer)
+{
+	struct dp_rx_tid *rx_tid;
+	int i;
+
+	/* Initialize all timers before publishing the peer, including peers
+	 * whose later datapath setup fails or is never requested.
+	 */
+	for (i = 0; i <= IEEE80211_NUM_TIDS; i++) {
+		rx_tid = &peer->rx_tid[i];
+		rx_tid->ab = ab;
+		timer_setup(&rx_tid->frag_timer, ath11k_dp_rx_frag_timer, 0);
+		skb_queue_head_init(&rx_tid->rx_frags);
+	}
+}
+
 int ath11k_peer_rx_frag_setup(struct ath11k *ar, const u8 *peer_mac, int vdev_id)
 {
 	struct ath11k_base *ab = ar->ab;
 	struct ath11k_peer *peer;
-	struct dp_rx_tid *rx_tid;
-	int i;
 
 	if (fips_enabled) {
 		ath11k_warn(ab, "This driver is disabled due to FIPS\n");
@@ -3370,13 +3384,6 @@
 		ath11k_warn(ab, "failed to find the peer to set up fragment info\n");
 		spin_unlock_bh(&ab->base_lock);
 		return -ENOENT;
-	}
-
-	for (i = 0; i <= IEEE80211_NUM_TIDS; i++) {
-		rx_tid = &peer->rx_tid[i];
-		rx_tid->ab = ab;
-		timer_setup(&rx_tid->frag_timer, ath11k_dp_rx_frag_timer, 0);
-		skb_queue_head_init(&rx_tid->rx_frags);
 	}
 
 	peer->dp_setup_done = true;
@@ -3841,13 +3848,11 @@
 		goto out_unlock;
 	}
 
-	spin_unlock_bh(&ab->base_lock);
-	timer_delete_sync(&rx_tid->frag_timer);
-	spin_lock_bh(&ab->base_lock);
-
-	peer = ath11k_peer_find_by_id(ab, peer_id);
-	if (!peer)
-		goto err_frags_cleanup;
+	/* Keep peer, rx_tid and the fragment queue protected throughout
+	 * reassembly. A running timeout callback waits for this lock and
+	 * observes the cleaned queue (or a newly pending expiry) afterwards.
+	 */
+	timer_delete(&rx_tid->frag_timer);
 
 	if (!ath11k_dp_rx_h_defrag_validate_incr_pn(ar, rx_tid))
 		goto err_frags_cleanup;
--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -41,8 +41,8 @@
 		return;
 	}
 
+	peer->dp_setup_done = false;
 	ath11k_peer_rx_tid_cleanup(ar, peer);
-	peer->dp_setup_done = false;
 	spin_unlock_bh(&ab->base_lock);
 }
 
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -889,7 +889,7 @@
 		ath11k_peer_rx_tid_cleanup(ar, peer);
 		ath11k_peer_rhash_delete(ab, peer);
 		list_del(&peer->list);
-		kfree(peer);
+		ath11k_peer_free(ab, peer);
 	}
 	spin_unlock_bh(&ab->base_lock);
 	mutex_unlock(&ab->tbl_mtx_lock);
@@ -4569,7 +4569,7 @@
 	 * ensure all frags in the new frag list belong to the same key.
 	 */
 	if (peer && sta && cmd == SET_KEY)
-		ath11k_peer_frags_flush(ar, peer);
+		ath11k_peer_frags_flush(ab, peer);
 	spin_unlock_bh(&ab->base_lock);
 
 	if (!peer) {
@@ -10294,7 +10294,7 @@
 			ath11k_peer_rhash_delete(ar->ab, peer);
 			peer->sta = NULL;
 			list_del(&peer->list);
-			kfree(peer);
+			ath11k_peer_free(ar->ab, peer);
 			ar->num_peers--;
 		}
 		spin_unlock_bh(&ar->ab->base_lock);
