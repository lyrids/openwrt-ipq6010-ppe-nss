From: Yong Liu <lyrids@me.com>
Subject: [PATCH] wifi: ath11k: snapshot RX TID DMA addresses under peer lock

The RX TID is embedded in the peer freed by asynchronous unmap. Use
DMA addresses copied under base_lock after unlocking for the WMI call,
as the existing active-queue update branch already does.

Signed-off-by: Yong Liu <lyrids@me.com>

--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -1077,9 +1077,10 @@
 	dma_sync_single_for_device(ab->dev, rx_tid->paddr,
 				   rx_tid->size,
 				   DMA_TO_DEVICE);
+	paddr = rx_tid->paddr;
 	spin_unlock_bh(&ab->base_lock);
 
-	ret = ath11k_wmi_peer_rx_reorder_queue_setup(ar, vdev_id, peer_mac, rx_tid->paddr,
+	ret = ath11k_wmi_peer_rx_reorder_queue_setup(ar, vdev_id, peer_mac, paddr,
 						     tid, 1, ba_win_sz);
 	if (ret) {
 		ath11k_warn(ar->ab, "failed to setup rx reorder queue for peer %pM tid %d: %d\n",
@@ -1114,6 +1115,7 @@
 	struct ath11k_peer *peer;
 	struct ath11k_sta *arsta = ath11k_sta_to_arsta(params->sta);
 	struct dp_rx_tid *rx_tid;
+	dma_addr_t paddr;
 	int vdev_id = arsta->arvif->vdev_id;
 	int ret;
 
@@ -1133,6 +1135,7 @@
 		return 0;
 	}
 
+	paddr = rx_tid->paddr;
 	ret = ath11k_peer_rx_tid_reo_update(ar, peer, rx_tid, 1, 0, false);
 	spin_unlock_bh(&ab->base_lock);
 	if (ret) {
@@ -1143,7 +1146,7 @@
 
 	ret = ath11k_wmi_peer_rx_reorder_queue_setup(ar, vdev_id,
 						     params->sta->addr,
-						     rx_tid->paddr,
+						     paddr,
 						     params->tid, 1, 1);
 	if (ret)
 		ath11k_warn(ab, "failed to send wmi to delete rx tid %d\n",
