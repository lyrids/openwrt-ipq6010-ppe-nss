From: Yong Liu <lyrids@me.com>
Subject: [EXPERIMENT] arm64: opt-in JDCloud SCM warm-entry registration

Disabled by default. Only on jdcloud,re-cs-02 and post-boot CPU_ON,
register the standard secondary entry via the existing QCOM SCM API.
Preserve initial SMP startup, PSCI calls and stuck-CPU checks.
A runtime CPU restart fix is not established. No persistent firmware writes.

--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -14,12 +14,23 @@
 #include <linux/delay.h>
 #include <linux/psci.h>
 #include <linux/mm.h>
+#include <linux/kernel.h>
+#include <linux/moduleparam.h>
+#include <linux/firmware/qcom/qcom_scm.h>
 
 #include <uapi/linux/psci.h>
 
 #include <asm/cpu_ops.h>
 #include <asm/errno.h>
 #include <asm/smp_plat.h>
+
+#if IS_BUILTIN(CONFIG_QCOM_SCM)
+/* Experimental JDCloud-only probe, disabled unless root explicitly opts in.
+ * Do not touch secure warm entry points during initial SMP bring-up.
+ */
+static bool ipq_cpu_warm_vector;
+core_param(ipq_cpu_warm_vector, ipq_cpu_warm_vector, bool, 0644);
+#endif
 
 static int __init cpu_psci_cpu_init(unsigned int cpu)
 {
@@ -47,6 +58,19 @@
 		before = psci_ops.affinity_info(mpidr, 0);
 	pr_info("ipq-cpu-diag: CPU%u mpidr=%#lx entry=%pa affinity-before=%d\n",
 		cpu, mpidr, &pa_secondary_entry, before);
+#if IS_BUILTIN(CONFIG_QCOM_SCM)
+	if (READ_ONCE(ipq_cpu_warm_vector) &&
+	    of_machine_is_compatible("jdcloud,re-cs-02") &&
+	    system_state == SYSTEM_RUNNING) {
+		err = qcom_scm_is_available() ?
+			qcom_scm_set_warm_boot_addr(secondary_entry) : -EPROBE_DEFER;
+		pr_info("ipq-cpu-warm-entry: CPU%u SCM warm-entry=%pa errno=%d\n",
+			cpu, &pa_secondary_entry, err);
+		/* Failed registration is not permission to try another vector. */
+		if (err)
+			return err;
+	}
+#endif
 	err = psci_ops.cpu_on(mpidr, pa_secondary_entry);
 	if (psci_ops.affinity_info)
 		after = psci_ops.affinity_info(mpidr, 0);
