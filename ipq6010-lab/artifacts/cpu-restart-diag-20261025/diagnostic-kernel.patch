From: Yong Liu <lyrids@me.com>
Subject: [DIAGNOSTIC] arm64: trace PSCI CPU restart and secondary startup

Temporary IPQ6010 laboratory tracing only. Preserve CPU startup semantics
and all stuck-CPU checks. Log raw firmware return separately from errno.
No SCM warm-vector or secure-firmware changes.

--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -39,7 +39,19 @@
 static int cpu_psci_cpu_boot(unsigned int cpu)
 {
 	phys_addr_t pa_secondary_entry = __pa_symbol(secondary_entry);
-	int err = psci_ops.cpu_on(cpu_logical_map(cpu), pa_secondary_entry);
+	unsigned long mpidr = cpu_logical_map(cpu);
+	int before = -EOPNOTSUPP, after = -EOPNOTSUPP;
+	int err;
+
+	if (psci_ops.affinity_info)
+		before = psci_ops.affinity_info(mpidr, 0);
+	pr_info("ipq-cpu-diag: CPU%u mpidr=%#lx entry=%pa affinity-before=%d\n",
+		cpu, mpidr, &pa_secondary_entry, before);
+	err = psci_ops.cpu_on(mpidr, pa_secondary_entry);
+	if (psci_ops.affinity_info)
+		after = psci_ops.affinity_info(mpidr, 0);
+	pr_info("ipq-cpu-diag: CPU%u cpu_on-errno=%d affinity-after=%d\n",
+		cpu, err, after);
 	if (err && err != -EPERM)
 		pr_err("failed to boot CPU%d (%d)\n", cpu, err);
 
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -231,6 +231,8 @@
 	int err;
 
 	err = invoke_psci_fn(fn, cpuid, entry_point, 0);
+	pr_info("ipq-cpu-diag: CPU_ON fn=%#x target=%#lx entry=%#lx raw=%d errno=%d\n",
+		fn, cpuid, entry_point, err, psci_to_linux_errno(err));
 	return psci_to_linux_errno(err);
 }
 
--- a/arch/arm64/kernel/smp.c
+++ b/arch/arm64/kernel/smp.c
@@ -138,6 +138,9 @@
 		return 0;
 
 	pr_crit("CPU%u: failed to come online\n", cpu);
+	pr_err("ipq-cpu-diag: CPU%u secondary-status=%#lx early-status=%#lx online=%u\n",
+		cpu, READ_ONCE(secondary_data.status),
+		READ_ONCE(__early_cpu_boot_status), cpu_online(cpu));
 	secondary_data.task = NULL;
 	status = READ_ONCE(secondary_data.status);
 	if (status == CPU_MMU_OFF)
@@ -217,6 +220,7 @@
 
 	rcutree_report_cpu_starting(cpu);
 	trace_hardirqs_off();
+	pr_info("ipq-cpu-diag: CPU%u reached secondary C before capability checks\n", cpu);
 
 	/*
 	 * If the system has established the capabilities, make sure
@@ -239,6 +243,7 @@
 	 * Enable GIC and timers.
 	 */
 	notify_cpu_starting(cpu);
+	pr_info("ipq-cpu-diag: CPU%u completed starting notifiers\n", cpu);
 
 	ipi_setup(cpu);
 
