diff --git a/package/kernel/mac80211/patches/nss-wifi/902-ath11k-return-the-link-descriptors-the-NSS-firmware-hands-back.patch b/package/kernel/mac80211/patches/nss-wifi/902-ath11k-return-the-link-descriptors-the-NSS-firmware-hands-back.patch
new file mode 100644
index 0000000000..b8aa60aaf4
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/902-ath11k-return-the-link-descriptors-the-NSS-firmware-hands-back.patch
@@ -0,0 +1,72 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: return the link descriptors the NSS firmware hands back
+
+The firmware reaps rings holding MSDU-link descriptors it cannot release
+itself: the ring that returns one to the idle list is not among those it is
+told about, so it hands each one back by message instead. The two words it
+sends are the buffer-address information of a release descriptor, which is
+what the return already consumes, so the payload goes through untouched.
+
+ath11k_dp_rx_link_desc_return() is the function that does it and it already
+takes the action that puts a descriptor in the idle list. Give it external
+linkage and hang a thunk off the ring description.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/dp.c
++++ b/drivers/net/wireless/ath/ath11k/dp.c
+@@ -934,6 +934,21 @@ static void ath11k_nss_reset(void *priv)
+ 	queue_work(ab->workqueue_aux, &ab->reset_work);
+ }
+ 
++/* Put back an MSDU-link descriptor the firmware cannot release itself: the
++ * ring that returns one to the idle list is not among those it is told about.
++ * The two words it sends back are the buffer-address info of a release
++ * descriptor, which is exactly what the return consumes.
++ *
++ * Called from the firmware driver's receive poll, so it may not sleep. Late is
++ * the same as never - a descriptor is out of the idle list until this runs,
++ * and an empty idle list stops receive on every radio.
++ */
++static void ath11k_nss_link_desc_return(void *priv, const u32 *buf_addr_info)
++{
++	ath11k_dp_rx_link_desc_return(priv, (u32 *)buf_addr_info,
++				      HAL_WBM_REL_BM_ACT_PUT_IN_IDLE);
++}
++
+ static void ath11k_nss_wifi_describe(struct ath11k_base *ab)
+ {
+ 	struct ath11k_dp *dp = &ab->dp;
+@@ -973,6 +988,7 @@ static void ath11k_nss_wifi_describe(str
+ 	soc->num_pdevs = ab->num_radios;
+ 	soc->priv = ab;
+ 	soc->reset = ath11k_nss_reset;
++	soc->link_desc_return = ath11k_nss_link_desc_return;
+ 
+ 	for (i = 0; i < soc->num_tcl; i++) {
+ 		ath11k_nss_wifi_ring(&soc->tcl[i], ab,
+--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
++++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
