+@@ -443,6 +443,7 @@ struct ieee80211_vif_chanctx_switch {
+  * @BSS_CHANGED_TPE: transmit power envelope changed
+  * @BSS_CHANGED_NAN_LOCAL_SCHED: NAN local schedule changed (NAN mode only)
+  * @BSS_CHANGED_NPCA: NPCA parameters changed
++ * @BSS_CHANGED_AP_ISOLATE: AP isolation changed (AP mode)
+  */
+ enum ieee80211_bss_change {
+ 	BSS_CHANGED_ASSOC		= 1<<0,
+@@ -482,6 +483,7 @@ enum ieee80211_bss_change {
+ 	BSS_CHANGED_TPE			= BIT_ULL(35),
+ 	BSS_CHANGED_NAN_LOCAL_SCHED	= BIT_ULL(36),
+ 	BSS_CHANGED_NPCA		= BIT_ULL(37),
++	BSS_CHANGED_AP_ISOLATE		= BIT_ULL(38),
+ 
+ 	/* when adding here, make sure to change ieee80211_reconfig */
+ };
+@@ -781,6 +783,7 @@ struct ieee80211_bss_npca_params {
+  * @ftm_responder: whether to enable or disable fine timing measurement FTM
