+define KernelPackage/nss-wifi-drv
+  SECTION:=kernel
+  CATEGORY:=Kernel modules
+  SUBMENU:=Network Devices
+  TITLE:=NSS firmware host driver for the Wi-Fi data plane
+  DEPENDS:=@(TARGET_qualcommax_ipq807x||TARGET_qualcommax_ipq60xx) \
+	+nss-firmware +kmod-nft-bridge
+  FILES:=$(PKG_BUILD_DIR)/nss-wifi-drv.ko
+endef
+
+define KernelPackage/nss-wifi-drv/conffiles
+/etc/config/nss-wifi
+endef
+
+define KernelPackage/nss-wifi-drv/description
+  Boots the NSS firmware and speaks its message protocol, so the Wi-Fi
+  data plane runs on the NSS cores instead of the host. Carries only what
+  a Wi-Fi offload needs: the wired ports belong to qca_edma and qca_ppe.
+
+  The module does not autoload: the nss-wifi service loads it and boots a
+  core when nss-wifi.general.offload is 1, the default. The wired ports
+  never depend on it. nss-wifi.general.firmware picks the firmware line,
+  12.5 by default or 11.4 for 802.11s mesh.
+endef
+
+define Build/Prepare
+	mkdir -p $(PKG_BUILD_DIR)
+	$(CP) ./src/* $(PKG_BUILD_DIR)/
+endef
+
+define Build/Compile
+	+$(KERNEL_MAKE) M="$(PKG_BUILD_DIR)" modules
+endef
+
+# The WLAN driver describes its rings through this, and is built by another
+# package, so the description has to be reachable from the staging tree.
+define Build/InstallDev
+	$(INSTALL_DIR) $(1)/usr/include/nss-wifi-drv/linux/soc/qcom
+	$(CP) ./src/include/linux/soc/qcom/nss_wifi.h \
+		$(1)/usr/include/nss-wifi-drv/linux/soc/qcom/
+endef
+
+define KernelPackage/nss-wifi-drv/install
+	$(INSTALL_DIR) $(1)/etc/config $(1)/etc/init.d
+	$(INSTALL_CONF) ./files/nss-wifi.config $(1)/etc/config/nss-wifi
+	$(INSTALL_BIN) ./files/nss-wifi.init $(1)/etc/init.d/nss-wifi
+	$(INSTALL_DIR) $(1)/etc/uci-defaults $(1)/usr/share/nss-wifi
+	$(INSTALL_BIN) ./files/nss-wifi.uci-defaults $(1)/etc/uci-defaults/90-nss-wifi-flowtable
+	$(INSTALL_BIN) ./files/nss-wifi.flowtable $(1)/usr/share/nss-wifi/flowtable.sh
+endef
+
+# The firewall include the uci-defaults script adds goes with the package,
+# or every reload would warn about a missing script.
+define Package/kmod-nss-wifi-drv/prerm
+#!/bin/sh
+[ -n "$${IPKG_INSTROOT}" ] && exit 0
+uci -q delete firewall.nss_wifi_flowtable && uci -q commit firewall
+exit 0
+endef
+
+$(eval $(call KernelPackage,nss-wifi-drv))
diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.config b/package/kernel/nss-wifi-drv/files/nss-wifi.config
new file mode 100644
index 0000000000..e5057dd384
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.config
@@ -0,0 +1,13 @@
+# Wi-Fi data path. '1' hands the radios to the NSS firmware at boot; anything
+# else leaves them on the host path.
+#
+#	uci set nss-wifi.general.offload='0'; uci commit nss-wifi; reboot
+#
+# The decision is a module parameter the radios read at probe, so it cannot be
+# changed without a reboot.
+#
+# 'firmware' is the NSS firmware line booted: '12.5', or '11.4', the line that
+# forwards an 802.11s mesh.
+config general 'general'
+	option offload '1'
+	option firmware '12.5'
diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable b/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable
new file mode 100644
index 0000000000..e5a8dac4ab
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable
@@ -0,0 +1,33 @@
+#!/bin/sh
+# fw4 include, run after every firewall (re)load.
+#
+# fw4 fills its flow table from each interface's main device, and a modem
+# interface has none: its raw-IP device is only the layer-3 device. Without
+# the device in the table, the kernel offers none of its connections for
+# offload. nss-wifi-drv takes the device's flow block, and the firmware
+# carries the connections it can route; without the driver the device only
+# joins the software fast path.
+
+ft=$(nft list flowtable inet fw4 ft 2>/dev/null) || exit 0
+case "$ft" in
+*"flags offload"*) ;;
+*) exit 0 ;;
+esac
+counter=
+case "$ft" in
+*counter*) counter="counter;" ;;
+esac
+
+for dev in $(ubus call network.interface dump 2>/dev/null |
+	     jsonfilter -e '@.interface[@.up=true].l3_device' | sort -u); do
+	[ "$(cat "/sys/class/net/$dev/type" 2>/dev/null)" = 519 ] || continue
+	case "$ft" in
+	*"\"$dev\""*) continue ;;
+	esac
+	# An update replaces the table's flags with the ones it names.
+	nft add flowtable inet fw4 ft \
+		"{ hook ingress priority filter; devices = { \"$dev\" }; flags offload; $counter }" ||
+		logger -t nss-wifi "flow table refused $dev"
+done
+
+exit 0
diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.init b/package/kernel/nss-wifi-drv/files/nss-wifi.init
new file mode 100755
index 0000000000..4be37341d6
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.init
@@ -0,0 +1,145 @@
+#!/bin/sh /etc/rc.common
+# START and USE_PROCD are read by /etc/rc.common, not by this file.
+# shellcheck disable=SC2034
+# Wi-Fi data-path decision, made once before netifd builds the topology.
+#
+# The radios bind their data path at probe and never rebind, so which path
+# they take is a module parameter and not a runtime switch: it has to be
+# decided before the WLAN driver loads. That is the whole reason this service
+# exists, and it is why the bus module carries no autoload - unloading and
+# reloading the WLAN driver to change the decision is what wedges the board.
+#
+# The decision is on by default and turned off with:
+#   uci set nss-wifi.general.offload='0'; uci commit nss-wifi
+# Anything else loads the driver exactly as an image without this package
+# would. A failure once the radios have probed for the offload leaves Wi-Fi
+# down until the next boot. Wired networking never depends on either path.
+# A bring-up the board did not survive is not tried again until
+# /etc/nss-wifi.pending is removed; the setting itself is left alone.
+
+START=19
+USE_PROCD=1
+
+# Present from the start of a bring-up until the board has survived it.
+PENDING=/etc/nss-wifi.pending
+
+wifi_load_host() {
+	modprobe ath11k 2>/dev/null
+	modprobe ath11k_ahb 2>/dev/null
+	modprobe ath11k_pci 2>/dev/null
+}
+
+start_service() {
+	local dev dir fw i param qcn want
+
+	[ "$(uci -q get nss-wifi.general.offload)" = "1" ] || {
+		wifi_load_host
+		return 0
+	}
+
+	[ -e "$PENDING" ] && {
+		logger -t nss-wifi "offload skipped: $(cat "$PENDING"); rm $PENDING to try again"
+		wifi_load_host
+		return 0
+	}
+
+	# ath11k offloads the IPQ8074 and IPQ6018 radios and a QCN9074 beside
+	# them; elsewhere none would ever hand its rings over and the wait
+	# below would only delay the boot.
+	grep -qsE 'qcom,ipq(8074|6018)-wifi' /proc/device-tree/soc*/wifi@*/compatible || {
+		wifi_load_host
+		return 0
+	}
+
+	# Marked before anything is tried, and cleared only once the board
+	# has survived the bring-up. A bring-up that hangs the board therefore
+	# costs one boot, not every boot after it.
+	echo "the last bring-up did not complete" > "$PENDING"
+	sync
+
+	modprobe nss-wifi-drv 2>/dev/null
+
+	# The radios are handed over below, so a board whose device tree
+	# describes no NSS core keeps them on the host path instead.
+	dir=$(ls -d /sys/kernel/debug/*.nss 2>/dev/null | head -1)
+	[ -n "$dir" ] || {
+		logger -t nss-wifi "no NSS core to boot, staying on the host path"
+		rm -f "$PENDING"
+		wifi_load_host
+		return 0
+	}
+
+	# Parameters are read when the plane is brought up below, and modprobe
+	# on this image carries none, so anything to be varied between boots is
+	# written here:
+	#   uci add_list nss-wifi.general.param='payloads=32768'
+	fw=$(uci -q get nss-wifi.general.firmware) &&
+		printf %s "$fw" > /sys/module/nss_wifi_drv/parameters/firmware
+	for param in $(uci -q get nss-wifi.general.param); do
+		echo "${param#*=}" > "/sys/module/nss_wifi_drv/parameters/${param%%=*}" 2>/dev/null &&
+			logger -t nss-wifi "$param"
+	done
+
+	# A radio reads these when it probes, and the bus module is what
+	# probes one, so they are written between the two modprobes.
+	modprobe ath11k 2>/dev/null
+	if ! echo 1 > /sys/module/ath11k/parameters/nss_offload 2>/dev/null; then
+		logger -t nss-wifi "ath11k has no offload parameter, staying on the host path"
+		rm -f "$PENDING"
+		wifi_load_host
+		return 0
+	fi
+	echo 2 > /sys/module/ath11k/parameters/frame_mode 2>/dev/null
+	modprobe ath11k_ahb 2>/dev/null
+	modprobe ath11k_pci 2>/dev/null
+
+	# A radio describes its rings from its own probe, which loading the
+	# bus module only begins, so the bring-up waits for that rather than
+	# racing it. Reading wifili_start is what sends the sequence.
+	#
+	# A radio logs its rings as it hands them over, and that line is the
+	# only thing that says the description is complete: the phy appears
+	# early in the probe, well before it. Releasing the core while a radio
+	# is still probing hangs the board. A QCN9074 is one radio, and boots
+	# its own firmware first, so it finishes well after the SoC radios.
+	qcn=0
+	for dev in /sys/bus/pci/devices/*; do
+		[ "$(cat "$dev/vendor"):$(cat "$dev/device")" = 0x17cb:0x1104 ] &&
+			qcn=$((qcn + 1))
+	done
+	i=0
+	while [ $i -lt 60 ]; do
+		want=$(ls -d /sys/bus/platform/drivers/ath11k/*/ieee80211/phy* 2>/dev/null | wc -l)
+		[ "$want" -gt 0 ] &&
+			[ "$(dmesg | grep -c 'nss-wifi-drv: radio')" -ge $((want + qcn)) ] && break
+		sleep 1
+		i=$((i + 1))
+	done
+	sleep 3
+
+	echo 1 > "$dir/boot" || {
+		echo "the NSS core would not boot" > "$PENDING"
+		logger -t nss-wifi "the NSS core would not boot"
+		return 0
+	}
+	cat "$dir/wifili_start" | logger -t nss-wifi
+
+	[ "$(cat "$dir/boot")" = "1" ] || {
+		echo "the NSS core did not stay up" > "$PENDING"
+		logger -t nss-wifi "the NSS core did not stay up"
+		return 0
+	}
+
+	# Cleared only once the board has been up long enough to have survived
+	# the bring-up, not when the core reports itself started: a hang
+	# arrives after that, and clearing before it turns one bad boot into
+	# every boot.
+	(sleep 120
+	 rm -f "$PENDING"
+	 sync
+	 logger -t nss-wifi "bring-up survived, offload stays on for the next boot") &
+}
+
+stop_service() {
+	echo "The Wi-Fi data path is chosen at probe; reboot to change it."
+}
diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.uci-defaults b/package/kernel/nss-wifi-drv/files/nss-wifi.uci-defaults
new file mode 100644
index 0000000000..f5771f1f67
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.uci-defaults
@@ -0,0 +1,13 @@
+#!/bin/sh
+# Put the modem's raw-IP devices in fw4's flow table (see the include).
+
+uci -q get firewall.nss_wifi_flowtable >/dev/null && exit 0
+
+uci -q batch <<-EOT
+	set firewall.nss_wifi_flowtable=include
+	set firewall.nss_wifi_flowtable.type='script'
+	set firewall.nss_wifi_flowtable.path='/usr/share/nss-wifi/flowtable.sh'
+	commit firewall
+EOT
+
+exit 0
