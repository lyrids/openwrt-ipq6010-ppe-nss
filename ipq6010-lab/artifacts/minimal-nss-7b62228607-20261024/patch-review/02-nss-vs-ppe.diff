diff --git a/package/kernel/nss-wifi-drv/src/nss_mc.c b/package/kernel/nss-wifi-drv/src/nss_mc.c
new file mode 100644
index 0000000000..3b2258c3cd
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_mc.c
@@ -0,0 +1,1141 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Routed multicast offload from the kernel's multicast routing cache.
+ *
+ * The MFC gives source, group, ingress and egress interfaces; the firmware
+ * rule also needs the UDP ports, so they are learnt from the first packets of
+ * a known (S,G) that reach the host. A bridge egress is expanded into its
+ * firmware-owned member ports: the MDB ports while snooping has a querier,
+ * otherwise every forwarding port with multicast flooding on, which is what
+ * br_dev_xmit() itself does. An entry with any egress the firmware does not
+ * own stays in software.
+ *
+ * The MFC notifier runs in atomic context, so every event is queued and
+ * handled in one work item under rtnl, which also stabilises the MFC entry
+ * and the bridge state it reads.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/if_bridge.h>
+#include <linux/if_vlan.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/mroute.h>
+#include <linux/mroute6.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_ipv4.h>
+#include <linux/netfilter_ipv6.h>
+#include <linux/rtnetlink.h>
+#include <linux/udp.h>
+#include <net/fib_notifier.h>
+#include <net/if_inet6.h>
+#include <net/ip.h>
+#include <net/ip6_fib.h>
+#include <net/switchdev.h>
+
+#include "nss_drv.h"
+
+#define NSS_MC_VLAN_NONE	0xfff
+/* ponytail: port pairs per (S,G); one stream rarely uses more than one */
+#define NSS_MC_PORTS		4
+
+enum nss_mc_why {
+	NSS_MC_OK,
+	NSS_MC_NO_CORE,
+	NSS_MC_IIF,
+	NSS_MC_OIF,
+	NSS_MC_BRIDGE_VLAN,
+	NSS_MC_TOO_MANY,
+	NSS_MC_NO_EGRESS,
+	NSS_MC_PPPOE,
+	NSS_MC_WHY_MAX,
+};
+
+static const char *const nss_mc_why_name[] = {
+	"ok", "no-core", "iif", "oif", "bridge-vlan", "too-many", "no-egress",
+	"pppoe",
+};
+
+struct nss_mc_if {
+	int ifnum;
+	u32 vlan;
+	u32 mtu;
+	u8 mac[ETH_ALEN];
+};
+
+struct nss_mc_in {
+	int src;
+	u32 vlan;
+	u32 mtu;
+	u16 sid;
+	u8 server[ETH_ALEN];
+	u8 local[ETH_ALEN];
+	bool pppoe;
+};
+
+/* What the installed rules of one (S,G) carry. */
+struct nss_mc_set {
+	struct nss_mc_in in;
+	u8 mac[ETH_ALEN];
+	u16 n;
+	struct nss_mc_if m[NSS_MC_IF_MAX];
+};
+
+struct nss_mc_port {
+	__be16 sport;
+	__be16 dport;
+	bool installed;
+};
+
+struct nss_mc_route {
+	struct list_head node;
+	struct rcu_head rcu;
+	struct mr_mfc *mfc;	/* held */
+	union nf_inet_addr src;
+	union nf_inet_addr grp;
+	u8 family;
+	int iif;		/* ingress ifindex, for the hook */
+	enum nss_mc_why why;
+	int pppoe;		/* held session interface, or -1 */
+	unsigned long kicked;
+	u8 nports;
+	struct nss_mc_port port[NSS_MC_PORTS];
+	struct nss_mc_set cur;
+};
+
+struct nss_mc_event {
+	struct list_head node;
+	unsigned long type;
+	u8 family;
+	struct mr_mfc *mfc;	/* held */
+	int ifindex;
+	u16 vif;
+};
+
+/* A bridge port's MDB entry, as switchdev reports it: by MAC. */
+struct nss_mc_mdb {
+	struct list_head node;
+	int ifindex;
+	u8 mac[ETH_ALEN];
+	u32 ref;
+};
+
+#define NSS_MC_FLUSH	(~0UL)
+
+/* The per-interface join and leave flags are shared by both families. */
+static_assert(NSS_IPV4_MC_RULE_CREATE_IF_FLAG_JOIN ==
+	      NSS_IPV6_MC_RULE_CREATE_IF_FLAG_JOIN);
+static_assert(NSS_IPV4_MC_RULE_CREATE_IF_FLAG_LEAVE ==
+	      NSS_IPV6_MC_RULE_CREATE_IF_FLAG_LEAVE);
+
+static DEFINE_MUTEX(nss_mc_lock);
+static DEFINE_SPINLOCK(nss_mc_ev_lock);
+static DEFINE_SPINLOCK(nss_mc_port_lock);
+static LIST_HEAD(nss_mc_events);
+static LIST_HEAD(nss_mc_routes);
+static LIST_HEAD(nss_mc_mdbs);
+static struct nss_core *nss_mc_core;
+static int nss_mc_vif[2][MAXVIFS];
+static unsigned int nss_mc_nroutes;
+static bool nss_mc_mdb_lost;	/* an entry went unrecorded: flood instead */
+static u32 nss_mc_created, nss_mc_updated, nss_mc_destroyed, nss_mc_refused;
+static u32 nss_mc_last_err;
+
+static void nss_mc_work_fn(struct work_struct *work);
+static DECLARE_WORK(nss_mc_work, nss_mc_work_fn);
+
+static int nss_mc_fi(u8 family)
+{
+	return family == RTNL_FAMILY_IP6MR;
+}
+
+/* The firmware interface behind @dev, at most one VLAN tag above it,
+ * counting a stacked port's conduit tag.
+ */
+static int nss_mc_port_of(struct nss_core *core, const struct net_device *dev,
+			  u32 *vlan, u32 *mtu)
+{
+	u16 vid = 0, cvid;
+	int ifnum;
+
+	if (is_vlan_dev(dev)) {
+		*vlan = (u32)ntohs(vlan_dev_vlan_proto(dev)) << 16 |
+			vlan_dev_vlan_id(dev);
+		vid = vlan_dev_vlan_id(dev);
+		dev = vlan_dev_real_dev(dev);
+	}
+
+	ifnum = nss_flow_port(core, dev->ifindex, vid, mtu, &cvid);
+	if (ifnum >= 0 && cvid) {
+		if (vid && *vlan >> 16 != ETH_P_8021Q)
+			return -EOPNOTSUPP;
+		*vlan = (u32)ETH_P_8021Q << 16 | cvid;
+	}
+
+	return ifnum;
+}
+
+static enum nss_mc_why nss_mc_ingress(struct nss_core *core,
+				      const struct net_device *dev,
+				      struct nss_mc_in *in)
+{
+	in->vlan = NSS_MC_VLAN_NONE;
+
+	/* The session is on the port below; the stack says which. */
+	if (dev->type == ARPHRD_PPP) {
+		struct net_device_path_ctx ctx = { .dev = dev };
+		struct net_device_path_stack st;
+
+		if (dev_fill_forward_path(&ctx, &st) < 0 || st.num_paths < 2 ||
+		    st.path[0].type != DEV_PATH_PPPOE)
+			return NSS_MC_PPPOE;
+
+		in->pppoe = true;
+		in->sid = st.path[0].encap.id;
+		ether_addr_copy(in->server, st.path[0].encap.h_dest);
+		dev = st.path[1].dev;
+		ether_addr_copy(in->local, dev->dev_addr);
+	}
+
+	in->src = nss_mc_port_of(core, dev, &in->vlan, &in->mtu);
+
+	return in->src < 0 ? NSS_MC_IIF : NSS_MC_OK;
+}
+
+static enum nss_mc_why nss_mc_member(struct nss_core *core,
+				     struct nss_mc_set *w,
+				     const struct net_device *dev,
+				     const struct net_device *l3)
+{
+	u32 vlan = NSS_MC_VLAN_NONE, mtu;
+	struct nss_mc_if *m;
+	int i, ifnum;
+
+	ifnum = nss_mc_port_of(core, dev, &vlan, &mtu);
+	if (ifnum < 0)
+		return NSS_MC_OIF;
+	/* Ports of one stacked switch in one bridge share a conduit tag,
+	 * and the switch replicates a single copy, as for the bridge.
+	 */
+	for (i = 0; i < w->n; i++)
+		if (w->m[i].ifnum == ifnum && w->m[i].vlan == vlan)
+			return NSS_MC_OK;
+	if (w->n == NSS_MC_IF_MAX)
+		return NSS_MC_TOO_MANY;
+
+	/* Routed out of @l3: its address and MTU, as the stack would. */
+	m = &w->m[w->n++];
+	m->ifnum = ifnum;
+	m->vlan = vlan;
+	m->mtu = l3->mtu;
+	ether_addr_copy(m->mac, l3->dev_addr);
+
+	return NSS_MC_OK;
+}
+
+static bool nss_mc_mdb_has(int ifindex, const u8 *mac)
+{
+	struct nss_mc_mdb *e;
+
+	list_for_each_entry(e, &nss_mc_mdbs, node)
+		if (e->ifindex == ifindex && ether_addr_equal(e->mac, mac))
+			return true;
+
+	return false;
+}
+
+static bool nss_mc_snooping(struct net_device *br, int proto)
+{
+	struct net_device *port;
+	struct list_head *iter;
+
+	if (nss_mc_mdb_lost || !br_multicast_enabled(br))
+		return false;
+
+	/* The query takes any port of the bridge. */
+	netdev_for_each_lower_dev(br, port, iter)
+		return br_multicast_has_querier_anywhere(port, proto);
+
+	return false;
+}
+
+/* The ports br_dev_xmit() would deliver a routed packet for @w's group to.
+ * ponytail: mrouter ports are not added; add them if a LAN router appears.
+ */
+static enum nss_mc_why nss_mc_bridge(struct nss_core *core,
+				     struct nss_mc_route *r,
+				     struct net_device *br,
+				     struct nss_mc_set *w)
+{
+	int proto = r->family == RTNL_FAMILY_IPMR ? ETH_P_IP : ETH_P_IPV6;
+	bool snoop = nss_mc_snooping(br, proto);
+	struct net_device *port;
+	struct list_head *iter;
+	enum nss_mc_why why;
+
+	if (br_vlan_enabled(br))
+		return NSS_MC_BRIDGE_VLAN;
+
+	netdev_for_each_lower_dev(br, port, iter) {
+		if (br_port_get_stp_state(port) != BR_STATE_FORWARDING)
+			continue;
+		if (snoop ? !nss_mc_mdb_has(port->ifindex, w->mac) :
+			    !br_port_flag_is_set(port, BR_MCAST_FLOOD))
+			continue;
+		why = nss_mc_member(core, w, port, br);
+		if (why)
+			return why;
+	}
+
+	return NSS_MC_OK;
+}
+
+static enum nss_mc_why nss_mc_want(struct nss_core *core,
+				   struct nss_mc_route *r,
+				   struct nss_mc_set *w)
+{
+	const struct mr_mfc *c = r->mfc;
+	int fi = nss_mc_fi(r->family);
+	struct net_device *dev;
+	enum nss_mc_why why;
+	int v;
+
+	if (c->mfc_parent >= MAXVIFS)
+		return NSS_MC_IIF;
+	dev = __dev_get_by_index(&init_net, nss_mc_vif[fi][c->mfc_parent]);
+	if (!dev)
+		return NSS_MC_IIF;
+	WRITE_ONCE(r->iif, dev->ifindex);
+
+	if (!core || !core->running)
+		return NSS_MC_NO_CORE;
+
+	why = nss_mc_ingress(core, dev, &w->in);
+	if (why)
+		return why;
+
+	if (r->family == RTNL_FAMILY_IPMR)
+		ip_eth_mc_map(r->grp.ip, w->mac);
+	else
+		ipv6_eth_mc_map(&r->grp.in6, w->mac);
+
+	for (v = c->mfc_un.res.minvif; v < c->mfc_un.res.maxvif; v++) {
+		if (v == c->mfc_parent || c->mfc_un.res.ttls[v] == 255)
+			continue;
+		dev = __dev_get_by_index(&init_net, nss_mc_vif[fi][v]);
+		if (!dev)
+			return NSS_MC_OIF;
+		why = netif_is_bridge_master(dev) ?
+		      nss_mc_bridge(core, r, dev, w) :
+		      nss_mc_member(core, w, dev, dev);
+		if (why)
+			return why;
+	}
+
+	return w->n ? NSS_MC_OK : NSS_MC_NO_EGRESS;
+}
+
+static int nss_mc_send4(struct nss_core *core, struct nss_mc_route *r,
+			struct nss_mc_port *p, const struct nss_mc_set *w,
+			const struct nss_mc_if *const *m, const u16 *flag,
+			int n, bool update)
+{
+	struct nss_ipv4_mc_rule_create_msg *c;
+	struct nss_ipv4_msg *msg __free(kfree) =
+		kzalloc(sizeof(*msg), GFP_KERNEL);
+	int i, ret;
+
+	if (!msg)
+		return -ENOMEM;
+	c = &msg->msg.mc_rule_create;
+
+	c->tuple.protocol = IPPROTO_UDP;
+	c->tuple.flow_ip = ntohl(r->src.ip);
+	c->tuple.flow_ident = ntohs(p->sport);
+	c->tuple.return_ip = ntohl(r->grp.ip);
+	c->tuple.return_ident = ntohs(p->dport);
+
+	if (update)
+		c->rule_flags = NSS_IPV4_MC_RULE_CREATE_FLAG_MC_UPDATE;
+	c->src_interface_num = w->in.src;
+	c->ingress_vlan_tag[0] = w->in.vlan;
+	c->ingress_vlan_tag[1] = NSS_MC_VLAN_NONE;
+	if (w->in.vlan != NSS_MC_VLAN_NONE)
+		c->valid_flags |= NSS_IPV4_MC_RULE_CREATE_FLAG_INGRESS_VLAN_VALID;
+	if (w->in.pppoe)
+		c->valid_flags |= NSS_IPV4_MC_RULE_CREATE_FLAG_INGRESS_PPPOE;
+	memcpy(c->dest_mac, w->mac, ETH_ALEN);
+
+	c->if_count = n;
+	for (i = 0; i < n; i++) {
+		struct nss_ipv4_mc_if_rule *ir = &c->if_rule[i];
+
+		ir->rule_flags = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_ROUTED_FLOW |
+				 flag[i];
+		ir->xlate_src_ip = c->tuple.flow_ip;
+		ir->xlate_src_ident = c->tuple.flow_ident;
+		ir->egress_vlan_tag[0] = m[i]->vlan;
+		ir->egress_vlan_tag[1] = NSS_MC_VLAN_NONE;
+		if (m[i]->vlan != NSS_MC_VLAN_NONE)
+			ir->valid_flags |= NSS_IPV4_MC_RULE_CREATE_IF_FLAG_VLAN_VALID;
+		ir->if_num = m[i]->ifnum;
+		ir->if_mtu = m[i]->mtu;
+		memcpy(ir->if_mac, m[i]->mac, ETH_ALEN);
+	}
+
+	msg->cm.interface = NSS_INTERFACE_IPV4;
+	msg->cm.type = NSS_IPV4_TX_CREATE_MC_RULE_MSG;
+	ret = nss_msg_send(core, msg, offsetof(struct nss_ipv4_msg, msg) +
+				      sizeof(*c));
+	if (msg->cm.error) {
+		nss_mc_last_err = msg->cm.error;
+		if (!ret)
+			ret = -EIO;
+	}
+
+	return ret;
+}
+
+static int nss_mc_send6(struct nss_core *core, struct nss_mc_route *r,
+			struct nss_mc_port *p, const struct nss_mc_set *w,
+			const struct nss_mc_if *const *m, const u16 *flag,
+			int n, bool update)
+{
+	struct nss_ipv6_mc_rule_create_msg *c;
+	struct nss_ipv6_msg *msg __free(kfree) =
+		kzalloc(sizeof(*msg), GFP_KERNEL);
+	int i, ret;
+
+	if (!msg)
+		return -ENOMEM;
+	c = &msg->msg.mc_rule_create;
+
+	c->tuple.protocol = IPPROTO_UDP;
+	for (i = 0; i < 4; i++) {
+		c->tuple.flow_ip[i] = ntohl(r->src.ip6[i]);
+		c->tuple.return_ip[i] = ntohl(r->grp.ip6[i]);
+	}
+	c->tuple.flow_ident = ntohs(p->sport);
+	c->tuple.return_ident = ntohs(p->dport);
+
+	if (update)
+		c->rule_flags = NSS_IPV6_MC_RULE_CREATE_FLAG_MC_UPDATE;
+	c->src_interface_num = w->in.src;
+	c->ingress_vlan_tag[0] = w->in.vlan;
+	c->ingress_vlan_tag[1] = NSS_MC_VLAN_NONE;
+	if (w->in.vlan != NSS_MC_VLAN_NONE)
+		c->valid_flags |= NSS_IPV6_MC_RULE_CREATE_FLAG_INGRESS_VLAN_VALID;
+	if (w->in.pppoe)
+		c->valid_flags |= NSS_IPV6_MC_RULE_CREATE_FLAG_INGRESS_PPPOE;
+	memcpy(c->dest_mac, w->mac, ETH_ALEN);
+
+	c->if_count = n;
+	for (i = 0; i < n; i++) {
+		struct nss_ipv6_mc_if_rule *ir = &c->if_rule[i];
+
+		ir->rule_flags = NSS_IPV6_MC_RULE_CREATE_IF_FLAG_ROUTED_FLOW |
+				 flag[i];
+		ir->egress_vlan_tag[0] = m[i]->vlan;
+		ir->egress_vlan_tag[1] = NSS_MC_VLAN_NONE;
+		if (m[i]->vlan != NSS_MC_VLAN_NONE)
+			ir->valid_flags |= NSS_IPV6_MC_RULE_CREATE_IF_FLAG_VLAN_VALID;
+		ir->if_num = m[i]->ifnum;
+		ir->if_mtu = m[i]->mtu;
+		memcpy(ir->if_mac, m[i]->mac, ETH_ALEN);
+	}
+
+	msg->cm.interface = NSS_INTERFACE_IPV6;
+	msg->cm.type = NSS_IPV6_TX_CREATE_MC_RULE_MSG;
+	ret = nss_msg_send(core, msg, offsetof(struct nss_ipv6_msg, msg) +
+				      sizeof(*c));
+	if (msg->cm.error) {
+		nss_mc_last_err = msg->cm.error;
+		if (!ret)
+			ret = -EIO;
+	}
+
+	return ret;
+}
+
+static int nss_mc_send(struct nss_core *core, struct nss_mc_route *r,
+		       struct nss_mc_port *p, const struct nss_mc_set *w,
+		       const struct nss_mc_if *const *m, const u16 *flag,
+		       int n, bool update)
+{
+	int ret;
+
+	ret = r->family == RTNL_FAMILY_IPMR ?
+	      nss_mc_send4(core, r, p, w, m, flag, n, update) :
+	      nss_mc_send6(core, r, p, w, m, flag, n, update);
+	if (ret)
+		nss_mc_refused++;
+
+	return ret;
+}
+
+static int nss_mc_create(struct nss_core *core, struct nss_mc_route *r,
+			 struct nss_mc_port *p, const struct nss_mc_set *w)
+{
+	const struct nss_mc_if *m[NSS_MC_IF_MAX];
+	u16 flag[NSS_MC_IF_MAX];
+	int i, ret;
+
+	for (i = 0; i < w->n; i++) {
+		m[i] = &w->m[i];
+		flag[i] = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_JOIN;
+	}
+
+	ret = nss_mc_send(core, r, p, w, m, flag, w->n, false);
+	if (!ret)
+		nss_mc_created++;
+
+	return ret;
+}
+
+static void nss_mc_destroy(struct nss_core *core, struct nss_mc_route *r,
+			   struct nss_mc_port *p)
+{
+	int i;
+
+	if (r->family == RTNL_FAMILY_IPMR) {
+		struct nss_ipv4_msg *m __free(kfree) =
+			kzalloc(sizeof(*m), GFP_KERNEL);
+
+		if (!m)
+			return;
+		m->msg.rule_destroy.tuple.protocol = IPPROTO_UDP;
+		m->msg.rule_destroy.tuple.flow_ip = ntohl(r->src.ip);
+		m->msg.rule_destroy.tuple.flow_ident = ntohs(p->sport);
+		m->msg.rule_destroy.tuple.return_ip = ntohl(r->grp.ip);
+		m->msg.rule_destroy.tuple.return_ident = ntohs(p->dport);
+		m->cm.interface = NSS_INTERFACE_IPV4;
+		m->cm.type = NSS_IPV4_TX_DESTROY_RULE_MSG;
+		nss_msg_send(core, m, offsetof(struct nss_ipv4_msg, msg) +
+				      sizeof(m->msg.rule_destroy));
+	} else {
+		struct nss_ipv6_msg *m __free(kfree) =
+			kzalloc(sizeof(*m), GFP_KERNEL);
+
+		if (!m)
+			return;
+		m->msg.rule_destroy.tuple.protocol = IPPROTO_UDP;
+		for (i = 0; i < 4; i++) {
+			m->msg.rule_destroy.tuple.flow_ip[i] =
+				ntohl(r->src.ip6[i]);
+			m->msg.rule_destroy.tuple.return_ip[i] =
+				ntohl(r->grp.ip6[i]);
+		}
+		m->msg.rule_destroy.tuple.flow_ident = ntohs(p->sport);
+		m->msg.rule_destroy.tuple.return_ident = ntohs(p->dport);
+		m->cm.interface = NSS_INTERFACE_IPV6;
+		m->cm.type = NSS_IPV6_TX_DESTROY_RULE_MSG;
+		nss_msg_send(core, m, offsetof(struct nss_ipv6_msg, msg) +
+				      sizeof(m->msg.rule_destroy));
+	}
+
+	nss_mc_destroyed++;
+}
+
+static bool nss_mc_in_set(const struct nss_mc_set *s, const struct nss_mc_if *m)
+{
+	int i;
+
+	for (i = 0; i < s->n; i++)
+		if (!memcmp(&s->m[i], m, sizeof(*m)))
+			return true;
+
+	return false;
+}
+
+/* Move an installed rule from r->cur to @w: leaves first, then joins. A
+ * failed update leaves the rule in an unknown state.
+ */
+static int nss_mc_update(struct nss_core *core, struct nss_mc_route *r,
+			 struct nss_mc_port *p, const struct nss_mc_set *w)
+{
+	const struct nss_mc_if *m[NSS_MC_IF_MAX];
+	u16 flag[NSS_MC_IF_MAX];
+	int i, n = 0, ret;
+
+	for (i = 0; i < r->cur.n; i++) {
+		if (nss_mc_in_set(w, &r->cur.m[i]))
+			continue;
+		if (n == NSS_MC_IF_MAX)
+			return -E2BIG;
+		m[n] = &r->cur.m[i];
+		flag[n++] = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_LEAVE;
+	}
+	for (i = 0; i < w->n; i++) {
+		if (nss_mc_in_set(&r->cur, &w->m[i]))
+			continue;
+		if (n == NSS_MC_IF_MAX)
+			return -E2BIG;
+		m[n] = &w->m[i];
+		flag[n++] = NSS_IPV4_MC_RULE_CREATE_IF_FLAG_JOIN;
+	}
+	if (!n)
+		return 0;
+
+	ret = nss_mc_send(core, r, p, w, m, flag, n, true);
+	if (!ret)
+		nss_mc_updated++;
+
+	return ret;
+}
+
+static void nss_mc_mark(struct nss_mc_route *r, bool on)
+{
+	if (on)
+		r->mfc->mfc_flags |= MFC_OFFLOAD;
+	else
+		r->mfc->mfc_flags &= ~MFC_OFFLOAD;
+}
+
+/* Take every rule of @r out of the firmware, and the session with them. */
+static void nss_mc_withdraw(struct nss_core *core, struct nss_mc_route *r)
+{
+	/* Pairs with the release in nss_mc_learn(). */
+	int i, n = smp_load_acquire(&r->nports);
+
+	for (i = 0; i < n; i++) {
+		if (r->port[i].installed && core)
+			nss_mc_destroy(core, r, &r->port[i]);
+		WRITE_ONCE(r->port[i].installed, false);
+	}
+	if (r->pppoe >= 0 && core)
+		nss_flow_pppoe_drop(core, r->pppoe);
+	r->pppoe = -1;
+	memset(&r->cur, 0, sizeof(r->cur));
+	nss_mc_mark(r, false);
+}
+
+static void nss_mc_sync(struct nss_core *core, struct nss_mc_route *r)
+{
+	struct nss_mc_set *w __free(kfree) = kzalloc(sizeof(*w), GFP_KERNEL);
+	/* Pairs with the release in nss_mc_learn(). */
+	int i, n = smp_load_acquire(&r->nports);
+	bool any = false;
+
+	if (!w)
+		return;
+
+	r->why = nss_mc_want(core, r, w);
+	if (r->why || memcmp(&w->in, &r->cur.in, sizeof(w->in)) ||
+	    !ether_addr_equal(w->mac, r->cur.mac))
+		nss_mc_withdraw(core, r);
+	if (r->why || !n)
+		return;
+
+	if (w->in.pppoe && r->pppoe < 0) {
+		r->pppoe = nss_flow_pppoe_hold(core, w->in.sid, w->in.server,
+					       w->in.local, w->in.src,
+					       w->in.mtu,
+					       w->in.vlan == NSS_MC_VLAN_NONE ?
+					       0 : w->in.vlan);
+		if (r->pppoe < 0) {
+			r->pppoe = -1;
+			r->why = NSS_MC_PPPOE;
+			return;
+		}
+	}
+
+	for (i = 0; i < n; i++) {
+		struct nss_mc_port *p = &r->port[i];
+
+		if (p->installed && nss_mc_update(core, r, p, w)) {
+			nss_mc_destroy(core, r, p);
+			WRITE_ONCE(p->installed, false);
+		}
+		if (!p->installed)
+			WRITE_ONCE(p->installed, !nss_mc_create(core, r, p, w));
+		any |= p->installed;
+	}
+
+	r->cur = *w;
+	nss_mc_mark(r, any);
+}
+
+static struct nss_mc_route *nss_mc_find(const struct mr_mfc *mfc)
+{
+	struct nss_mc_route *r;
+
+	list_for_each_entry(r, &nss_mc_routes, node)
+		if (r->mfc == mfc)
+			return r;
+
+	return NULL;
+}
+
+static void nss_mc_route_add(struct nss_mc_event *ev)
+{
+	struct nss_mc_route *r;
+
+	r = kzalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return;
+
+	if (ev->family == RTNL_FAMILY_IPMR) {
+		struct mfc_cache *c = container_of(ev->mfc, struct mfc_cache, _c);
+
+		r->src.ip = c->mfc_origin;
+		r->grp.ip = c->mfc_mcastgrp;
+	} else {
+		struct mfc6_cache *c = container_of(ev->mfc, struct mfc6_cache,
+						    _c);
+
+		r->src.in6 = c->mf6c_origin;
+		r->grp.in6 = c->mf6c_mcastgrp;
+	}
+
+	/* ponytail: (*,G) is not offloaded; the rule needs a source */
+	if (nf_inet_addr_cmp(&r->src, &(union nf_inet_addr){})) {
+		kfree(r);
+		return;
+	}
+
+	r->family = ev->family;
+	r->mfc = ev->mfc;
+	r->pppoe = -1;
+	ev->mfc = NULL;
+	list_add_tail_rcu(&r->node, &nss_mc_routes);
+	WRITE_ONCE(nss_mc_nroutes, nss_mc_nroutes + 1);
+}
+
+static void nss_mc_route_del(struct nss_core *core, struct nss_mc_route *r)
+{
+	nss_mc_withdraw(core, r);
+	list_del_rcu(&r->node);
+	WRITE_ONCE(nss_mc_nroutes, nss_mc_nroutes - 1);
+	mr_cache_put(r->mfc);
+	kfree_rcu(r, rcu);
+}
+
+static void nss_mc_event_run(struct nss_core *core, struct nss_mc_event *ev)
+{
+	struct nss_mc_route *r, *tmp;
+	int fi = nss_mc_fi(ev->family);
+
+	switch (ev->type) {
+	case NSS_MC_FLUSH:
+		list_for_each_entry_safe(r, tmp, &nss_mc_routes, node)
+			nss_mc_route_del(core, r);
+		memset(nss_mc_vif, 0, sizeof(nss_mc_vif));
+		break;
+	case FIB_EVENT_VIF_ADD:
+		nss_mc_vif[fi][ev->vif] = ev->ifindex;
+		break;
+	case FIB_EVENT_VIF_DEL:
+		nss_mc_vif[fi][ev->vif] = 0;
+		break;
+	case FIB_EVENT_ENTRY_ADD:
+	case FIB_EVENT_ENTRY_REPLACE:
+		if (!nss_mc_find(ev->mfc))
+			nss_mc_route_add(ev);
+		break;
+	case FIB_EVENT_ENTRY_DEL:
+		r = nss_mc_find(ev->mfc);
+		if (r)
+			nss_mc_route_del(core, r);
+		break;
+	}
+}
+
+static void nss_mc_work_fn(struct work_struct *work)
+{
+	struct nss_mc_event *ev, *tmp;
+	struct nss_mc_route *r;
+	struct nss_core *core;
+	LIST_HEAD(events);
+
+	spin_lock_bh(&nss_mc_ev_lock);
+	list_splice_init(&nss_mc_events, &events);
+	spin_unlock_bh(&nss_mc_ev_lock);
+
+	rtnl_lock();
+	mutex_lock(&nss_mc_lock);
+
+	core = nss_mc_core;
+	list_for_each_entry_safe(ev, tmp, &events, node) {
+		nss_mc_event_run(core, ev);
+		if (ev->mfc)
+			mr_cache_put(ev->mfc);
+		kfree(ev);
+	}
+
+	list_for_each_entry(r, &nss_mc_routes, node)
+		nss_mc_sync(core, r);
+
+	mutex_unlock(&nss_mc_lock);
+	rtnl_unlock();
+}
+
+static void nss_mc_queue(struct nss_mc_event *ev)
+{
+	spin_lock_bh(&nss_mc_ev_lock);
+	list_add_tail(&ev->node, &nss_mc_events);
+	spin_unlock_bh(&nss_mc_ev_lock);
+	schedule_work(&nss_mc_work);
+}
+
+/* Atomic context: queue a copy, holding the MFC entry until it is read. */
+static int nss_mc_fib_event(struct notifier_block *nb, unsigned long type,
+			    void *ptr)
+{
+	struct fib_notifier_info *info = ptr;
+	struct mfc_entry_notifier_info *mi;
+	struct vif_entry_notifier_info *vi;
+	struct nss_mc_event *ev;
+	u32 tb;
+
+	if (info->family != RTNL_FAMILY_IPMR &&
+	    info->family != RTNL_FAMILY_IP6MR)
+		return NOTIFY_DONE;
+	tb = info->family == RTNL_FAMILY_IPMR ? RT_TABLE_DEFAULT :
+						 RT6_TABLE_DFLT;
+
+	switch (type) {
+	case FIB_EVENT_ENTRY_ADD:
+	case FIB_EVENT_ENTRY_REPLACE:
+	case FIB_EVENT_ENTRY_DEL:
+		mi = container_of(info, struct mfc_entry_notifier_info, info);
+		if (mi->tb_id != tb)
+			return NOTIFY_DONE;
+		ev = kzalloc(sizeof(*ev), GFP_ATOMIC);
+		if (!ev)
+			return notifier_from_errno(-ENOMEM);
+		mr_cache_hold(mi->mfc);
+		ev->mfc = mi->mfc;
+		break;
+	case FIB_EVENT_VIF_ADD:
+	case FIB_EVENT_VIF_DEL:
+		vi = container_of(info, struct vif_entry_notifier_info, info);
+		if (vi->tb_id != tb || vi->vif_index >= MAXVIFS)
+			return NOTIFY_DONE;
+		ev = kzalloc(sizeof(*ev), GFP_ATOMIC);
+		if (!ev)
+			return notifier_from_errno(-ENOMEM);
+		ev->vif = vi->vif_index;
+		ev->ifindex = vi->dev ? vi->dev->ifindex : 0;
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	ev->type = type;
+	ev->family = info->family;
+	nss_mc_queue(ev);
+
+	return NOTIFY_DONE;
+}
+
+/* A dump that raced a change is repeated; forget what it delivered. */
+static void nss_mc_fib_flush(struct notifier_block *nb)
+{
+	struct nss_mc_event *ev = kzalloc(sizeof(*ev), GFP_KERNEL);
+
+	if (!ev)
+		return;
+	ev->type = NSS_MC_FLUSH;
+	nss_mc_queue(ev);
+}
+
+static struct notifier_block nss_mc_fib_nb = {
+	.notifier_call = nss_mc_fib_event,
+};
+
+static void nss_mc_mdb_note(int ifindex, const u8 *mac, bool add)
+{
+	struct nss_mc_mdb *e;
+
+	guard(mutex)(&nss_mc_lock);
+
+	list_for_each_entry(e, &nss_mc_mdbs, node) {
+		if (e->ifindex != ifindex || !ether_addr_equal(e->mac, mac))
+			continue;
+		if (add) {
+			e->ref++;
+		} else if (!--e->ref) {
+			list_del(&e->node);
+			kfree(e);
+		}
+		return;
+	}
+	if (!add)
+		return;
+
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		nss_mc_mdb_lost = true;
+		return;
+	}
+	e->ifindex = ifindex;
+	ether_addr_copy(e->mac, mac);
+	e->ref = 1;
+	list_add(&e->node, &nss_mc_mdbs);
+}
+
+/* The bridge reports MDB and port-state changes for every port, offloaded
+ * or not. NOTIFY_DONE: this only watches.
+ */
+static int nss_mc_switchdev_event(struct notifier_block *nb,
+				  unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_port_attr_info *ai = ptr;
+	struct switchdev_notifier_port_obj_info *oi = ptr;
+	struct net_device *dev = switchdev_notifier_info_to_dev(ptr);
+
+	switch (event) {
+	case SWITCHDEV_PORT_OBJ_ADD:
+	case SWITCHDEV_PORT_OBJ_DEL:
+		if (oi->obj->id != SWITCHDEV_OBJ_ID_PORT_MDB)
+			return NOTIFY_DONE;
+		nss_mc_mdb_note(dev->ifindex,
+				SWITCHDEV_OBJ_PORT_MDB(oi->obj)->addr,
+				event == SWITCHDEV_PORT_OBJ_ADD);
+		break;
+	case SWITCHDEV_PORT_ATTR_SET:
+		if (ai->attr->id != SWITCHDEV_ATTR_ID_PORT_STP_STATE &&
+		    ai->attr->id != SWITCHDEV_ATTR_ID_BRIDGE_MC_DISABLED)
+			return NOTIFY_DONE;
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	if (READ_ONCE(nss_mc_nroutes))
+		schedule_work(&nss_mc_work);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nss_mc_switchdev_nb = {
+	.notifier_call = nss_mc_switchdev_event,
+};
+
+/* Record the ports of a known (S,G) arriving on its ingress. A pair already
+ * known but not installed retries at most once a second, which is also how
+ * a route is picked up once the core runs or a port is armed.
+ */
+static void nss_mc_learn(u8 family, const union nf_inet_addr *s,
+			 const union nf_inet_addr *g, int ifindex,
+			 __be16 sport, __be16 dport)
+{
+	struct nss_mc_route *r;
+	bool kick = false;
+	int i;
+
+	list_for_each_entry_rcu(r, &nss_mc_routes, node) {
+		if (r->family != family || READ_ONCE(r->iif) != ifindex ||
+		    !nf_inet_addr_cmp(&r->src, s) ||
+		    !nf_inet_addr_cmp(&r->grp, g))
+			continue;
+
+		spin_lock_bh(&nss_mc_port_lock);
+		for (i = 0; i < r->nports; i++)
+			if (r->port[i].sport == sport &&
+			    r->port[i].dport == dport)
+				break;
+		if (i == r->nports && i < NSS_MC_PORTS) {
+			r->port[i].sport = sport;
+			r->port[i].dport = dport;
+			/* The work reads the pair once it sees the count. */
+			smp_store_release(&r->nports, i + 1);
+			kick = true;
+		} else if (i < r->nports && !READ_ONCE(r->port[i].installed) &&
+			   time_after(jiffies, r->kicked + HZ)) {
+			r->kicked = jiffies;
+			kick = true;
+		}
+		spin_unlock_bh(&nss_mc_port_lock);
+		break;
+	}
+
+	if (kick)
+		schedule_work(&nss_mc_work);
+}
+
+static unsigned int nss_mc_hook(void *priv, struct sk_buff *skb,
+				const struct nf_hook_state *state)
+{
+	union nf_inet_addr s = {}, g = {};
+	struct udphdr _uh;
+	const struct udphdr *uh;
+	unsigned int thoff;
+	u8 family;
+
+	if (!READ_ONCE(nss_mc_nroutes))
+		return NF_ACCEPT;
+
+	if (state->pf == NFPROTO_IPV4) {
+		const struct iphdr *iph = ip_hdr(skb);
+
+		if (!ipv4_is_multicast(iph->daddr) ||
+		    iph->protocol != IPPROTO_UDP || ip_is_fragment(iph))
+			return NF_ACCEPT;
+		s.ip = iph->saddr;
+		g.ip = iph->daddr;
+		thoff = ip_hdrlen(skb);
+		family = RTNL_FAMILY_IPMR;
+	} else {
+		const struct ipv6hdr *ip6h = ipv6_hdr(skb);
+
+		/* ponytail: no extension headers before UDP */
+		if (!ipv6_addr_is_multicast(&ip6h->daddr) ||
+		    ip6h->nexthdr != IPPROTO_UDP)
+			return NF_ACCEPT;
+		s.in6 = ip6h->saddr;
+		g.in6 = ip6h->daddr;
+		thoff = sizeof(*ip6h);
+		family = RTNL_FAMILY_IP6MR;
+	}
+
+	uh = skb_header_pointer(skb, skb_network_offset(skb) + thoff,
+				sizeof(_uh), &_uh);
+	if (uh)
+		nss_mc_learn(family, &s, &g, state->in->ifindex, uh->source,
+			     uh->dest);
+
+	return NF_ACCEPT;
+}
+
+static struct nf_hook_ops nss_mc_hook_ops[] = {
+	{
+		.hook		= nss_mc_hook,
+		.pf		= NFPROTO_IPV4,
+		.hooknum	= NF_INET_PRE_ROUTING,
+		.priority	= NF_IP_PRI_CONNTRACK + 1,
+	},
+	{
+		.hook		= nss_mc_hook,
+		.pf		= NFPROTO_IPV6,
+		.hooknum	= NF_INET_PRE_ROUTING,
+		.priority	= NF_IP6_PRI_CONNTRACK + 1,
+	},
+};
+
+/* Without routes the hook returns at once, so only IPv6 itself gates it. */
+#define NSS_MC_NHOOKS	(IS_ENABLED(CONFIG_IPV6) ? 2 : 1)
+
+void nss_mc_bind(struct nss_core *core)
+{
+	guard(mutex)(&nss_mc_lock);
+	nss_mc_core = core;
+}
+
+/* A halted core holds no rules and no sessions; nothing is sent. */
+void nss_mc_flush(void)
+{
+	struct nss_mc_route *r;
+
+	guard(mutex)(&nss_mc_lock);
+
+	list_for_each_entry(r, &nss_mc_routes, node) {
+		nss_mc_withdraw(NULL, r);
+		r->why = NSS_MC_NO_CORE;
+	}
+}
+
+void nss_mc_print(struct seq_file *s)
+{
+	struct nss_mc_route *r;
+	struct nss_mc_mdb *e;
+	int i;
+
+	guard(mutex)(&nss_mc_lock);
+
+	seq_printf(s, "routes %u created %u updated %u destroyed %u refused %u last-error %u mdb-lost %d\n",
+		   nss_mc_nroutes, nss_mc_created, nss_mc_updated,
+		   nss_mc_destroyed, nss_mc_refused, nss_mc_last_err,
+		   nss_mc_mdb_lost);
+
+	list_for_each_entry(e, &nss_mc_mdbs, node)
+		seq_printf(s, "mdb ifindex %d %pM ref %u\n", e->ifindex, e->mac,
+			   e->ref);
+
+	list_for_each_entry(r, &nss_mc_routes, node) {
+		if (r->family == RTNL_FAMILY_IPMR)
+			seq_printf(s, "route %pI4 -> %pI4", &r->src.ip,
+				   &r->grp.ip);
+		else
+			seq_printf(s, "route %pI6c -> %pI6c", &r->src.in6,
+				   &r->grp.in6);
+		seq_printf(s, " iif %d %s src %d vlan %#x pppoe %d offload %d\n",
+			   r->iif, nss_mc_why_name[r->why], r->cur.in.src,
+			   r->cur.in.vlan, r->pppoe,
+			   !!(r->mfc->mfc_flags & MFC_OFFLOAD));
+		for (i = 0; i < r->nports; i++)
+			seq_printf(s, "  ports %u -> %u installed %d\n",
+				   ntohs(r->port[i].sport),
+				   ntohs(r->port[i].dport),
+				   r->port[i].installed);
+		for (i = 0; i < r->cur.n; i++)
+			seq_printf(s, "  if %d vlan %#x mtu %u %pM\n",
+				   r->cur.m[i].ifnum, r->cur.m[i].vlan,
+				   r->cur.m[i].mtu, r->cur.m[i].mac);
+	}
+}
+
+static void nss_mc_drain(void)
+{
+	struct nss_mc_event *ev, *etmp;
+	struct nss_mc_route *r, *rtmp;
+	struct nss_mc_mdb *e, *mtmp;
+
+	cancel_work_sync(&nss_mc_work);
+
+	list_for_each_entry_safe(ev, etmp, &nss_mc_events, node) {
+		if (ev->mfc)
+			mr_cache_put(ev->mfc);
+		kfree(ev);
+	}
+	INIT_LIST_HEAD(&nss_mc_events);
+
+	rtnl_lock();
+	list_for_each_entry_safe(r, rtmp, &nss_mc_routes, node)
+		nss_mc_route_del(NULL, r);
+	rtnl_unlock();
+
+	list_for_each_entry_safe(e, mtmp, &nss_mc_mdbs, node)
+		kfree(e);
+	INIT_LIST_HEAD(&nss_mc_mdbs);
+}
+
+int nss_mc_init(void)
+{
+	int ret;
+
+	ret = register_switchdev_blocking_notifier(&nss_mc_switchdev_nb);
+	if (ret)
+		return ret;
+
+	ret = nf_register_net_hooks(&init_net, nss_mc_hook_ops, NSS_MC_NHOOKS);
+	if (ret)
+		goto switchdev;
+
+	ret = register_fib_notifier(&init_net, &nss_mc_fib_nb,
+				    nss_mc_fib_flush, NULL);
+	if (ret)
+		goto hooks;
+
+	return 0;
+
+hooks:
+	nf_unregister_net_hooks(&init_net, nss_mc_hook_ops, NSS_MC_NHOOKS);
+switchdev:
+	unregister_switchdev_blocking_notifier(&nss_mc_switchdev_nb);
+	nss_mc_drain();
+
+	return ret;
+}
+
+/* The core is already unbound and halted, so nothing is sent. */
+void nss_mc_exit(void)
+{
+	unregister_fib_notifier(&init_net, &nss_mc_fib_nb);
+	nf_unregister_net_hooks(&init_net, nss_mc_hook_ops, NSS_MC_NHOOKS);
+	unregister_switchdev_blocking_notifier(&nss_mc_switchdev_nb);
+	nss_mc_drain();
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_meminfo.c b/package/kernel/nss-wifi-drv/src/nss_meminfo.c
new file mode 100644
index 0000000000..ca6099b670
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_meminfo.c
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Satisfying the firmware's memory requests.
+ *
+ * The image carries a table of the memory it wants, because its heap and
+ * table sizes change from one firmware line to the next and the host has no
+ * way to know them. The host walks that table, allocates each block and
+ * writes the address back into the request. There is no negotiation and no
+ * error channel: the firmware reads the address it is given and uses it, so a
+ * block left unsatisfied is a coprocessor writing into whatever happens to be
+ * at that address.
+ *
+ * Two of the blocks are also the host's own: the page describing the message
+ * rings, whose contents the host fills in, and the log ring, which is how the
+ * firmware is read after it fails.
+ */
+
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/slab.h>
+
+#include "nss_drv.h"
+
+/* The reserve area at the head of the image points at the request table. */
+struct nss_meminfo_reserve {
+	u32 magic;
+	u32 map_addr;
+};
+
+void *nss_mem_alloc(struct nss_core *core, size_t size, u32 align,
+		    u32 *addr_out)
+{
+	struct nss_alloc *a;
+	dma_addr_t dma;
+	void *cpu;
+
+	a = kzalloc(sizeof(*a), GFP_KERNEL);
+	if (!a)
+		return NULL;
+
+	/* Coherent memory rather than streaming plus hand-written cache
+	 * maintenance. The firmware cannot tell the difference, and the
+	 * alternative is a maintenance call at every ring index update that
+	 * has to be right in both directions every time.
+	 */
+	cpu = dma_alloc_coherent(core->dev, ALIGN(size, align), &dma,
+				 GFP_KERNEL);
+	if (!cpu) {
+		kfree(a);
+		return NULL;
+	}
+
+	a->cpu = cpu;
+	a->dma = dma;
+	a->size = ALIGN(size, align);
+	list_add_tail(&a->node, &core->allocs);
+
+	*addr_out = (u32)dma;
+
+	return cpu;
+}
+
+/* One block back before the core halts, its record with it. */
+void nss_mem_free(struct nss_core *core, void *cpu)
+{
+	struct nss_alloc *a;
+
+	list_for_each_entry(a, &core->allocs, node) {
+		if (a->cpu != cpu)
+			continue;
+
+		dma_free_coherent(core->dev, a->size, a->cpu, a->dma);
+		list_del(&a->node);
+		kfree(a);
+		return;
+	}
+}
+
+void nss_mem_free_all(struct nss_core *core)
+{
+	struct nss_alloc *a, *tmp;
+
+	list_for_each_entry_safe(a, tmp, &core->allocs, node) {
+		dma_free_coherent(core->dev, a->size, a->cpu, a->dma);
+		list_del(&a->node);
+		kfree(a);
+	}
+
+	/* The instruction-memory window is handed out by bumping a pointer
+	 * through it, so it is only reusable if the pointer goes back. A core
+	 * booted a second time asks for the same blocks again.
+	 */
+	core->imem_used = 0;
+	core->if_map = NULL;
+	core->log = NULL;
+	core->log_entries = 0;
+}
+
+/* IMEM is handed out by bumping a pointer through the window the core boots
+ * with. It is on-chip memory reached through a device mapping, so it is
+ * cleared with the accessor for that and never handed back as an ordinary
+ * pointer.
+ */
+static int nss_imem_alloc(struct nss_core *core, size_t size, u32 align,
+			  u32 *addr_out)
+{
+	u32 off = ALIGN(core->imem_used, align);
+
+	if (off + size > core->imem_size)
+		return -ENOMEM;
+
+	memset_io(core->imem + off, 0, size);
+
+	core->imem_used = off + size;
+	*addr_out = core->imem_base + off;
+
+	return 0;
+}
+
+/* The request record, by offset, because it is read and written through an
+ * uncached mapping of the region the image was copied into rather than as a
+ * structure the compiler may reorder accesses to.
+ */
+#define REQ_MAGIC	0
+#define REQ_NAME	2
+#define REQ_MEMTYPE	50
+#define REQ_ALIGNMENT	56
+#define REQ_SIZE	60
+#define REQ_ADDR	64
+#define REQ_STRIDE	68
+
+static int nss_meminfo_satisfy(struct nss_core *core, void __iomem *r)
+{
+	char name[NSS_MEMINFO_BLOCK_NAME_LEN];
+	u32 size = readl(r + REQ_SIZE);
+	u16 memtype = readw(r + REQ_MEMTYPE);
+	u32 align = readl(r + REQ_ALIGNMENT);
+	void *cpu = NULL;
+	bool host_reads;
+	u32 addr;
+	int ret;
+
+	memcpy_fromio(name, r + REQ_NAME, sizeof(name));
+	name[sizeof(name) - 1] = '\0';
+
+	if (!align)
+		align = SMP_CACHE_BYTES;
+
+	/* Two of the blocks are read and written by the host as ordinary
+	 * structures, so they have to come from ordinary memory whatever the
+	 * image asked for. Where a block lives is the host's choice; the
+	 * firmware only reads the address it is handed.
+	 */
+	host_reads = !strcmp(name, "nss_if_mem_map_inst") ||
+		     !strcmp(name, "debug_boot_log_desc");
+
+	if (host_reads && memtype == NSS_MEMINFO_MEMTYPE_IMEM) {
+		dev_info(core->dev, "%s moved to sdram\n", name);
+		memtype = NSS_MEMINFO_MEMTYPE_SDRAM;
+	}
+
+	switch (memtype) {
+	case NSS_MEMINFO_MEMTYPE_IMEM:
+		ret = nss_imem_alloc(core, size, align, &addr);
+		if (ret) {
+			dev_err(core->dev, "meminfo %s: %u bytes of imem\n",
+				name, size);
+			return ret;
+		}
+		writel(addr, r + REQ_ADDR);
+		return 0;
+	case NSS_MEMINFO_MEMTYPE_SDRAM:
+		cpu = nss_mem_alloc(core, size, align, &addr);
+		break;
+	case NSS_MEMINFO_MEMTYPE_INFO:
+		/* Not an allocation: the image asks where its DDR heap may
+		 * run, and is told the region it was loaded into, as a base
+		 * and a size, as qca-nss-drv answers it.
+		 */
+		if (!strcmp(name, "heap_ddr_size")) {
+			writel(core->region_size, r + REQ_SIZE);
+			writel(core->region_base, r + REQ_ADDR);
+			return 0;
+		}
+		dev_warn(core->dev, "unanswered meminfo query %s\n", name);
+		return 0;
+	default:
+		dev_err(core->dev, "meminfo %s wants memtype %u\n", name,
+			memtype);
+		return -EINVAL;
+	}
+
+	if (!cpu) {
+		dev_err(core->dev, "meminfo %s: %u bytes unavailable\n",
+			name, size);
+		return -ENOMEM;
+	}
+
+	memset(cpu, 0, size);
+	writel(addr, r + REQ_ADDR);
+
+	/* The two blocks the host reads or writes itself have to be kept, not
+	 * just allocated: everything else the firmware owns outright.
+	 */
+	if (!strcmp(name, "nss_if_mem_map_inst")) {
+		if (size < sizeof(*core->if_map))
+			return -EINVAL;
+		core->if_map = cpu;
+	} else if (!strcmp(name, "debug_boot_log_desc")) {
+		if (size < sizeof(struct nss_log_descriptor) +
+			   sizeof(struct nss_log_entry))
+			return -EINVAL;
+		core->log = cpu;
+		/* How many entries the ring can hold follows from the block
+		 * the firmware asked for, so the count it later reports has
+		 * something the host measured to be checked against.
+		 */
+		core->log_entries = (size - sizeof(struct nss_log_descriptor)) /
+				    sizeof(struct nss_log_entry);
+	}
+
+	dev_dbg(core->dev, "meminfo %s: %u bytes at %#x\n", name, size, addr);
+
+	return 0;
+}
+
+/* Place the message rings. These are not firmware requests - the host decides
+ * how many rings there are and how large, and publishes that in the index
+ * page.
+ */
+static int nss_meminfo_rings(struct nss_core *core)
+{
+	size_t h2n_sz = sizeof(struct h2n_descriptor) * NSS_H2N_RINGS *
+			NSS_RING_STRIDE_ENTRIES;
+	size_t n2h_sz = sizeof(struct n2h_descriptor) * NSS_N2H_RINGS *
+			NSS_RING_STRIDE_ENTRIES;
+	u32 h2n_addr, n2h_addr;
+	void *h2n, *n2h;
+	int i;
+
+	h2n = nss_mem_alloc(core, h2n_sz, SMP_CACHE_BYTES, &h2n_addr);
+	n2h = nss_mem_alloc(core, n2h_sz, SMP_CACHE_BYTES, &n2h_addr);
+	if (!h2n || !n2h)
+		return -ENOMEM;
+
+	memset(h2n, 0, h2n_sz);
+	memset(n2h, 0, n2h_sz);
+
+	for (i = 0; i < NSS_H2N_RINGS; i++) {
+		u32 off = i * sizeof(struct h2n_descriptor) *
+			  NSS_RING_STRIDE_ENTRIES;
+
+		core->h2n[i].desc = h2n + off;
+		core->h2n[i].hlos_index = 0;
+		spin_lock_init(&core->h2n[i].lock);
+		core->if_map->h2n_desc_if[i].desc_addr = h2n_addr + off;
+		core->if_map->h2n_desc_if[i].size = NSS_RING_ENTRIES;
+	}
+
+	for (i = 0; i < NSS_N2H_RINGS; i++) {
+		u32 off = i * sizeof(struct n2h_descriptor) *
+			  NSS_RING_STRIDE_ENTRIES;
+
+		core->n2h[i].desc = n2h + off;
+		core->n2h[i].hlos_index = 0;
+		core->if_map->n2h_desc_if[i].desc_addr = n2h_addr + off;
+		core->if_map->n2h_desc_if[i].size = NSS_RING_ENTRIES;
+	}
+
+	/* The rings are new and empty, so every count of what is in them
+	 * starts again with them. The index the host publishes is one half of
+	 * a pair the firmware subtracts, and the block was just allocated and
+	 * zeroed, so the other half reads zero when the core is released.
+	 */
+	atomic_set(&core->buffers_queued, 0);
+	memset(core->rx_iface, 0, sizeof(core->rx_iface));
+	memset(core->rx_type, 0, sizeof(core->rx_type));
+	memset(core->seen, 0, sizeof(core->seen));
+	memset(core->ext, 0, sizeof(core->ext));
+	core->ext_seen = 0;
+
+	core->if_map->h2n_rings = NSS_H2N_RINGS;
+	core->if_map->n2h_rings = NSS_N2H_RINGS;
+
+	return 0;
+}
+
+int nss_meminfo_init(struct nss_core *core)
+{
+	struct nss_meminfo_reserve __iomem *reserve;
+	u32 map_addr, magic;
+	void __iomem *map;
+	size_t off;
+	int ret = 0;
+
+	reserve = ioremap(core->load_addr + NSS_MEMINFO_OFFSET,
+			  sizeof(*reserve));
+	if (!reserve)
+		return -ENOMEM;
+
+	magic = readl(&reserve->magic);
+	map_addr = readl(&reserve->map_addr);
+	iounmap(reserve);
+
+	if (magic != NSS_MEMINFO_MAGIC_RESERVE) {
+		dev_err(core->dev, "image has no meminfo table (%#x)\n", magic);
+		return -EINVAL;
+	}
+
+	/* The table lives inside the region the image was copied into, so it
+	 * is bounded by that region rather than by a length of its own.
+	 */
+	if (map_addr < core->region_base ||
+	    map_addr >= core->region_base + core->region_size)
+		return -ERANGE;
+
+	map = ioremap(map_addr, PAGE_SIZE);
+	if (!map)
+		return -ENOMEM;
+
+	if (readl(map) != NSS_MEMINFO_MAGIC_MAP) {
+		dev_err(core->dev, "meminfo table is not one (%#x)\n",
+			readl(map));
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Requests follow the map magic and run until the end marker. The
+	 * walk is bounded by the page that was mapped, so a table whose end
+	 * marker the firmware never wrote cannot run past it.
+	 */
+	off = sizeof(u32);
+
+	while (off + REQ_STRIDE <= PAGE_SIZE &&
+	       readw(map + off + REQ_MAGIC) == NSS_MEMINFO_MAGIC_REQUEST) {
+		ret = nss_meminfo_satisfy(core, map + off);
+		if (ret)
+			goto out;
+
+		off += REQ_STRIDE;
+	}
+
+	if (off + sizeof(u16) > PAGE_SIZE ||
+	    readw(map + off) != NSS_MEMINFO_MAGIC_END) {
+		dev_err(core->dev, "meminfo table has no end\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (!core->if_map) {
+		dev_err(core->dev, "firmware asked for no interface map\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = nss_meminfo_rings(core);
+	if (ret)
+		goto out;
+
+	core->if_map->magic = NSS_IF_MEM_MAP_MAGIC;
+	core->if_map->if_version = NSS_IF_MEM_MAP_VERSION;
+
+out:
+	iounmap(map);
+
+	return ret;
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_mesh.c b/package/kernel/nss-wifi-drv/src/nss_mesh.c
new file mode 100644
index 0000000000..538a9ce842
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_mesh.c
@@ -0,0 +1,866 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* 802.11s on the firmware lines that forward a mesh themselves.
+ *
+ * A mesh interface is three firmware nodes: the virtual device that carries
+ * its 802.11 frames, an encapsulation node that takes ethernet in and hands
+ * mesh frames to that device, and a decapsulation node the device hands its
+ * receive to. The two mesh nodes keep the path tables. The subsystem decides
+ * every path, so its table is mirrored into the firmware, and the firmware
+ * reports what only it sees - a path in use, a destination it has no path to,
+ * a proxy it learned from a frame.
+ *
+ * The subsystem changes a path with spinlocks held, so a change is queued
+ * here and sent from process context, in order.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/etherdevice.h>
+#include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+
+#include "nss_drv.h"
+#include <linux/soc/qcom/nss_wifi.h>
+
+#define NSS_MESH_MAX		4
+#define NSS_MESH_TTL		31
+#define NSS_MESH_REFRESH_MS	1000
+#define NSS_MESH_QUEUE_MAX	1024
+
+/* How often the proxy table is read back. A proxy whose traffic the firmware
+ * carries is never seen by the subsystem, which would otherwise expire it.
+ */
+#define NSS_MESH_AGE_MS		(60 * MSEC_PER_SEC)
+
+struct nss_mesh {
+	struct nss_core *core;
+	struct net_device *dev;
+	const struct nss_wifi_mesh_ops *ops;	/* NULL: slot free */
+	void *priv;
+	int link;
+	int encap;
+	int decap;
+	u8 ttl;
+	u32 refresh;
+	bool forward;
+	u64 dropped;
+	struct nss_wifi_mesh_stats_sync_msg stats[2];	/* encap, decap */
+};
+
+static struct nss_mesh nss_mesh_tbl[NSS_MESH_MAX];
+static DEFINE_MUTEX(nss_mesh_lock);
+
+#define NSS_MESH_CMD_DUMP	(NSS_WIFI_MESH_MPP_DEL + 1)
+
+struct nss_mesh_cmd {
+	struct list_head node;
+	int link;
+	u32 cmd;
+	struct nss_wifi_mesh_path p;
+};
+
+static LIST_HEAD(nss_mesh_queue);
+static u32 nss_mesh_queued;
+static u64 nss_mesh_overflow;
+static DEFINE_SPINLOCK(nss_mesh_queue_lock);
+
+static void nss_mesh_work_fn(struct work_struct *work);
+static DECLARE_WORK(nss_mesh_work, nss_mesh_work_fn);
+static void nss_mesh_age_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(nss_mesh_age, nss_mesh_age_fn);
+
+static struct nss_mesh *nss_mesh_find(int link)
+{
+	int i;
+
+	for (i = 0; i < NSS_MESH_MAX; i++)
+		if (READ_ONCE(nss_mesh_tbl[i].ops) && nss_mesh_tbl[i].link == link)
+			return &nss_mesh_tbl[i];
+
+	return NULL;
+}
+
+static int nss_mesh_msg(struct nss_core *core, int if_num, u32 type,
+			const void *body, size_t len)
+{
+	struct nss_wifi_mesh_msg *m __free(kfree) = kzalloc(sizeof(*m),
+							    GFP_KERNEL);
+	int ret;
+
+	if (!m)
+		return -ENOMEM;
+
+	m->cm.interface = if_num;
+	m->cm.type = type;
+	if (body)
+		memcpy(&m->msg, body, len);
+
+	ret = nss_msg_send(core, m, offsetof(struct nss_wifi_mesh_msg, msg) +
+				    len);
+	if (!ret && m->cm.error)
+		ret = -EIO;
+
+	return ret;
+}
+
+static int nss_mesh_node(struct nss_core *core, u32 type)
+{
+	struct nss_dynamic_interface_msg d = {};
+	int ret;
+
+	d.cm.interface = NSS_INTERFACE_DYNAMIC;
+	d.cm.type = NSS_DYNAMIC_INTERFACE_ALLOC_NODE;
+	d.msg.alloc_node.type = type;
+	ret = nss_msg_send(core, &d, sizeof(d));
+	if (ret)
+		return ret;
+
+	if (d.msg.alloc_node.if_num < 0 ||
+	    d.msg.alloc_node.if_num >= NSS_INTERFACE_MAX)
+		return -ERANGE;
+
+	return d.msg.alloc_node.if_num;
+}
+
+static void nss_mesh_node_free(struct nss_core *core, int if_num, u32 type)
+{
+	struct nss_dynamic_interface_msg d = {};
+
+	if (if_num < 0)
+		return;
+
+	d.cm.interface = NSS_INTERFACE_DYNAMIC;
+	d.cm.type = NSS_DYNAMIC_INTERFACE_DEALLOC_NODE;
+	d.msg.dealloc_node.type = type;
+	d.msg.dealloc_node.if_num = if_num;
+	nss_msg_send(core, &d, sizeof(d));
+}
+
+/* Lines that cannot forward a mesh refuse to say so. */
+bool nss_mesh_probe(struct nss_core *core)
+{
+	struct nss_wifili_msg *m __free(kfree) = kzalloc(sizeof(*m),
+							 GFP_KERNEL);
+	int ret;
+
+	if (!m)
+		return false;
+
+	m->cm.interface = NSS_INTERFACE_WIFILI;
+	m->cm.type = NSS_WIFILI_SEND_MESH_CAPABILITY_INFO;
+	ret = nss_msg_send(core, m, offsetof(struct nss_wifili_msg, msg) +
+				    sizeof(m->msg.cap_info));
+
+	dev_info(core->dev, "mesh forwarding: %s\n", ret ? "no" : "yes");
+
+	return !ret;
+}
+
+static int nss_mesh_configure(struct nss_mesh *m, u32 flags)
+{
+	struct nss_wifi_mesh_config_msg c = {};
+	int ret;
+
+	ether_addr_copy(c.local_mac_addr, m->dev->dev_addr);
+	c.ttl = m->ttl;
+	c.mesh_path_refresh_time = m->refresh;
+	c.mpp_learning_mode = NSS_WIFI_MESH_MPP_LEARNING_MODE_INDEPENDENT_NSS;
+	c.block_mesh_forwarding = !m->forward;
+	c.config_flags = flags;
+
+	c.sibling_ifnum = m->decap;
+	ret = nss_mesh_msg(m->core, m->encap,
+			   NSS_WIFI_MESH_MSG_INTERFACE_CONFIGURE, &c, sizeof(c));
+	if (ret)
+		return ret;
+
+	c.sibling_ifnum = m->encap;
+	return nss_mesh_msg(m->core, m->decap,
+			    NSS_WIFI_MESH_MSG_INTERFACE_CONFIGURE, &c, sizeof(c));
+}
+
+static int nss_mesh_open(struct nss_mesh *m, u32 type)
+{
+	size_t len = type == NSS_IF_OPEN ? sizeof(struct nss_if_open) :
+					   sizeof(struct nss_if_close);
+	int ret;
+
+	ret = nss_mesh_msg(m->core, m->encap, type, NULL, len);
+	if (ret)
+		return ret;
+
+	return nss_mesh_msg(m->core, m->decap, type, NULL, len);
+}
+
+int nss_mesh_add(struct nss_core *core, struct net_device *dev, int link,
+		 const u8 *mac, const struct nss_wifi_mesh_ops *ops, void *priv)
+{
+	struct nss_mesh *m = NULL;
+	int i, ret = 0;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	for (i = 0; i < NSS_MESH_MAX; i++)
+		if (!nss_mesh_tbl[i].ops && !nss_mesh_tbl[i].dev)
+			m = &nss_mesh_tbl[i];
+	if (!m)
+		return -ENOSPC;
+
+	memset(m, 0, sizeof(*m));
+	m->core = core;
+	m->dev = dev;
+	m->link = link;
+	m->ttl = NSS_MESH_TTL;
+	m->refresh = NSS_MESH_REFRESH_MS;
+	m->forward = true;
+	m->decap = -1;
+
+	m->encap = nss_mesh_node(core, NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_INNER);
+	if (m->encap < 0)
+		goto fail;
+
+	m->decap = nss_mesh_node(core, NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_OUTER);
+	if (m->decap < 0)
+		goto fail;
+
+	ret = nss_mesh_configure(m, NSS_WIFI_MESH_CONFIG_FLAG_TTL_VALID |
+				 NSS_WIFI_MESH_CONFIG_FLAG_MPATH_REFRESH_VALID |
+				 NSS_WIFI_MESH_CONFIG_FLAG_MPP_LEARNING_MODE_VALID |
+				 NSS_WIFI_MESH_CONFIG_FLAG_BLOCK_MESH_FWD_VALID |
+				 NSS_WIFI_MESH_CONFIG_FLAG_LOCAL_MAC_VALID |
+				 NSS_WIFI_MESH_CONFIG_FLAG_SIBLING_IF_NUM_VALID);
+	if (ret)
+		goto fail;
+
+	/* The decapsulation node delivers ethernet for this host. The
+	 * encapsulation node is bound too, so that a flow out of the mesh
+	 * resolves to the node that builds the mesh header.
+	 */
+	dev_hold(dev);
+	rcu_assign_pointer(core->iface[m->encap], dev);
+	dev_hold(dev);
+	rcu_assign_pointer(core->iface[m->decap], dev);
+
+	m->priv = priv;
+	smp_store_release(&m->ops, ops);
+
+	mod_delayed_work(system_wq, &nss_mesh_age,
+			 msecs_to_jiffies(NSS_MESH_AGE_MS));
+
+	dev_info(core->dev, "mesh %s: link %d encap %d decap %d\n",
+		 netdev_name(dev), link, m->encap, m->decap);
+
+	return 0;
+
+fail:
+	ret = m->encap < 0 ? m->encap : m->decap < 0 ? m->decap : ret;
+	nss_mesh_node_free(core, m->decap,
+			   NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_OUTER);
+	nss_mesh_node_free(core, m->encap,
+			   NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_INNER);
+	m->dev = NULL;
+
+	return ret;
+}
+
+/* The device forwards its receive to the decapsulation node, and multicast
+ * comes to the host as well: the subsystem forwards it and filters its
+ * duplicates, and the firmware does neither.
+ */
+int nss_mesh_attach(struct nss_core *core, int link)
+{
+	struct nss_wifi_vdev_set_next_hop_msg nh = {};
+	struct nss_mesh *m;
+	int ret;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	m = nss_mesh_find(link);
+	if (!m)
+		return -ENODEV;
+
+	nh.ifnumber = m->decap;
+	ret = nss_wifili_vdev_msg(core, link, NSS_WIFI_VDEV_SET_NEXT_HOP,
+				  &nh, sizeof(nh));
+	if (!ret)
+		ret = nss_wifili_vdev_cmd(core, link,
+					  NSS_WIFI_VDEV_CFG_MCBC_EXC_TO_HOST_CMD,
+					  1);
+	if (!ret)
+		ret = nss_mesh_open(m, NSS_IF_OPEN);
+
+	return ret;
+}
+
+static void nss_mesh_unbind(struct nss_core *core, int if_num)
+{
+	struct net_device *dev;
+
+	dev = rcu_replace_pointer(core->iface[if_num], NULL, true);
+	if (dev)
+		dev_put(dev);
+}
+
+/* Callbacks off and the nodes closed, before the device goes down. */
+void nss_mesh_stop(struct nss_core *core, int link)
+{
+	struct nss_mesh *m;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	m = nss_mesh_find(link);
+	if (!m)
+		return;
+
+	WRITE_ONCE(m->ops, NULL);
+	nss_mesh_unbind(core, m->encap);
+	nss_mesh_unbind(core, m->decap);
+	synchronize_net();
+
+	nss_mesh_open(m, NSS_IF_CLOSE);
+}
+
+/* After the device is released, which is what stops it feeding the nodes. */
+void nss_mesh_del(struct nss_core *core, int link)
+{
+	int i;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	for (i = 0; i < NSS_MESH_MAX; i++) {
+		struct nss_mesh *m = &nss_mesh_tbl[i];
+
+		if (!m->dev || m->ops || m->link != link)
+			continue;
+
+		nss_mesh_node_free(core, m->decap,
+				   NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_OUTER);
+		nss_mesh_node_free(core, m->encap,
+				   NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_INNER);
+		m->dev = NULL;
+	}
+}
+
+/* A new core never knew the old nodes, and halting it dropped the bindings. */
+void nss_mesh_reset(void)
+{
+	int i;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	for (i = 0; i < NSS_MESH_MAX; i++)
+		WRITE_ONCE(nss_mesh_tbl[i].ops, NULL);
+	synchronize_net();
+
+	memset(nss_mesh_tbl, 0, sizeof(nss_mesh_tbl));
+}
+
+/* A flow out of the mesh goes to the node that builds the mesh header. */
+int nss_mesh_ifnum(int ifindex)
+{
+	int i;
+
+	for (i = 0; i < NSS_MESH_MAX; i++) {
+		struct nss_mesh *m = &nss_mesh_tbl[i];
+
+		if (READ_ONCE(m->ops) && m->dev->ifindex == ifindex)
+			return m->encap;
+	}
+
+	return -ENODEV;
+}
+
+static int nss_mesh_queue_cmd(int if_num, u32 cmd,
+			      const struct nss_wifi_mesh_path *p)
+{
+	struct nss_mesh_cmd *c;
+
+	c = kmalloc(sizeof(*c), GFP_ATOMIC);
+	if (!c)
+		return -ENOMEM;
+
+	c->link = if_num;
+	c->cmd = cmd;
+	c->p = *p;
+
+	scoped_guard(spinlock_bh, &nss_mesh_queue_lock) {
+		if (nss_mesh_queued >= NSS_MESH_QUEUE_MAX) {
+			nss_mesh_overflow++;
+			kfree(c);
+			return -ENOBUFS;
+		}
+		list_add_tail(&c->node, &nss_mesh_queue);
+		nss_mesh_queued++;
+	}
+
+	schedule_work(&nss_mesh_work);
+
+	return 0;
+}
+
+int nss_wifi_mesh_path(int if_num, enum nss_wifi_mesh_cmd cmd,
+		       const struct nss_wifi_mesh_path *p)
+{
+	if (cmd > NSS_WIFI_MESH_MPP_DEL)
+		return -EINVAL;
+
+	return nss_mesh_queue_cmd(if_num, cmd, p);
+}
+EXPORT_SYMBOL_GPL(nss_wifi_mesh_path);
+
+static void nss_mesh_send(struct nss_mesh *m, const struct nss_mesh_cmd *c)
+{
+	const struct nss_wifi_mesh_path *p = &c->p;
+	union {
+		struct nss_wifi_mesh_mpath_add_msg add;
+		struct nss_wifi_mesh_mpath_update_msg upd;
+		struct nss_wifi_mesh_mpath_del_msg del;
+		struct nss_wifi_mesh_proxy_path_add_msg padd;
+		struct nss_wifi_mesh_proxy_path_update_msg pupd;
+		struct nss_wifi_mesh_proxy_path_del_msg pdel;
+	} b = {};
+	size_t len;
+	u32 type;
+
+	switch (c->cmd) {
+	case NSS_WIFI_MESH_MPATH_ADD:
+		type = NSS_WIFI_MESH_MSG_MPATH_ADD;
+		len = sizeof(b.add);
+		ether_addr_copy(b.add.dest_mac_addr, p->mesh_da);
+		ether_addr_copy(b.add.next_hop_mac_addr, p->next_hop);
+		b.add.metric = p->metric;
+		b.add.link_vap_id = m->link;
+		b.add.hop_count = p->hop_count;
+		b.add.path_flags = p->flags;
+		b.add.metadata_type = NSS_WIFI_MESH_PRE_HEADER_NONE;
+		break;
+	case NSS_WIFI_MESH_MPATH_UPDATE:
+		type = NSS_WIFI_MESH_MSG_MPATH_UPDATE;
+		len = sizeof(b.upd);
+		ether_addr_copy(b.upd.dest_mac_addr, p->mesh_da);
+		ether_addr_copy(b.upd.next_hop_mac_addr, p->next_hop);
+		ether_addr_copy(b.upd.old_next_hop_mac_addr, p->old_next_hop);
+		b.upd.metric = p->metric;
+		b.upd.link_vap_id = m->link;
+		b.upd.expiry_time = p->exp_ms;
+		b.upd.hop_count = p->hop_count;
+		b.upd.path_flags = p->flags;
+		b.upd.is_mesh_gate = p->gate;
+		/* The field is a byte, so the marker is truncated, as the
+		 * vendor stack sends it on this line.
+		 */
+		b.upd.metadata_type = (u8)NSS_WIFI_MESH_PRE_HEADER_NONE;
+		b.upd.update_flags = NSS_WIFI_MESH_PATH_UPDATE_FLAG_NEXTHOP |
+				     NSS_WIFI_MESH_PATH_UPDATE_FLAG_HOPCOUNT |
+				     NSS_WIFI_MESH_PATH_UPDATE_FLAG_METRIC |
+				     NSS_WIFI_MESH_PATH_UPDATE_FLAG_MESH_FLAGS |
+				     NSS_WIFI_MESH_PATH_UPDATE_FLAG_BLOCK_MESH_FWD |
+				     NSS_WIFI_MESH_PATH_UPDATE_FLAG_METADATA_ENABLE_VALID;
+		break;
+	case NSS_WIFI_MESH_MPATH_DEL:
+		type = NSS_WIFI_MESH_MSG_MPATH_DELETE;
+		len = sizeof(b.del);
+		b.del.link_vap_id = m->link;
+		ether_addr_copy(b.del.mesh_dest_mac_addr, p->mesh_da);
+		ether_addr_copy(b.del.next_hop_mac_addr, p->next_hop);
+		break;
+	case NSS_WIFI_MESH_MPP_ADD:
+		type = NSS_WIFI_MESH_MSG_PROXY_PATH_ADD;
+		len = sizeof(b.padd);
+		ether_addr_copy(b.padd.dest_mac_addr, p->da);
+		ether_addr_copy(b.padd.mesh_dest_mac, p->mesh_da);
+		b.padd.path_flags = p->flags;
+		break;
+	case NSS_WIFI_MESH_MPP_UPDATE:
+		type = NSS_WIFI_MESH_MSG_PROXY_PATH_UPDATE;
+		len = sizeof(b.pupd);
+		ether_addr_copy(b.pupd.dest_mac_addr, p->da);
+		ether_addr_copy(b.pupd.mesh_dest_mac, p->mesh_da);
+		b.pupd.path_flags = p->flags;
+		b.pupd.bitmap = NSS_WIFI_MESH_PROXY_PATH_UPDATE_FLAG_MDA |
+				NSS_WIFI_MESH_PROXY_PATH_UPDATE_FLAG_MESH;
+		break;
+	case NSS_WIFI_MESH_MPP_DEL:
+		type = NSS_WIFI_MESH_MSG_PROXY_PATH_DELETE;
+		len = sizeof(b.pdel);
+		ether_addr_copy(b.pdel.dest_mac_addr, p->da);
+		ether_addr_copy(b.pdel.mesh_dest_mac_addr, p->mesh_da);
+		break;
+	case NSS_MESH_CMD_DUMP:
+		/* The table comes back as notifications. */
+		type = NSS_WIFI_MESH_MSG_PROXY_PATH_TABLE_DUMP;
+		len = sizeof(struct nss_wifi_mesh_proxy_path_table_dump);
+		break;
+	default:
+		return;
+	}
+
+	if (nss_mesh_msg(m->core, m->encap, type, &b, len))
+		m->dropped++;
+}
+
+static void nss_mesh_work_fn(struct work_struct *work)
+{
+	LIST_HEAD(list);
+	struct nss_mesh_cmd *c, *tmp;
+
+	scoped_guard(spinlock_bh, &nss_mesh_queue_lock) {
+		list_splice_init(&nss_mesh_queue, &list);
+		nss_mesh_queued = 0;
+	}
+
+	list_for_each_entry_safe(c, tmp, &list, node) {
+		scoped_guard(mutex, &nss_mesh_lock) {
+			struct nss_mesh *m = nss_mesh_find(c->link);
+
+			if (m)
+				nss_mesh_send(m, c);
+		}
+		kfree(c);
+	}
+}
+
+static void nss_mesh_age_fn(struct work_struct *work)
+{
+	struct nss_wifi_mesh_path p = {};
+	bool any = false;
+	int i;
+
+	for (i = 0; i < NSS_MESH_MAX; i++) {
+		int link;
+
+		scoped_guard(mutex, &nss_mesh_lock) {
+			link = nss_mesh_tbl[i].ops ? nss_mesh_tbl[i].link : -1;
+		}
+		if (link < 0)
+			continue;
+
+		any = true;
+		nss_mesh_queue_cmd(link, NSS_MESH_CMD_DUMP, &p);
+	}
+
+	if (any)
+		schedule_delayed_work(&nss_mesh_age,
+				      msecs_to_jiffies(NSS_MESH_AGE_MS));
+}
+
+int nss_wifi_mesh_config(int if_num, u8 ttl, u32 refresh_ms, bool forward)
+{
+	struct nss_mesh *m;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	m = nss_mesh_find(if_num);
+	if (!m)
+		return -ENODEV;
+
+	if (m->ttl == ttl && m->refresh == refresh_ms && m->forward == forward)
+		return 0;
+
+	m->ttl = ttl;
+	m->refresh = refresh_ms;
+	m->forward = forward;
+
+	return nss_mesh_configure(m, NSS_WIFI_MESH_CONFIG_FLAG_TTL_VALID |
+				  NSS_WIFI_MESH_CONFIG_FLAG_MPATH_REFRESH_VALID |
+				  NSS_WIFI_MESH_CONFIG_FLAG_BLOCK_MESH_FWD_VALID);
+}
+EXPORT_SYMBOL_GPL(nss_wifi_mesh_config);
+
+static struct nss_mesh *nss_mesh_by_node(int if_num, int *which)
+{
+	int i;
+
+	for (i = 0; i < NSS_MESH_MAX; i++) {
+		struct nss_mesh *m = &nss_mesh_tbl[i];
+
+		if (!READ_ONCE(m->ops))
+			continue;
+		if (m->encap == if_num || m->decap == if_num) {
+			*which = m->decap == if_num;
+			return m;
+		}
+		if (m->link == if_num) {
+			*which = 2;
+			return m;
+		}
+	}
+
+	return NULL;
+}
+
+static void nss_mesh_mpp_dump(struct nss_mesh *m,
+			      const struct nss_wifi_mesh_ops *ops,
+			      const void *body, u32 blen)
+{
+	const struct nss_wifi_mesh_proxy_path_table_dump *d = body;
+	size_t hdr = offsetof(struct nss_wifi_mesh_proxy_path_table_dump,
+			      path_entry);
+	u32 i, n;
+
+	if (blen < hdr)
+		return;
+
+	n = min_t(u32, d->num_entries,
+		  (blen - hdr) / sizeof(d->path_entry[0]));
+
+	for (i = 0; i < n; i++) {
+		const struct nss_wifi_mesh_proxy_path_dump_entry *e =
+			&d->path_entry[i];
+		struct nss_wifi_mesh_path p = {};
+
+		if (e->time_diff > NSS_MESH_AGE_MS)
+			continue;
+
+		ether_addr_copy(p.da, e->dest_mac_addr);
+		ether_addr_copy(p.mesh_da, e->mesh_dest_mac);
+		p.flags = e->flags;
+		ops->event(m->priv, NSS_WIFI_MESH_EV_MPP_UPDATE, &p);
+	}
+}
+
+static size_t nss_mesh_body_len(u32 type)
+{
+	switch (type) {
+	case NSS_WIFI_MESH_MSG_PATH_REFRESH:
+		return sizeof(struct nss_wifi_mesh_path_refresh_msg);
+	case NSS_WIFI_MESH_MSG_PATH_NOT_FOUND:
+		return sizeof(struct nss_wifi_mesh_mpath_not_found_msg);
+	case NSS_WIFI_MESH_MSG_MPATH_DELETE:
+		return sizeof(struct nss_wifi_mesh_mpath_del_msg);
+	case NSS_WIFI_MESH_MSG_PATH_EXPIRY:
+		return sizeof(struct nss_wifi_mesh_path_expiry_msg);
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_LEARN:
+		return sizeof(struct nss_wifi_mesh_proxy_path_learn_msg);
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_ADD:
+		return sizeof(struct nss_wifi_mesh_proxy_path_add_msg);
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_UPDATE:
+		return sizeof(struct nss_wifi_mesh_proxy_path_update_msg);
+	case NSS_WIFI_MESH_MSG_STATS_SYNC:
+		return sizeof(struct nss_wifi_mesh_stats_sync_msg);
+	default:
+		return 0;
+	}
+}
+
+/* What the mesh nodes say unasked. Called from softirq. */
+bool nss_mesh_notify(struct nss_core *core, const struct nss_cmn_msg *ncm,
+		     u32 len)
+{
+	const struct nss_wifi_mesh_ops *ops;
+	struct nss_wifi_mesh_path p = {};
+	enum nss_wifi_mesh_event ev;
+	const void *body = ncm + 1;
+	struct nss_mesh *m;
+	u32 blen;
+	int which;
+
+	guard(rcu)();
+
+	m = nss_mesh_by_node(NSS_INTERFACE_NUM_GET(ncm->interface), &which);
+	if (!m || which == 2)
+		return false;
+
+	ops = smp_load_acquire(&m->ops);
+	if (!ops)
+		return true;
+
+	blen = min_t(u32, len - sizeof(*ncm), ncm->len);
+
+	if (blen < nss_mesh_body_len(ncm->type))
+		return true;
+
+	switch (ncm->type) {
+	case NSS_WIFI_MESH_MSG_PATH_REFRESH: {
+		const struct nss_wifi_mesh_path_refresh_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->dest_mac_addr);
+		ether_addr_copy(p.next_hop, r->next_hop_mac_addr);
+		ev = NSS_WIFI_MESH_EV_REFRESH;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PATH_NOT_FOUND: {
+		const struct nss_wifi_mesh_mpath_not_found_msg *r = body;
+
+		ether_addr_copy(p.da, r->dest_mac_addr);
+		if (r->is_mesh_forward_path)
+			ether_addr_copy(p.ta, r->transmitter_mac_addr);
+		ev = NSS_WIFI_MESH_EV_NOT_FOUND;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_MPATH_DELETE: {
+		const struct nss_wifi_mesh_mpath_del_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->mesh_dest_mac_addr);
+		ev = NSS_WIFI_MESH_EV_MPATH_DEL;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PATH_EXPIRY: {
+		const struct nss_wifi_mesh_path_expiry_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->mesh_dest_mac_addr);
+		ether_addr_copy(p.next_hop, r->next_hop_mac_addr);
+		ev = NSS_WIFI_MESH_EV_EXPIRY;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_LEARN: {
+		const struct nss_wifi_mesh_proxy_path_learn_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->mesh_dest_mac);
+		ether_addr_copy(p.da, r->dest_mac_addr);
+		p.flags = r->path_flags;
+		ev = NSS_WIFI_MESH_EV_MPP_LEARN;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_ADD: {
+		const struct nss_wifi_mesh_proxy_path_add_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->mesh_dest_mac);
+		ether_addr_copy(p.da, r->dest_mac_addr);
+		p.flags = r->path_flags;
+		ev = NSS_WIFI_MESH_EV_MPP_ADD;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_UPDATE: {
+		const struct nss_wifi_mesh_proxy_path_update_msg *r = body;
+
+		ether_addr_copy(p.mesh_da, r->mesh_dest_mac);
+		ether_addr_copy(p.da, r->dest_mac_addr);
+		p.flags = r->path_flags;
+		ev = NSS_WIFI_MESH_EV_MPP_UPDATE;
+		break;
+	}
+	case NSS_WIFI_MESH_MSG_PROXY_PATH_TABLE_DUMP:
+		nss_mesh_mpp_dump(m, ops, body, blen);
+		return true;
+	case NSS_WIFI_MESH_MSG_STATS_SYNC: {
+		/* Each sync carries what was counted since the last one. */
+		u32 *sum = (u32 *)&m->stats[which];
+		const u32 *d = body;
+		size_t i;
+
+		for (i = 0; i < sizeof(m->stats[0]) / sizeof(u32); i++)
+			sum[i] += d[i];
+		return true;
+	}
+	default:
+		return true;
+	}
+
+	ops->event(m->priv, ev, &p);
+
+	return true;
+}
+
+/* Frames the mesh nodes and the device hand up with a metadata word in front.
+ * Called from softirq; the buffer is the host's once this returns true.
+ */
+bool nss_mesh_recv(struct nss_core *core, struct napi_struct *napi,
+		   const struct n2h_descriptor *desc, struct sk_buff *skb)
+{
+	u32 end = (u32)desc->payload_offs + desc->payload_len;
+	const struct nss_wifi_mesh_ops *ops;
+	struct nss_mesh *m;
+	u32 type, md;
+	int which;
+
+	if (desc->buffer_type != NSS_N2H_BUFFER_PACKET_EXT ||
+	    desc->interface_num >= NSS_INTERFACE_MAX)
+		return false;
+
+	guard(rcu)();
+
+	m = nss_mesh_by_node(desc->interface_num, &which);
+	if (!m || which == 1)
+		return false;
+
+	/* The metadata is in the headroom, so the payload starts past it. */
+	md = which == 2 ? NSS_WIFI_VDEV_PER_PACKET_METADATA_OFFSET +
+			  sizeof(struct nss_wifi_vdev_per_packet_metadata) :
+			  NSS_WIFI_MESH_ENCAP_METADATA_OFFSET_TYPE +
+			  sizeof(struct nss_wifi_mesh_encap_ext_pkt_metadata);
+
+	ops = smp_load_acquire(&m->ops);
+	if (!ops || end > NSS_EMPTY_BUFFER_ALLOC || desc->payload_offs < md ||
+	    desc->payload_len < ETH_HLEN)
+		return false;
+
+	dma_unmap_single(core->dev, desc->buffer, NSS_EMPTY_BUFFER_ALLOC,
+			 DMA_FROM_DEVICE);
+	skb_reserve(skb, desc->payload_offs);
+	skb_put(skb, desc->payload_len);
+
+	if (which == 2) {
+		/* Multicast the device received. The subsystem forwards it
+		 * and drops its duplicates, so it enters at 802.11.
+		 */
+		type = ((struct nss_wifi_vdev_per_packet_metadata *)
+			(skb->head + NSS_WIFI_VDEV_PER_PACKET_METADATA_OFFSET))->pkt_type;
+		if (type == NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_MCBC_RX ||
+		    type == NSS_WIFI_VDEV_MESH_EXT_DATA_PKT_TYPE_RX_MCAST_EXC) {
+			ops->rx(m->priv, skb, napi);
+			return true;
+		}
+	} else {
+		/* Ethernet the encapsulation node had no path for: the
+		 * subsystem resolves one and sends it as 802.11.
+		 */
+		type = ((struct nss_wifi_mesh_encap_ext_pkt_metadata *)
+			(skb->head + NSS_WIFI_MESH_ENCAP_METADATA_OFFSET_TYPE))->pkt_type;
+		if (type == NSS_WIFI_MESH_ENCAP_EXT_DATA_PKT_TYPE_MPATH_NOT_FOUND_EXC) {
+			skb->dev = m->dev;
+			skb_reset_mac_header(skb);
+			skb->protocol = eth_hdr(skb)->h_proto;
+			skb_set_network_header(skb, ETH_HLEN);
+			dev_queue_xmit(skb);
+			return true;
+		}
+	}
+
+	m->dropped++;
+	dev_kfree_skb_any(skb);
+
+	return true;
+}
+
+void nss_mesh_print(struct seq_file *s)
+{
+	int i;
+
+	guard(mutex)(&nss_mesh_lock);
+
+	seq_printf(s, "path queue overflow %llu\n", nss_mesh_overflow);
+
+	for (i = 0; i < NSS_MESH_MAX; i++) {
+		const struct nss_mesh *m = &nss_mesh_tbl[i];
+		const struct nss_wifi_mesh_encap_stats *e =
+			&m->stats[0].mesh_encap_stats;
+		const struct nss_wifi_mesh_decap_stats *d =
+			&m->stats[1].mesh_decap_stats;
+
+		if (!m->ops)
+			continue;
+
+		seq_printf(s, "%s link %d encap %d decap %d ttl %u refresh %u fwd %d dropped %llu\n",
+			   netdev_name(m->dev), m->link, m->encap, m->decap,
+			   m->ttl, m->refresh, m->forward, m->dropped);
+		seq_printf(s, "  encap rx %u tx %u mp_not_found %u mp_active %u mpp_found %u ra_lup_fail %u link_enqueue %u to_host %u\n",
+			   m->stats[0].pnode_stats.rx_packets,
+			   m->stats[0].pnode_stats.tx_packets,
+			   e->mp_not_found, e->mp_active, e->mpp_found,
+			   e->ra_lup_fail, e->link_enqueue, e->sent_to_host);
+		seq_printf(s, "  decap rx %u tx %u ttl0 %u mpp_lup_fail %u fwd ok %u fail %u mp_fwd_lookup_fail %u\n",
+			   m->stats[1].pnode_stats.rx_packets,
+			   m->stats[1].pnode_stats.tx_packets,
+			   d->ttl_0, d->mpp_lup_fail, d->rx_fwd_success,
+			   d->rx_fwd_fail, d->mp_fwd_lookup_fail);
+	}
+}
+
+void nss_mesh_exit(void)
+{
+	cancel_delayed_work_sync(&nss_mesh_age);
+	cancel_work_sync(&nss_mesh_work);
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_msg.c b/package/kernel/nss-wifi-drv/src/nss_msg.c
new file mode 100644
index 0000000000..33ec53a945
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_msg.c
@@ -0,0 +1,365 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Asking the firmware to do something, and hearing back.
+ *
+ * A control message goes out on its own host-to-firmware ring, which the
+ * firmware drains ahead of every data ring. The firmware writes its answer
+ * into the same buffer and hands that buffer straight back, so a message is a
+ * single block that travels out and returns rather than a request and a
+ * separate reply.
+ *
+ * Two things about that are not obvious and are both load-bearing. The
+ * descriptor's payload length is not the size of the request: it is the room
+ * the firmware is given for its answer, and it is also the bound the firmware
+ * checks the message length against. And the first and last segment flags are
+ * not optional on a single-segment buffer: without the first-segment flag the
+ * descriptor is consumed and the buffer never comes back.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/mutex.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include "nss_drv.h"
+
+/* The firmware answers in the buffer it was sent, so the buffer is as large
+ * as the largest answer rather than as the request.
+ */
+#define NSS_MSG_BUF_SIZE	NSS_EMPTY_BUFFER_SIZE
+
+#define NSS_MSG_TIMEOUT_MS	2000
+
+int nss_msg_init(struct nss_core *core)
+{
+	int ret;
+
+	ret = devm_mutex_init(core->dev, &core->msg.lock);
+	if (ret)
+		return ret;
+
+	init_completion(&core->msg.done);
+
+	core->msg.buf = dmam_alloc_coherent(core->dev, NSS_MSG_BUF_SIZE,
+					    &core->msg.dma, GFP_KERNEL);
+	if (!core->msg.buf)
+		return -ENOMEM;
+
+	return 0;
+}
+
+/* True when the descriptor is carrying the message buffer back. The host
+ * matches on the address it handed out, so a reply is recognised without
+ * dereferencing anything the firmware wrote.
+ */
+bool nss_msg_complete(struct nss_core *core, const struct n2h_descriptor *desc)
+{
+	if (desc->buffer != core->msg.dma)
+		return false;
+
+	complete(&core->msg.done);
+
+	return true;
+}
+
+/* What the firmware says when nothing asked it.
+ *
+ * Every unsolicited message is counted by type, and the first of each type
+ * keeps its opening words. Two of them the host owes an answer to and the
+ * shape of the answer is not derivable from the header: the peer memory
+ * request names how much memory per station the running firmware wants for
+ * its own peer record, which differs between firmware lines and is a
+ * structure the host writes into blind.
+ */
+void nss_msg_seen(struct nss_core *core, const struct nss_cmn_msg *ncm,
+		  u32 len)
+{
+	struct nss_msg_seen *seen;
+	u32 words, i;
+
+	if (ncm->type >= ARRAY_SIZE(core->seen))
+		return;
+
+	seen = &core->seen[ncm->type];
+	words = min_t(u32, len / sizeof(u32), ARRAY_SIZE(seen->last));
+
+	/* The first and the latest, because a counter that is pushed
+	 * repeatedly says nothing in its first push: what is being asked of a
+	 * statistics message is whether a number moved.
+	 */
+	for (i = 0; i < words; i++)
+		seen->last[i] = ((const u32 *)ncm)[i];
+
+	seen->lastwords = words;
+
+	if (seen->count++)
+		return;
+
+	words = min_t(u32, words, ARRAY_SIZE(seen->word));
+	for (i = 0; i < words; i++)
+		seen->word[i] = ((const u32 *)ncm)[i];
+	seen->words = words;
+}
+
+static bool nss_msg_trace;
+module_param_named(msg_trace, nss_msg_trace, bool, 0644);
+MODULE_PARM_DESC(msg_trace, "dump every control message sent to the firmware");
+
+/* Send a message and wait for the firmware's answer in place.
+ *
+ * One at a time: bring-up is a sequence of questions, and a second buffer
+ * would need a way to tell two answers apart that the protocol does not
+ * provide.
+ *
+ * @len is the message as sent and what the firmware's length check sees;
+ * @room is how much of the answer the caller reads back. They differ only
+ * for a request whose reply carries an array sized by the buffer, like the
+ * connection-statistics sweep.
+ */
+static int nss_msg_xact(struct nss_core *core, void *msg, size_t len,
+			size_t room, bool quiet)
+{
+	struct nss_cmn_msg *ncm = msg;
+	struct nss_h2n_ring *ring = &core->h2n[NSS_H2N_RING_COMMAND];
+	struct nss_if_mem_map *map = core->if_map;
+	unsigned long timeout = msecs_to_jiffies(NSS_MSG_TIMEOUT_MS);
+	struct h2n_descriptor *desc;
+	u32 next;
+	int ret;
+
+	if (len < sizeof(*ncm) || len > NSS_MSG_BUF_SIZE ||
+	    room < len || room > NSS_MSG_BUF_SIZE)
+		return -EMSGSIZE;
+
+	guard(mutex)(&core->msg.lock);
+
+	if (!core->running)
+		return -ENODEV;
+
+	if (core->msg.lost) {
+		if (!wait_for_completion_timeout(&core->msg.done, timeout))
+			return -ETIMEDOUT;
+		core->msg.lost = false;
+	}
+
+	/* The header is the layer's to fill: the length the firmware checks
+	 * excludes it, and getting that wrong is answered with a rejection
+	 * rather than a hint.
+	 */
+	ncm->version = NSS_HLOS_MESSAGE_VERSION;
+	ncm->len = len - sizeof(*ncm);
+	memcpy(core->msg.buf, msg, len);
+
+	/* What went out, in the form another host driver of this firmware can
+	 * be compared against byte for byte. Off unless asked for.
+	 */
+	if (nss_msg_trace)
+		print_hex_dump(KERN_INFO, "nssmsg: ", DUMP_PREFIX_OFFSET, 32, 4,
+			       msg, min_t(size_t, len, 512), false);
+
+	/* Before the descriptor is published, not after: the firmware drains
+	 * this ring by its index and needs no doorbell to find one, so an
+	 * answer that arrives between publishing and arming is an answer this
+	 * would otherwise throw away and then wait out.
+	 */
+	reinit_completion(&core->msg.done);
+
+	scoped_guard(spinlock_bh, &ring->lock) {
+		next = (ring->hlos_index + 1) & (NSS_RING_ENTRIES - 1);
+		if (next == READ_ONCE(map->h2n_nss_index[NSS_H2N_RING_COMMAND]))
+			return -EBUSY;
+
+		desc = &ring->desc[ring->hlos_index];
+		desc->interface_num = 0;
+		desc->buffer = core->msg.dma;
+		desc->buffer_len = NSS_MSG_BUF_SIZE;
+		desc->payload_offs = 0;
+		desc->payload_len = NSS_MSG_BUF_SIZE;
+		desc->mss = 0;
+		desc->qos_tag = 0;
+		desc->buffer_type = NSS_H2N_BUFFER_CTRL;
+		desc->bit_flags = NSS_H2N_FLAG_FIRST_SEGMENT |
+				  NSS_H2N_FLAG_LAST_SEGMENT;
+		desc->opaque = 0;
+
+		dma_wmb();
+		ring->hlos_index = next;
+		WRITE_ONCE(map->h2n_hlos_index[NSS_H2N_RING_COMMAND], next);
+	}
+
+	nss_doorbell(core, NSS_H2N_INTR_DATA_CMD);
+
+	if (!wait_for_completion_timeout(&core->msg.done, timeout)) {
+		dev_err(core->dev, "interface %u type %u: no answer in %u ms\n",
+			ncm->interface, ncm->type, NSS_MSG_TIMEOUT_MS);
+		core->msg.lost = true;
+		return -ETIMEDOUT;
+	}
+
+	ncm = core->msg.buf;
+	switch (ncm->response) {
+	case NSS_CMN_RESPONSE_ACK:
+	case NSS_CMN_RESPONSE_NOTIFY:	/* answered in the same buffer */
+		ret = 0;
+		break;
+	case NSS_CMN_RESPONSE_EMSG:
+		if (!quiet)
+			dev_err(core->dev, "interface %u type %u refused: %u\n",
+				ncm->interface, ncm->type, ncm->error);
+		ret = -EPROTO;
+		break;
+	default:
+		dev_err(core->dev, "interface %u type %u rejected: %u\n",
+			ncm->interface, ncm->type, ncm->response);
+		ret = -EPROTO;
+		break;
+	}
+
+	memcpy(msg, core->msg.buf, room);
+
+	return ret;
+}
+
+int nss_msg_transact(struct nss_core *core, void *msg, size_t len, size_t room)
+{
+	return nss_msg_xact(core, msg, len, room, false);
+}
+
+int nss_msg_send(struct nss_core *core, void *msg, size_t len)
+{
+	return nss_msg_xact(core, msg, len, len, false);
+}
+
+/* For a sender that judges the refusal itself. */
+int nss_msg_send_quiet(struct nss_core *core, void *msg, size_t len)
+{
+	return nss_msg_xact(core, msg, len, len, true);
+}
+
+/* Whether the firmware has a node of this kind to give, and what it calls it.
+ * A type it does not implement is refused at allocation, which is the cheapest
+ * way to find out before a design leans on one.
+ */
+static void nss_alloc_probe(struct nss_core *core, struct seq_file *s,
+			    enum nss_dynamic_interface_type type,
+			    const char *what)
+{
+	struct nss_dynamic_interface_msg m;
+	int if_num, ret;
+
+	memset(&m, 0, sizeof(m));
+	m.cm.interface = NSS_INTERFACE_DYNAMIC;
+	m.cm.type = NSS_DYNAMIC_INTERFACE_ALLOC_NODE;
+	m.msg.alloc_node.type = type;
+	ret = nss_msg_send(core, &m, sizeof(m));
+	if_num = m.msg.alloc_node.if_num;
+	seq_printf(s, "%-14s rc %d response %u error %u if_num %d\n",
+		   what, ret, m.cm.response, m.cm.error, if_num);
+	if (ret)
+		return;
+
+	memset(&m, 0, sizeof(m));
+	m.cm.interface = NSS_INTERFACE_DYNAMIC;
+	m.cm.type = NSS_DYNAMIC_INTERFACE_DEALLOC_NODE;
+	m.msg.dealloc_node.type = type;
+	m.msg.dealloc_node.if_num = if_num;
+	nss_msg_send(core, &m, sizeof(m));
+}
+
+/* Ask the firmware three questions whose answers can only come from it.
+ *
+ * A message layer with no consumer cannot be shown to work by reading it, and
+ * the first real consumer is a whole milestone away. These three are the
+ * smallest thing that distinguishes a working round trip from a plausible
+ * one: a rejection the firmware can only produce by parsing the header, an
+ * allocation whose answer is a number the host did not choose, and the
+ * release that puts it back.
+ */
+int nss_msg_probe(struct nss_core *core, struct seq_file *s)
+{
+	struct nss_dynamic_interface_msg m;
+	int if_num, ret;
+
+	memset(&m, 0, sizeof(m));
+	m.cm.interface = NSS_INTERFACE_DYNAMIC;
+	m.cm.type = NSS_DYNAMIC_INTERFACE_MAX;
+	ret = nss_msg_send(core, &m, sizeof(m));
+	seq_printf(s, "unknown type:  rc %d response %u error %u\n",
+		   ret, m.cm.response, m.cm.error);
+
+	memset(&m, 0, sizeof(m));
+	m.cm.interface = NSS_INTERFACE_DYNAMIC;
+	m.cm.type = NSS_DYNAMIC_INTERFACE_ALLOC_NODE;
+	m.msg.alloc_node.type = NSS_DYNAMIC_INTERFACE_TYPE_VLAN;
+	ret = nss_msg_send(core, &m, sizeof(m));
+	if_num = m.msg.alloc_node.if_num;
+	seq_printf(s, "alloc vlan:    rc %d response %u if_num %d\n",
+		   ret, m.cm.response, if_num);
+	if (ret)
+		return 0;
+
+	memset(&m, 0, sizeof(m));
+	m.cm.interface = NSS_INTERFACE_DYNAMIC;
+	m.cm.type = NSS_DYNAMIC_INTERFACE_DEALLOC_NODE;
+	m.msg.dealloc_node.type = NSS_DYNAMIC_INTERFACE_TYPE_VLAN;
+	m.msg.dealloc_node.if_num = if_num;
+	ret = nss_msg_send(core, &m, sizeof(m));
+	seq_printf(s, "dealloc %d:    rc %d response %u error %u\n",
+		   if_num, ret, m.cm.response, m.cm.error);
+
+	nss_alloc_probe(core, s, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_N2H,
+			"redir n2h");
+	nss_alloc_probe(core, s, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_H2N,
+			"redir h2n");
+
+	return nss_wifili_probe(core, s);
+}
+
+/* What the firmware sends unasked, by interface and type.
+ *
+ * A message the host does not recognise is indistinguishable from one that was
+ * never sent, and the two want opposite fixes. This counts every notification
+ * by where it came from, so the difference is a readout rather than a guess.
+ */
+#define NSS_MSG_CENSUS_MAX	24
+
+static struct {
+	u32 interface;
+	u32 type;
+	u32 count;
+} nss_msg_census_tbl[NSS_MSG_CENSUS_MAX];
+static DEFINE_SPINLOCK(nss_msg_census_lock);
+
+void nss_msg_census(const struct nss_cmn_msg *ncm)
+{
+	int i;
+
+	guard(spinlock_bh)(&nss_msg_census_lock);
+
+	for (i = 0; i < NSS_MSG_CENSUS_MAX; i++) {
+		if (nss_msg_census_tbl[i].count &&
+		    (nss_msg_census_tbl[i].interface != ncm->interface ||
+		     nss_msg_census_tbl[i].type != ncm->type))
+			continue;
+		nss_msg_census_tbl[i].interface = ncm->interface;
+		nss_msg_census_tbl[i].type = ncm->type;
+		nss_msg_census_tbl[i].count++;
+		return;
+	}
+}
+
+void nss_msg_census_print(struct seq_file *s)
+{
+	int i;
+
+	guard(spinlock_bh)(&nss_msg_census_lock);
+
+	for (i = 0; i < NSS_MSG_CENSUS_MAX; i++)
+		if (nss_msg_census_tbl[i].count)
+			seq_printf(s, "interface %u type %u n %u\n",
+				   nss_msg_census_tbl[i].interface,
+				   nss_msg_census_tbl[i].type,
+				   nss_msg_census_tbl[i].count);
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_phys.c b/package/kernel/nss-wifi-drv/src/nss_phys.c
new file mode 100644
index 0000000000..706335ad83
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_phys.c
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Handing a switch port to the firmware to route through.
+ *
+ * A running core already delivers everything arriving at the switch's CPU
+ * port, and until a port is opened the firmware forwards that straight to the
+ * host. That is what makes the exception path work, and it is also why no
+ * connection rule can ever match: the packet never reaches the engine the rule
+ * lives in. Opening a port points its receive at the firmware's own ethernet
+ * node instead, which is where the IPv4 and IPv6 engines are.
+ *
+ * Two things have to be said before the port is opened, because neither comes
+ * from the rule: the address, which appears as the source address of
+ * everything transmitted there, and the maximum frame size. The link state
+ * comes last, because a freshly opened interface starts with its link down and
+ * nothing transmits on it until the link is up.
+ *
+ * The port is never given a VSI of the firmware's own: the firmware transmits
+ * on a port by its number, and a VSI would have it create interfaces and
+ * router addresses in switch tables the switch driver allocates.
+ *
+ * The port set is whatever the switch topology has: the driver already holds
+ * one network device per user port, so a port is named by its index and the
+ * caller asks for a mask. Arming is a deliberate runtime act, like starting
+ * the core, and the host's own transmit path is untouched by it - the firmware
+ * gains a way to transmit on the port, it does not take the host's.
+ */
+
+#include <linux/bitops.h>
+#include <linux/cleanup.h>
+#include <linux/etherdevice.h>
+#include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/soc/qcom/qca_ppe.h>
+#include <net/dsa.h>
+
+#include "nss_drv.h"
+
+/* Where the firmware sends what a port receives once the port is open: its
+ * ethernet node, which is what feeds the connection engines.
+ */
+#define NSS_PHYS_RX_FORWARD	NSS_INTERFACE_ETH_RX
+
+int nss_phys_msg(struct nss_core *core, int if_num, u32 type,
+		 const void *body, size_t len)
+{
+	struct nss_if_msg *m __free(kfree) = kzalloc(sizeof(*m), GFP_KERNEL);
+	int ret;
+
+	if (!m)
+		return -ENOMEM;
+
+	m->cm.interface = if_num;
+	m->cm.type = type;
+	if (body)
+		memcpy(&m->msg, body, len);
+
+	ret = nss_msg_send(core, m, offsetof(struct nss_if_msg, msg) + len);
+	if (!ret && m->cm.error)
+		ret = -EIO;
+
+	return ret;
+}
+
+static void nss_phys_port_close(struct nss_core *core, int if_num,
+				struct net_device *dev)
+{
+	struct nss_if_link_state_notify link = {};
+
+	nss_phys_msg(core, if_num, NSS_IF_LINK_STATE_NOTIFY, &link,
+		     sizeof(link));
+	nss_phys_msg(core, if_num, NSS_IF_CLOSE, NULL, 0);
+
+	dev_info(core->dev, "%s: port %d back to the host\n",
+		 netdev_name(dev), if_num);
+}
+
+static int nss_phys_port_open(struct nss_core *core, int if_num,
+			      struct net_device *dev)
+{
+	struct nss_if_link_state_notify link = {
+		.state = netif_carrier_ok(dev),
+	};
+	struct nss_if_mac_address_set mac = {};
+	struct nss_if_mtu_change mtu = {};
+	struct nss_if_open open = {};
+	int ret;
+
+	ether_addr_copy(mac.mac_addr, dev->dev_addr);
+	ret = nss_phys_msg(core, if_num, NSS_IF_MAC_ADDR_SET, &mac, sizeof(mac));
+	if (ret)
+		goto err;
+
+	mtu.min_buf_size = dev->mtu;
+	ret = nss_phys_msg(core, if_num, NSS_IF_MTU_CHANGE, &mtu, sizeof(mtu));
+	if (ret)
+		goto err;
+
+	open.rx_forward_if = NSS_PHYS_RX_FORWARD;
+	open.alignment_mode = NSS_IF_DATA_ALIGN_2BYTE;
+	ret = nss_phys_msg(core, if_num, NSS_IF_OPEN, &open, sizeof(open));
+	if (ret)
+		goto err;
+
+	ret = nss_phys_msg(core, if_num, NSS_IF_LINK_STATE_NOTIFY, &link,
+			   sizeof(link));
+	if (ret)
+		goto err;
+
+	dev_info(core->dev, "%s: port %d routes in the firmware\n",
+		 netdev_name(dev), if_num);
+
+	return 0;
+
+err:
+	nss_phys_port_close(core, if_num, dev);
+	return ret;
+}
+
+/* Bring the set of firmware-routed ports to exactly @mask.
+ *
+ * A port already in the state the mask asks for is left alone rather than
+ * reopened: the firmware's view of a port changes only when it is changed,
+ * and restating it costs a round trip and gains nothing.
+ */
+int nss_phys_arm(struct nss_core *core, unsigned long mask)
+{
+	unsigned long armed = core->phys_armed;
+	unsigned long changed;
+	int ret = 0;
+	unsigned int i;
+
+	if (!core->running)
+		return -ENODEV;
+
+	/* The port's address and MTU go to the firmware, and their writers
+	 * hold rtnl.
+	 */
+	ASSERT_RTNL();
+
+	/* Only what the mask changes, and only as far as a mask reaches: a
+	 * port index beyond the width of one is not addressable and shifting
+	 * by it does not mean what it looks like.
+	 */
+	changed = mask ^ armed;
+	for_each_set_bit(i, &changed, BITS_PER_LONG) {
+		bool want = mask & BIT(i);
+		struct net_device *dev;
+
+		dev = rcu_dereference_protected(core->iface[i],
+						lockdep_is_held(&core->lock));
+		if (!dev || !dsa_user_dev_check(dev)) {
+			if (want)
+				ret = -ENODEV;
+			continue;
+		}
+
+		if (want) {
+			int err = nss_phys_port_open(core, i, dev);
+
+			if (err) {
+				dev_warn(core->dev, "%s: port %d not armed: %d\n",
+					 netdev_name(dev), i, err);
+				ret = err;
+				continue;
+			}
+			core->phys_armed |= BIT(i);
+		} else {
+			nss_phys_port_close(core, i, dev);
+			core->phys_armed &= ~BIT(i);
+		}
+	}
+
+	/* The firmware sizes every port's frames its own way on each change. */
+	if (changed)
+		qca_ppe_fw_ports_set(core->conduit);
+
+	return ret;
+}
+
+/* Tell the firmware what changed on an armed port since it was opened. */
+void nss_phys_event(struct nss_core *core, unsigned long event,
+		    struct net_device *dev)
+{
+	struct nss_if_link_state_notify link = {};
+	struct nss_if_mac_address_set mac = {};
+	struct nss_if_mtu_change mtu = {};
+	unsigned int i;
+
+	if ((event != NETDEV_CHANGEMTU && event != NETDEV_CHANGEADDR &&
+	     event != NETDEV_CHANGE) || !dsa_user_dev_check(dev))
+		return;
+
+	guard(mutex)(&core->lock);
+
+	for_each_set_bit(i, &core->phys_armed, BITS_PER_LONG)
+		if (rcu_access_pointer(core->iface[i]) == dev)
+			break;
+	if (i >= BITS_PER_LONG)
+		return;
+
+	switch (event) {
+	case NETDEV_CHANGEMTU:
+		mtu.min_buf_size = dev->mtu;
+		nss_phys_msg(core, i, NSS_IF_MTU_CHANGE, &mtu, sizeof(mtu));
+		break;
+	case NETDEV_CHANGEADDR:
+		ether_addr_copy(mac.mac_addr, dev->dev_addr);
+		nss_phys_msg(core, i, NSS_IF_MAC_ADDR_SET, &mac, sizeof(mac));
+		break;
+	case NETDEV_CHANGE:
+		link.state = netif_carrier_ok(dev);
+		nss_phys_msg(core, i, NSS_IF_LINK_STATE_NOTIFY, &link,
+			     sizeof(link));
+		break;
+	}
+	qca_ppe_fw_ports_set(core->conduit);
+}
+
+/* A flow is pushed only between interfaces the firmware owns, so every switch
+ * port is handed over unless the mask leaves it out.
+ */
+static unsigned long nss_phys_allowed = ~0UL;
+module_param_named(arm_ports, nss_phys_allowed, ulong, 0644);
+MODULE_PARM_DESC(arm_ports, "switch ports, by DSA index, handed to the firmware");
+
+/* Arm every port on a running core. */
+void nss_phys_arm_ports(struct nss_core *core)
+{
+	unsigned long mask = 0;
+	unsigned int i;
+
+	rtnl_lock();
+	mutex_lock(&core->lock);
+	if (core->running) {
+		for (i = 0; i < BITS_PER_LONG && i < NSS_INTERFACE_MAX; i++) {
+			struct net_device *dev;
+
+			dev = rcu_dereference_protected(core->iface[i],
+							lockdep_is_held(&core->lock));
+			if (dev && dsa_user_dev_check(dev))
+				mask |= BIT(i);
+		}
+		nss_phys_arm(core, mask & nss_phys_allowed);
+	}
+	nss_redir_arm(core);
+	mutex_unlock(&core->lock);
+	rtnl_unlock();
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_redir.c b/package/kernel/nss-wifi-drv/src/nss_redir.c
new file mode 100644
index 0000000000..229afaed46
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_redir.c
@@ -0,0 +1,688 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Carrying the connections of devices the firmware has no interface for.
+ *
+ * A modem's raw-IP device has no switch port behind it, and a radio whose
+ * rings the firmware does not reap - a PCIe ath10k beside the SoC's own
+ * radios - hands every frame to the host. The firmware reaches such a device
+ * through a generic redirect node pair: what the host hands to one
+ * node is routed as if it had arrived on the device, and what the firmware
+ * routes to the other comes back to be sent there. Core 0 refuses the
+ * rmnet_rx node type, which exists only in core 1's image; the redirect pair
+ * has the same shape.
+ *
+ * Packets cross the pair framed as Ethernet. One the firmware does not route
+ * comes back still framed and goes up the stack; nothing the modem sends or
+ * receives carries the frame, and a radio's frames are Ethernet already.
+ *
+ * Only a packet as the device received it fits one firmware buffer, so a
+ * radio's GRO is off while a core carries the device: coalesced, a station's
+ * upload would never reach the firmware.
+ *
+ * A core that restarts loses its nodes, so the pair is made wherever a
+ * running core meets a device that is up: when the device comes up and when
+ * the core arms its ports.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/if_vlan.h>
+#include <linux/ipv6.h>
+#include <linux/netdevice.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_netdev.h>
+#include <linux/rtnetlink.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/tcp.h>
+#include <net/ip.h>
+#include <net/ipv6.h>
+
+#include "nss_drv.h"
+
+/* ponytail: a modem has one device per multiplexed channel and a router uses
+ * one or two; a radio has one per network it serves.
+ */
+#define NSS_REDIR_MAX	8
+
+/* The source address of the frame around a modem's packet; the modem driver
+ * uses it for its own Ethernet mode.
+ */
+static const u8 nss_redir_peer[ETH_ALEN] = { 0x02, 0x50, 0xf3, 0x00, 0x00, 0x00 };
+
+struct nss_redir {
+	struct net_device *dev;	/* NULL: slot free */
+	int ifindex;
+	int n2h;		/* -1 until a running core gives the pair */
+	int h2n;
+	struct nf_hook_ops ops;	/* ahead of the flow table on the device */
+	bool eth;		/* frames are Ethernet, not bare IP */
+	bool gro;		/* GRO turned off here */
+	u64 inject;
+	u64 inject_fail;
+	u64 back;		/* came back unrouted, delivered up */
+	u64 xmit;		/* routed to the device by the firmware */
+	u64 drop;
+};
+
+/* Written under the RTNL, read from the receive paths. */
+static struct nss_redir nss_redir_tbl[NSS_REDIR_MAX];
+static struct nss_core *nss_redir_core;
+
+/* Set while a packet the firmware gave back goes up the stack, so it is not
+ * handed down again. The delivery stays on this CPU.
+ */
+static DEFINE_PER_CPU(bool, nss_redir_reinject);
+
+static bool nss_redir_enable = true;
+module_param_named(redir, nss_redir_enable, bool, 0644);
+MODULE_PARM_DESC(redir, "carry raw-IP (cellular) devices and radios the firmware does not drive; read when a device comes up");
+
+static bool nss_redir_wanted(const struct net_device *dev)
+{
+	if (dev->addr_len != ETH_ALEN)
+		return false;
+
+	return dev->type == ARPHRD_RAWIP ||
+	       (dev->type == ARPHRD_ETHER && dev->ieee80211_ptr &&
+		!nss_wifili_owns(dev));
+}
+
+static struct nss_redir *nss_redir_find(const struct net_device *dev)
+{
+	int i;
+
+	for (i = 0; i < NSS_REDIR_MAX; i++)
+		if (nss_redir_tbl[i].dev == dev)
+			return &nss_redir_tbl[i];
+
+	return NULL;
+}
+
+/* Whether the firmware can route to @ifindex. */
+bool nss_redir_bound(int ifindex)
+{
+	int i;
+
+	for (i = 0; i < NSS_REDIR_MAX; i++)
+		if (READ_ONCE(nss_redir_tbl[i].ifindex) == ifindex &&
+		    READ_ONCE(nss_redir_tbl[i].n2h) >= 0)
+			return true;
+
+	return false;
+}
+
+static int nss_redir_config(struct nss_core *core, int if_num, int sibling,
+			    int nexthop, const u8 *mac)
+{
+	struct nss_virt_if_config_msg c = {};
+
+	c.sibling = sibling;
+	c.nexthop = nexthop;
+	ether_addr_copy(c.mac_addr, mac);
+
+	return nss_phys_msg(core, if_num, NSS_VIRT_IF_TX_CONFIG_MSG, &c,
+			    sizeof(c));
+}
+
+/* The host-to-firmware node feeds the Ethernet node, where the connection
+ * engines are; the other hands what the firmware routes there to the host.
+ */
+static int nss_redir_pair(struct nss_core *core, struct nss_redir *r)
+{
+	int n2h, h2n, ret;
+
+	n2h = nss_flow_dyn_alloc(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_N2H);
+	if (n2h < 0)
+		return n2h;
+
+	h2n = nss_flow_dyn_alloc(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_H2N);
+	if (h2n < 0) {
+		ret = h2n;
+		goto n2h;
+	}
+
+	ret = nss_redir_config(core, n2h, h2n, NSS_INTERFACE_N2H,
+			       r->dev->dev_addr);
+	if (ret)
+		goto h2n;
+	ret = nss_redir_config(core, h2n, n2h, NSS_INTERFACE_ETH_RX,
+			       r->dev->dev_addr);
+	if (ret)
+		goto h2n;
+
+	/* The flow back end names the device by the node sending to it. */
+	dev_hold(r->dev);
+	rcu_assign_pointer(core->iface[n2h], r->dev);
+	WRITE_ONCE(r->h2n, h2n);
+	WRITE_ONCE(r->n2h, n2h);
+
+	netdev_info(r->dev, "routed by NSS core %u, nodes %d/%d\n", core->id,
+		    n2h, h2n);
+
+	return 0;
+
+h2n:
+	nss_flow_dyn_free(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_H2N, h2n);
+n2h:
+	nss_flow_dyn_free(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_N2H, n2h);
+	netdev_warn(r->dev, "no NSS node pair: %d\n", ret);
+
+	return ret;
+}
+
+static void nss_redir_unpair(struct nss_core *core, struct nss_redir *r)
+{
+	int n2h = r->n2h, h2n = r->h2n;
+	struct net_device *dev;
+
+	if (n2h < 0)
+		return;
+
+	/* Out of every lookup before the rules towards the node go, so that
+	 * none is made meanwhile; a later node may get the same number.
+	 */
+	WRITE_ONCE(r->n2h, -1);
+	WRITE_ONCE(r->h2n, -1);
+
+	dev = rcu_replace_pointer(core->iface[n2h], NULL,
+				  lockdep_is_held(&core->lock));
+	synchronize_net();
+	if (dev)
+		dev_put(dev);
+
+	nss_flow_withdraw_dev(r->dev);
+
+	if (core->running) {
+		nss_flow_dyn_free(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_H2N,
+				  h2n);
+		nss_flow_dyn_free(core, NSS_DYNAMIC_INTERFACE_TYPE_GENERIC_REDIR_N2H,
+				  n2h);
+	}
+}
+
+/* Unicast, unfragmented TCP or UDP. A TCP segment that opens or closes a
+ * connection stays with the host: no rule waits for the first, and conntrack
+ * must see the second.
+ */
+static bool nss_redir_routable(struct sk_buff *skb, __be16 proto)
+{
+	unsigned int thoff;
+	u8 l4;
+
+	if (proto == htons(ETH_P_IP)) {
+		const struct iphdr *iph;
+
+		if (!pskb_may_pull(skb, sizeof(*iph)))
+			return false;
+		iph = ip_hdr(skb);
+		if (iph->ihl != 5 || ip_is_fragment(iph) ||
+		    ipv4_is_multicast(iph->daddr) || ipv4_is_lbcast(iph->daddr))
+			return false;
+		l4 = iph->protocol;
+		thoff = sizeof(*iph);
+	} else {
+		const struct ipv6hdr *ip6h;
+
+		if (!pskb_may_pull(skb, sizeof(*ip6h)))
+			return false;
+		ip6h = ipv6_hdr(skb);
+		if (ipv6_addr_is_multicast(&ip6h->daddr))
+			return false;
+		l4 = ip6h->nexthdr;
+		thoff = sizeof(*ip6h);
+	}
+
+	if (l4 == IPPROTO_UDP)
+		return true;
+	if (l4 != IPPROTO_TCP || !pskb_may_pull(skb, thoff + sizeof(struct tcphdr)))
+		return false;
+
+	skb_set_transport_header(skb, thoff);
+
+	return !(tcp_hdr(skb)->syn || tcp_hdr(skb)->fin || tcp_hdr(skb)->rst);
+}
+
+static __be16 nss_redir_proto(const struct sk_buff *skb, unsigned int off)
+{
+	if (skb->len <= off)
+		return 0;
+
+	switch (skb->data[off] & 0xf0) {
+	case 0x40:
+		return htons(ETH_P_IP);
+	case 0x60:
+		return htons(ETH_P_IPV6);
+	default:
+		return 0;
+	}
+}
+
+/* Hand a packet from the device to the firmware. False leaves it with the
+ * host; @skb must not be shared.
+ */
+static bool nss_redir_inject(struct nss_redir *r, struct sk_buff *skb)
+{
+	struct nss_core *core = READ_ONCE(nss_redir_core);
+	int h2n = READ_ONCE(r->h2n);
+	struct ethhdr *eth;
+	__be16 proto;
+
+	if (!core || h2n < 0 || !READ_ONCE(core->running))
+		return false;
+
+	if (r->eth) {
+		/* The device's own header and nothing between it and IP. */
+		if (skb->pkt_type != PACKET_HOST &&
+		    skb->pkt_type != PACKET_OTHERHOST)
+			return false;
+		if (skb_vlan_tag_present(skb) || skb->mac_len != ETH_HLEN)
+			return false;
+		proto = skb->protocol;
+		if (proto != htons(ETH_P_IP) && proto != htons(ETH_P_IPV6))
+			return false;
+	} else {
+		if (!pskb_may_pull(skb, 1))
+			return false;
+		proto = nss_redir_proto(skb, 0);
+		if (!proto)
+			return false;
+	}
+	if (skb->len > skb->dev->mtu)
+		return false;
+
+	skb_reset_network_header(skb);
+	if (!nss_redir_routable(skb, proto))
+		return false;
+
+	/* Four more than the frame, for the word alignment the send may need. */
+	if (skb_cow_head(skb, ETH_HLEN + 4)) {
+		r->inject_fail++;
+		return false;
+	}
+
+	eth = skb_push(skb, ETH_HLEN);
+	if (!r->eth) {
+		ether_addr_copy(eth->h_dest, skb->dev->dev_addr);
+		ether_addr_copy(eth->h_source, nss_redir_peer);
+		eth->h_proto = proto;
+	}
+
+	if (nss_data_send(core, skb, h2n, NSS_H2N_FLAG_VIRTUAL_BUFFER)) {
+		/* The send may have moved the data to a word boundary. */
+		skb_reset_mac_header(skb);
+		skb_pull(skb, ETH_HLEN);
+		skb_reset_network_header(skb);
+		if (!r->eth)
+			skb_reset_mac_header(skb);
+		r->inject_fail++;
+		return false;
+	}
+
+	r->inject++;
+
+	return true;
+}
+
+/* Ahead of the flow table's hook, which would otherwise forward an
+ * offloaded connection's packets before the receive handler saw them.
+ */
+static unsigned int nss_redir_hook(void *priv, struct sk_buff *skb,
+				   const struct nf_hook_state *state)
+{
+	if (__this_cpu_read(nss_redir_reinject) || skb_shared(skb))
+		return NF_ACCEPT;
+
+	return nss_redir_inject(priv, skb) ? NF_STOLEN : NF_ACCEPT;
+}
+
+/* A packet an ingress shaper redirected and gives back skips the hooks. */
+static rx_handler_result_t nss_redir_rx(struct sk_buff **pskb)
+{
+	struct sk_buff *skb = *pskb;
+
+	if (__this_cpu_read(nss_redir_reinject) ||
+	    skb->pkt_type == PACKET_LOOPBACK)
+		return RX_HANDLER_PASS;
+
+	skb = skb_share_check(skb, GFP_ATOMIC);
+	if (!skb)
+		return RX_HANDLER_CONSUMED;
+	*pskb = skb;
+
+	if (!nss_redir_inject(rcu_dereference(skb->dev->rx_handler_data), skb))
+		return RX_HANDLER_PASS;
+
+	return RX_HANDLER_CONSUMED;
+}
+
+static struct nss_redir *nss_redir_of_node(u32 if_num)
+{
+	int i;
+
+	for (i = 0; i < NSS_REDIR_MAX; i++)
+		if (READ_ONCE(nss_redir_tbl[i].n2h) == (int)if_num ||
+		    READ_ONCE(nss_redir_tbl[i].h2n) == (int)if_num)
+			return &nss_redir_tbl[i];
+
+	return NULL;
+}
+
+/* A packet the firmware did not route, to go up the stack, or one it routed
+ * to the device, to be sent there. Either may be in a lent buffer or in one
+ * the host sent; the descriptor says where the packet is.
+ */
+bool nss_redir_recv(struct nss_core *core, const struct n2h_descriptor *desc,
+		    struct sk_buff *skb)
+{
+	bool tx = NSS_SKB_CB(skb)->tx;
+	u32 end = (u32)desc->payload_offs + desc->payload_len;
+	struct net_device *dev;
+	struct nss_redir *r;
+	__be16 proto;
+	u32 size;
+	int n2h;
+
+	if (desc->buffer_type != NSS_N2H_BUFFER_PACKET &&
+	    desc->buffer_type != NSS_N2H_BUFFER_PACKET_VIRTUAL)
+		return false;
+
+	if (tx && !NSS_SKB_CB(skb)->bidir)
+		return false;
+
+	r = nss_redir_of_node(desc->interface_num);
+	if (!r)
+		return false;
+
+	guard(rcu)();
+
+	if (tx) {
+		size = skb_end_pointer(skb) - skb->head;
+		dma_unmap_single(core->dev, NSS_SKB_CB(skb)->dma, size,
+				 DMA_BIDIRECTIONAL);
+	} else {
+		size = NSS_EMPTY_BUFFER_ALLOC;
+		dma_unmap_single(core->dev, desc->buffer, size, DMA_FROM_DEVICE);
+	}
+
+	n2h = READ_ONCE(r->n2h);
+	if (n2h < 0)
+		goto drop;
+	dev = rcu_dereference(core->iface[n2h]);
+	if (!dev || end > size || skb_is_nonlinear(skb))
+		goto drop;
+
+	skb->data = skb->head + desc->payload_offs;
+	skb->len = desc->payload_len;
+	skb_set_tail_pointer(skb, skb->len);
+
+	/* A modem's packet that comes back bare is taken as it is; a radio's
+	 * frame keeps its header.
+	 */
+	proto = nss_redir_proto(skb, ETH_HLEN);
+	if (proto && ((struct ethhdr *)skb->data)->h_proto != proto)
+		proto = 0;
+	if (r->eth) {
+		if (!proto)
+			goto drop;
+	} else if (proto) {
+		skb_pull(skb, ETH_HLEN);
+	} else {
+		proto = nss_redir_proto(skb, 0);
+		if (!proto)
+			goto drop;
+	}
+
+	memset(skb->cb, 0, sizeof(skb->cb));
+	skb->dev = dev;
+	skb->protocol = proto;
+	skb->ip_summed = CHECKSUM_NONE;
+	skb_reset_mac_header(skb);
+	skb->mac_len = r->eth ? ETH_HLEN : 0;
+	/* Where the radio's queue selection reads the DSCP from. */
+	skb_set_network_header(skb, skb->mac_len);
+
+	if (desc->buffer_type == NSS_N2H_BUFFER_PACKET_VIRTUAL) {
+		r->xmit++;
+		dev_queue_xmit(skb);
+		return true;
+	}
+
+	/* State attached before the packet went down would make conntrack
+	 * take it for one it has seen.
+	 */
+	nf_reset_ct(skb);
+	skb_dst_drop(skb);
+	if (r->eth) {
+		skb->protocol = eth_type_trans(skb, dev);
+		skb_reset_network_header(skb);
+	} else {
+		skb->pkt_type = PACKET_HOST;
+	}
+
+	skb->skb_iif = dev->ifindex;
+
+	r->back++;
+	__this_cpu_write(nss_redir_reinject, true);
+	/* The flow table's hook runs again, so a reply passing it lets it
+	 * offload that direction too. An ingress shaper saw the packet
+	 * already and is skipped.
+	 */
+	if (nf_hook_ingress(skb) >= 0) {
+		skb->tc_skip_classify = 1;
+		netif_receive_skb_core(skb);
+	}
+	__this_cpu_write(nss_redir_reinject, false);
+
+	return true;
+
+drop:
+	r->drop++;
+	dev_kfree_skb_any(skb);
+
+	return true;
+}
+
+/* Under the RTNL, and under the core's lock when there is one. */
+static void nss_redir_add(struct nss_core *core, struct net_device *dev)
+{
+	struct nss_redir *r;
+	int i;
+
+	if (!nss_redir_enable || !nss_redir_wanted(dev))
+		return;
+
+	r = nss_redir_find(dev);
+	if (!r) {
+		for (i = 0; i < NSS_REDIR_MAX && !r; i++)
+			if (!nss_redir_tbl[i].dev)
+				r = &nss_redir_tbl[i];
+		if (!r) {
+			netdev_warn(dev, "no room for another redirected device\n");
+			return;
+		}
+
+		*r = (struct nss_redir){ .dev = dev, .n2h = -1, .h2n = -1,
+					 .eth = dev->type == ARPHRD_ETHER };
+		/* A radio's device is usually a bridge port, and the receive
+		 * handler is the bridge's; the ingress hook alone takes its
+		 * packets.
+		 */
+		if (!r->eth && netdev_rx_handler_register(dev, nss_redir_rx, r)) {
+			netdev_warn(dev, "has a receive handler already\n");
+			*r = (struct nss_redir){ .n2h = -1, .h2n = -1 };
+			return;
+		}
+		WRITE_ONCE(r->ifindex, dev->ifindex);
+
+		r->ops = (struct nf_hook_ops){
+			.hook = nss_redir_hook,
+			.pf = NFPROTO_NETDEV,
+			.hooknum = NF_NETDEV_INGRESS,
+			.priority = INT_MIN + 1,
+			.dev = dev,
+			.priv = r,
+		};
+		if (nf_register_net_hook(dev_net(dev), &r->ops)) {
+			if (!r->eth)
+				netdev_rx_handler_unregister(dev);
+			*r = (struct nss_redir){ .n2h = -1, .h2n = -1 };
+			return;
+		}
+	}
+
+	if (!core)
+		return;
+
+	if (r->eth && !r->gro && (dev->wanted_features & NETIF_F_GRO)) {
+		dev->wanted_features &= ~NETIF_F_GRO;
+		netdev_update_features(dev);
+		r->gro = true;
+	}
+
+	if (core->running && r->n2h < 0)
+		nss_redir_pair(core, r);
+}
+
+static void nss_redir_del(struct nss_core *core, struct net_device *dev)
+{
+	struct nss_redir *r = nss_redir_find(dev);
+
+	if (!r)
+		return;
+
+	nf_unregister_net_hook(dev_net(dev), &r->ops);
+	if (core)
+		nss_redir_unpair(core, r);
+	if (r->gro) {
+		dev->wanted_features |= NETIF_F_GRO;
+		netdev_update_features(dev);
+	}
+	if (!r->eth)
+		netdev_rx_handler_unregister(dev);
+	WRITE_ONCE(r->ifindex, 0);
+	WRITE_ONCE(r->n2h, -1);
+	WRITE_ONCE(r->h2n, -1);
+	r->dev = NULL;
+}
+
+/* The core the devices are paired on, which is the one the flow rules go
+ * to. Neither the notifier nor the receive handler reaches a core after it
+ * is unbound.
+ */
+void nss_redir_bind(struct nss_core *core)
+{
+	rtnl_lock();
+	WRITE_ONCE(nss_redir_core, core);
+	rtnl_unlock();
+	synchronize_net();
+}
+
+/* Under the RTNL and the core's lock, as the arming is. */
+void nss_redir_arm(struct nss_core *core)
+{
+	struct net_device *dev;
+
+	ASSERT_RTNL();
+
+	if (core != nss_redir_core || !core->running)
+		return;
+
+	for_each_netdev(&init_net, dev)
+		if (dev->flags & IFF_UP)
+			nss_redir_add(core, dev);
+}
+
+/* The nodes go with the core; the halt empties its interface table. */
+void nss_redir_halt(struct nss_core *core)
+{
+	int i;
+
+	if (READ_ONCE(nss_redir_core) != core)
+		return;
+
+	for (i = 0; i < NSS_REDIR_MAX; i++) {
+		WRITE_ONCE(nss_redir_tbl[i].h2n, -1);
+		WRITE_ONCE(nss_redir_tbl[i].n2h, -1);
+	}
+}
+
+static int nss_redir_event(struct notifier_block *nb, unsigned long event,
+			   void *ptr)
+{
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	struct nss_core *core = READ_ONCE(nss_redir_core);
+
+	if (core)
+		nss_phys_event(core, event, dev);
+
+	switch (event) {
+	case NETDEV_UP:
+		if (!nss_redir_wanted(dev))
+			break;
+		if (core) {
+			guard(mutex)(&core->lock);
+			nss_redir_add(core, dev);
+		} else {
+			nss_redir_add(NULL, dev);
+		}
+		break;
+	case NETDEV_GOING_DOWN:
+	case NETDEV_UNREGISTER:
+		/* Gone from the table by its slot, not by what it is now. */
+		if (!nss_redir_find(dev))
+			break;
+		if (core) {
+			guard(mutex)(&core->lock);
+			nss_redir_del(core, dev);
+		} else {
+			nss_redir_del(NULL, dev);
+		}
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nss_redir_nb = {
+	.notifier_call = nss_redir_event,
+};
+
+void nss_redir_print(struct seq_file *s)
+{
+	int i;
+
+	seq_printf(s, "enabled %d\n", nss_redir_enable);
+
+	rtnl_lock();
+	for (i = 0; i < NSS_REDIR_MAX; i++) {
+		const struct nss_redir *r = &nss_redir_tbl[i];
+
+		if (!r->dev)
+			continue;
+		seq_printf(s, "%s ifindex %d nodes %d/%d inject %llu inject-fail %llu back %llu xmit %llu drop %llu\n",
+			   netdev_name(r->dev), r->ifindex, r->n2h, r->h2n,
+			   r->inject, r->inject_fail, r->back, r->xmit,
+			   r->drop);
+	}
+	rtnl_unlock();
+}
+
+int nss_redir_init(void)
+{
+	int i;
+
+	/* A free slot must not match node 0. */
+	for (i = 0; i < NSS_REDIR_MAX; i++)
+		nss_redir_tbl[i] = (struct nss_redir){ .n2h = -1, .h2n = -1 };
+
+	return register_netdevice_notifier(&nss_redir_nb);
+}
+
+/* After the cores are gone. Unregistering replays every device's going-down
+ * and unregister events, which give back each slot.
+ */
+void nss_redir_exit(void)
+{
+	unregister_netdevice_notifier(&nss_redir_nb);
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_ring.c b/package/kernel/nss-wifi-drv/src/nss_ring.c
new file mode 100644
index 0000000000..4e3d941982
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_ring.c
@@ -0,0 +1,993 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The message and data rings between the host and a running core.
+ *
+ * The rings live in coherent memory, so the indices each side publishes are
+ * visible to the other without maintenance of our own. Each of the ten
+ * interrupt causes is its own line - this SoC has no mask or status register
+ * for them - so a cause is fixed when its line is claimed and never has to be
+ * decoded.
+ *
+ * A running core's first act is to ask for buffers, because it has none. That
+ * request is also how the host learns it is up: there is no ready message in
+ * this protocol.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/interrupt.h>
+#include <linux/of_irq.h>
+#include <linux/etherdevice.h>
+#include <net/dsa.h>
+#include <linux/platform_device.h>
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+
+#include "nss_drv.h"
+
+#define NSS_NAPI_WEIGHT		64
+#define NSS_REFILL_BATCH	64
+
+void nss_doorbell(struct nss_core *core, u32 which)
+{
+	writel(BIT(NSS_H2N_INTR_BASE(core->id) + which),
+	       core->qgic + NSS_QGIC_IPC_REG);
+}
+
+/* Give the firmware's interface numbers something to deliver to.
+ *
+ * A frame the firmware exceptions carries the number of the interface it came
+ * in on, and for a switch port that number is the port's own index - measured
+ * on this SoC, and derived here rather than written down, because the port set
+ * is a property of the board. Everything above a switch port gets its number
+ * when it is created, and registers itself.
+ */
+void nss_iface_bind(struct nss_core *core)
+{
+	struct net_device *dev;
+
+	/* RCU, not rtnl: this runs under core->lock, which rtnl holders take. */
+	rcu_read_lock();
+	for_each_netdev_rcu(&init_net, dev) {
+		struct dsa_port *dp;
+
+		if (!dsa_user_dev_check(dev))
+			continue;
+
+		dp = dsa_port_from_netdev(dev);
+		if (IS_ERR(dp) || dp->index >= NSS_INTERFACE_MAX)
+			continue;
+
+		if (dsa_port_to_conduit(dp) != core->conduit)
+			continue;
+
+		dev_hold(dev);
+		rcu_assign_pointer(core->iface[dp->index], dev);
+	}
+	rcu_read_unlock();
+}
+
+void nss_iface_unbind(struct nss_core *core)
+{
+	int i;
+
+	for (i = 0; i < NSS_INTERFACE_MAX; i++) {
+		struct net_device *dev;
+
+		dev = rcu_replace_pointer(core->iface[i], NULL, true);
+		if (dev)
+			dev_put(dev);
+	}
+
+	synchronize_rcu();
+}
+
+/* Keep the first few buffers the firmware hands up that are neither an
+ * ordinary frame nor a message. One of them is how a receive descriptor the
+ * host must give back arrives, and its shape on the running firmware is not
+ * derivable from anything the host has.
+ */
+static void nss_ext_take(struct nss_core *core, const struct n2h_descriptor *desc,
+			 struct sk_buff *skb)
+{
+	struct nss_ext_seen *e;
+	u32 i;
+
+	if (core->ext_seen >= ARRAY_SIZE(core->ext))
+		return;
+
+	if (desc->buffer_type == NSS_N2H_BUFFER_STATUS ||
+	    (u32)desc->payload_offs + desc->payload_len > NSS_EMPTY_BUFFER_ALLOC)
+		return;
+
+	e = &core->ext[core->ext_seen++];
+	e->iface = desc->interface_num;
+	e->type = desc->buffer_type;
+	e->len = desc->payload_len;
+	e->offs = desc->payload_offs;
+	for (i = 0; i < ARRAY_SIZE(e->word) && i * sizeof(u32) < e->len; i++)
+		e->word[i] = ((const u32 *)(skb->head + desc->payload_offs))[i];
+}
+
+/* Hand up a frame the firmware exceptioned.
+ *
+ * The offset and length come from the other side, so they are checked against
+ * the allocation the host made rather than believed: the buffer is the one
+ * this driver donated, and nothing the firmware writes into the descriptor can
+ * make it larger.
+ */
+static bool nss_data_recv(struct nss_core *core, struct napi_struct *napi,
+			  const struct n2h_descriptor *desc,
+			  struct sk_buff *skb)
+{
+	u32 end = (u32)desc->payload_offs + desc->payload_len;
+	struct net_device *dev;
+
+	if (desc->buffer_type != NSS_N2H_BUFFER_PACKET ||
+	    desc->interface_num >= NSS_INTERFACE_MAX)
+		return false;
+
+	dev = rcu_dereference_bh(core->iface[desc->interface_num]);
+	if (!dev || end > NSS_EMPTY_BUFFER_ALLOC || desc->payload_len < ETH_HLEN)
+		return false;
+
+	/* The unmap uses the descriptor's own address, never one cached in the
+	 * buffer: a stale cookie then delivers a wrong frame rather than
+	 * invalidating a wild range from softirq.
+	 */
+	dma_unmap_single(core->dev, desc->buffer,
+			 NSS_EMPTY_BUFFER_ALLOC, DMA_FROM_DEVICE);
+
+	skb_reserve(skb, desc->payload_offs);
+	skb_put(skb, desc->payload_len);
+	if (nss_wifili_rx_80211(desc->interface_num, dev, skb, napi))
+		return true;
+
+	skb->protocol = eth_type_trans(skb, dev);
+	if (skb->pkt_type == PACKET_MULTICAST)
+		nss_wifili_me_snoop(desc->interface_num, skb);
+
+	dev_sw_netstats_rx_add(dev, desc->payload_len);
+	napi_gro_receive(napi, skb);
+
+	return true;
+}
+
+/* Hand on a message the firmware sent unasked.
+ *
+ * Nothing the host sent is outstanding, so this is never a completion and the
+ * sixteen header bytes reserved for the host hold whatever the buffer's last
+ * user left there. The descriptor's interface number is zero on every message
+ * buffer, so the dispatch is on the interface inside the payload, whose top
+ * byte is a core id. The buffer is already unmapped, so the payload is the
+ * host's to read.
+ */
+static void nss_notify_recv(struct nss_core *core,
+			    const struct n2h_descriptor *desc,
+			    struct sk_buff *skb)
+{
+	u32 end = (u32)desc->payload_offs + desc->payload_len;
+	const struct nss_cmn_msg *ncm;
+
+	if (desc->buffer_type != NSS_N2H_BUFFER_STATUS ||
+	    end > NSS_EMPTY_BUFFER_ALLOC || desc->payload_len < sizeof(*ncm))
+		return;
+
+	core->notify++;
+
+	ncm = (const void *)(skb->head + desc->payload_offs);
+	nss_msg_seen(core, ncm, desc->payload_len);
+	nss_msg_census(ncm);
+	nss_flow_notify(ncm, desc->payload_len);
+
+	if (nss_wifili_is_soc(ncm->interface))
+		nss_wifili_notify(core, ncm, desc->payload_len);
+	else if (!nss_mesh_notify(core, ncm, desc->payload_len))
+		nss_wifili_vdev_notify(core, ncm, desc->payload_len);
+}
+
+/* Whether the firmware may keep the buffer a frame arrives in. A kept buffer
+ * counts against the firmware's high-water mark, which this driver holds
+ * equal to what it lends, and it comes back later under the same cookie
+ * carrying a received frame, which the completion path below frees unread.
+ */
+static bool nss_tx_reusable;
+module_param_named(tx_reusable, nss_tx_reusable, bool, 0644);
+MODULE_PARM_DESC(tx_reusable, "offer the firmware the buffer a frame arrives in");
+
+static int nss_lent_take(struct nss_core *core, struct sk_buff *skb);
+static void nss_lent_put(struct nss_core *core, u32 slot);
+
+static enum dma_data_direction nss_tx_dir(const struct sk_buff *skb)
+{
+	return NSS_SKB_CB(skb)->bidir ? DMA_BIDIRECTIONAL : DMA_TO_DEVICE;
+}
+
+/* Hand a frame down to the firmware to place.
+ *
+ * The same descriptor the message layer fills, on the data queue rather than
+ * the command one, with the interface the firmware is to send it out of. The
+ * buffer is the host's until the firmware gives it back on a receive ring
+ * carrying the address handed out here, so it is marked to say which of the
+ * two kinds of buffer it is: a donated one is replaced when it returns, a
+ * transmitted one is freed, unless it carries a packet the firmware gave
+ * back to the host.
+ *
+ * One descriptor, so one segment: a frame arriving in pieces is linearised
+ * rather than described piecewise, because nothing here yet has a reason to
+ * chain them and a chain the firmware reads wrongly is a fault rather than a
+ * dropped frame.
+ *
+ * A frame handed to a host-side node with the virtual flag is routed by the
+ * firmware as if it had arrived on that node's device, and one it does not
+ * route comes back to the host in the same buffer. So the buffer is mapped
+ * both ways: what the host reads back is what the firmware left there.
+ */
+int nss_data_send(struct nss_core *core, struct sk_buff *skb, u32 if_num,
+		  u16 flags)
+{
+	struct nss_if_mem_map *map = core->if_map;
+	struct nss_h2n_ring *ring;
+	bool bidir = flags & NSS_H2N_FLAG_VIRTUAL_BUFFER;
+	enum dma_data_direction dir = bidir ? DMA_BIDIRECTIONAL : DMA_TO_DEVICE;
+	struct h2n_descriptor *desc;
+	dma_addr_t dma;
+	u32 next, shift;
+	int slot, qid;
+
+	if (!core->running)
+		return -ENODEV;
+
+	/* The firmware serves every data ring alike. One per flow keeps a
+	 * flow in order and spreads flows over the rings' locks.
+	 */
+	qid = NSS_H2N_RING_DATA +
+	      skb_get_hash(skb) % (NSS_H2N_RINGS - NSS_H2N_RING_DATA);
+	ring = &core->h2n[qid];
+
+	if (skb_is_nonlinear(skb) && skb_linearize(skb))
+		return -ENOMEM;
+
+	/* The firmware checks that a frame begins on a word boundary within
+	 * the buffer it is given, and drops one that does not before it
+	 * reaches a ring. A frame this driver builds is aligned by
+	 * construction; one converted from 802.11 is not, because the header
+	 * it replaced was not a multiple of four bytes long. Moving it down
+	 * to the next boundary costs a copy of the frame on the paths that
+	 * are not the fast one - the encapsulated frames, which are the bulk,
+	 * arrive aligned and are left alone.
+	 */
+	shift = (skb->data - skb->head) & 3;
+	if (shift) {
+		if (skb_headroom(skb) < shift || skb_cow_head(skb, 0))
+			return -ENOBUFS;
+
+		memmove(skb->data - shift, skb->data, skb->len);
+		skb->data -= shift;
+		skb_set_tail_pointer(skb, skb->len);
+	}
+
+	dma = dma_map_single(core->dev, skb->head,
+			     skb_end_pointer(skb) - skb->head, dir);
+	if (dma_mapping_error(core->dev, dma))
+		return -ENOMEM;
+
+	/* A transmitted buffer comes back once; the slot is what proves it. */
+	slot = nss_lent_take(core, skb);
+	if (slot < 0) {
+		dma_unmap_single(core->dev, dma, skb_end_pointer(skb) - skb->head,
+				 dir);
+		return -ENOBUFS;
+	}
+	NSS_SKB_CB(skb)->slot = slot;
+	NSS_SKB_CB(skb)->bidir = bidir;
+
+	scoped_guard(spinlock_bh, &ring->lock) {
+		next = (ring->hlos_index + 1) & (NSS_RING_ENTRIES - 1);
+		if (next == READ_ONCE(map->h2n_nss_index[qid])) {
+			nss_lent_put(core, slot);
+			dma_unmap_single(core->dev, dma,
+					 skb_end_pointer(skb) - skb->head, dir);
+			return -EBUSY;
+		}
+
+		NSS_SKB_CB(skb)->dma = dma;
+		NSS_SKB_CB(skb)->tx = true;
+
+		desc = &ring->desc[ring->hlos_index];
+		desc->interface_num = if_num;
+		desc->buffer = dma;
+		desc->buffer_len = skb_end_pointer(skb) - skb->head;
+		desc->payload_offs = skb->data - skb->head;
+		desc->payload_len = skb->len;
+		desc->mss = 0;
+		/* Not the frame's priority: the tag is a classid whose upper
+		 * half selects a shaper node, so a bare priority written here
+		 * would name node zero. It is filled by whatever assigns the
+		 * shaping, and nothing does yet.
+		 */
+		desc->qos_tag = 0;
+		desc->buffer_type = NSS_H2N_BUFFER_PACKET;
+		desc->bit_flags = NSS_H2N_FLAG_FIRST_SEGMENT |
+				  NSS_H2N_FLAG_LAST_SEGMENT | flags |
+				  (nss_tx_reusable && !bidir ?
+				   NSS_H2N_FLAG_BUFFER_REUSABLE : 0);
+		if (skb->ip_summed == CHECKSUM_PARTIAL)
+			desc->bit_flags |= NSS_H2N_FLAG_GEN_IP_CHECKSUM |
+					   NSS_H2N_FLAG_GEN_L4_CHECKSUM;
+		desc->opaque = (uintptr_t)skb;
+
+		core->tx_posted++;
+
+		dma_wmb();
+		ring->hlos_index = next;
+		WRITE_ONCE(map->h2n_hlos_index[qid], next);
+	}
+
+	nss_doorbell(core, NSS_H2N_INTR_DATA_CMD);
+
+	return 0;
+}
+
+/* Keep every line the firmware writes, not just the last ringful.
+ *
+ * The block the firmware asks for at boot fits thirty-two entries and a fault
+ * fills far more than that, so by the time the host is told a fault happened
+ * the beginning of it - the part that says what went wrong - has been
+ * overwritten by the lines that follow it.
+ *
+ * So the host copies entries out as they appear, appending anything new to a
+ * buffer big enough for a whole fault. A line is lost if it arrives faster
+ * than the sampling or after the buffer is full, and the readout says how
+ * many rather than hiding it.
+ */
+#define NSS_LOG_SHADOW_ENTRIES	1024
+/* How often the shadow samples the firmware's write index. A sample that
+ * finds nothing new costs one read, but the timer itself is armed for as long
+ * as a core is loaded, so the rate is a standing cost on a box whose whole
+ * point is not to have one. It is a parameter so the cost can be measured
+ * against the risk of missing a line rather than argued about.
+ */
+static unsigned int nss_log_poll_us = 200;
+module_param_named(log_poll_us, nss_log_poll_us, uint, 0644);
+MODULE_PARM_DESC(log_poll_us, "how often to sample the firmware log ring");
+
+/* Runs from a timer and from whoever is reading, so it is serialised: two
+ * appenders racing on the same index would write past the buffer.
+ */
+static void nss_log_shadow_take(struct nss_core *core)
+{
+	u32 n = core->log_entries;
+	u32 written, first, i;
+
+	if (!core->log || !core->shadow || !n)
+		return;
+
+	guard(spinlock_irqsave)(&core->shadow_lock);
+
+	written = READ_ONCE(core->log->current_entry);
+	if (written == core->shadow_seen)
+		return;
+
+	/* Anything more than a ring behind is already gone. */
+	first = max(core->shadow_seen, written > n ? written - n : 0);
+
+	for (i = first; i < written; i++) {
+		struct nss_log_entry *src = &core->log->log_ring_buffer[i % n];
+
+		if (core->shadow_held >= NSS_LOG_SHADOW_ENTRIES)
+			break;
+
+		core->shadow[core->shadow_held++] = *src;
+	}
+
+	core->shadow_seen = written;
+}
+
+static enum hrtimer_restart nss_log_shadow_tick(struct hrtimer *t)
+{
+	struct nss_core *core = container_of(t, struct nss_core, shadow_timer);
+
+	nss_log_shadow_take(core);
+	hrtimer_forward_now(t, us_to_ktime(nss_log_poll_us));
+
+	return HRTIMER_RESTART;
+}
+
+int nss_log_shadow_init(struct nss_core *core)
+{
+	core->shadow = devm_kcalloc(core->dev, NSS_LOG_SHADOW_ENTRIES,
+				    sizeof(*core->shadow), GFP_KERNEL);
+	if (!core->shadow)
+		return -ENOMEM;
+
+	spin_lock_init(&core->shadow_lock);
+	hrtimer_setup(&core->shadow_timer, nss_log_shadow_tick, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL);
+
+	return 0;
+}
+
+void nss_log_shadow_start(struct nss_core *core)
+{
+	scoped_guard(spinlock_irqsave, &core->shadow_lock) {
+		core->shadow_seen = 0;
+		core->shadow_held = 0;
+	}
+
+	hrtimer_start(&core->shadow_timer, us_to_ktime(nss_log_poll_us),
+		      HRTIMER_MODE_REL);
+}
+
+void nss_log_shadow_stop(struct nss_core *core)
+{
+	hrtimer_cancel(&core->shadow_timer);
+	nss_log_shadow_take(core);
+}
+
+/* Walk what the firmware has been saying, oldest first.
+ *
+ * The write position is a free-running count of lines ever written, not an
+ * index, so how many are valid follows from it rather than from the ring
+ * being full. The host zeroed the block, so a slot whose cookie does not read
+ * back as NSS_LOG_COOKIE has not been written and is skipped.
+ */
+static void nss_log_walk(struct nss_core *core, struct seq_file *s)
+{
+	u32 n = core->log_entries;
+	u32 written, count, i;
+
+	if (!core->log || !n)
+		return;
+
+	nss_log_shadow_take(core);
+
+	written = READ_ONCE(core->log->current_entry);
+	scoped_guard(spinlock_irqsave, &core->shadow_lock)
+		count = core->shadow_held;
+	if (written > count && s)
+		seq_printf(s, "[%u lines arrived faster than they could be kept]\n",
+			   written - count);
+
+	for (i = 0; i < count; i++) {
+		struct nss_log_entry *e = &core->shadow[i];
+
+		if (e->cookie != NSS_LOG_COOKIE)
+			continue;
+
+		if (s)
+			seq_printf(s, "[%llu] %.*s\n", e->sequence_num,
+				   NSS_LOG_LINE_WIDTH, e->message);
+		else
+			dev_err(core->dev, "  fw[%llu] %.*s\n", e->sequence_num,
+				NSS_LOG_LINE_WIDTH, e->message);
+	}
+}
+
+int nss_log_show_ring(struct nss_core *core, struct seq_file *s)
+{
+	if (!core->log || !core->log_entries)
+		return -ENODEV;
+
+	nss_log_walk(core, s);
+
+	return 0;
+}
+
+/* The only account of a core that has stopped, so it is dumped whenever one
+ * does. The ring has been empty on every start observed here and has carried
+ * entries only after a trap, so an empty ring is a result and not a failed
+ * read: the core stopped without trapping.
+ */
+void nss_log_dump(struct nss_core *core, const char *why)
+{
+	dev_err(core->dev, "%s: firmware log follows\n", why);
+	nss_log_walk(core, NULL);
+}
+
+/* Hand the firmware empty buffers. It picks its own offset inside each one
+ * and reports where the payload landed, so what it is given is the head of
+ * the allocation rather than the data pointer.
+ */
+/* The buffers lent to the firmware, by a slot the socket buffer carries, so
+ * that a halt can take back what is still out. A slot is released wherever the
+ * count of buffers in firmware custody is, which is the same event: the buffer
+ * has come home. A descriptor the firmware returned with a cookie this driver
+ * cannot vouch for keeps its slot, because the buffer behind it is exactly
+ * what must not be touched.
+ */
+static int nss_lent_take(struct nss_core *core, struct sk_buff *skb)
+{
+	u32 slot;
+
+	guard(spinlock_bh)(&core->lent_lock);
+
+	if (!core->lent_free_n)
+		return -ENOSPC;
+
+	slot = core->lent_free[--core->lent_free_n];
+	core->lent[slot] = skb;
+
+	return slot;
+}
+
+static bool nss_lent_claim(struct nss_core *core, u32 slot,
+			   struct sk_buff *skb)
+{
+	guard(spinlock_bh)(&core->lent_lock);
+
+	if (slot >= core->lent_size || core->lent[slot] != skb)
+		return false;
+
+	core->lent[slot] = NULL;
+	core->lent_free[core->lent_free_n++] = slot;
+
+	return true;
+}
+
+static void nss_lent_put(struct nss_core *core, u32 slot)
+{
+	guard(spinlock_bh)(&core->lent_lock);
+
+	if (slot >= core->lent_size || !core->lent[slot])
+		return;
+
+	core->lent[slot] = NULL;
+	core->lent_free[core->lent_free_n++] = slot;
+}
+
+static void nss_lent_reclaim(struct nss_core *core)
+{
+	u32 i;
+
+	for (i = 0; i < core->lent_size; i++) {
+		struct sk_buff *skb = core->lent[i];
+
+		if (!skb)
+			continue;
+
+		if (NSS_SKB_CB(skb)->tx)
+			dma_unmap_single(core->dev, NSS_SKB_CB(skb)->dma,
+					 skb_end_pointer(skb) - skb->head,
+					 nss_tx_dir(skb));
+		else
+			dma_unmap_single(core->dev, NSS_SKB_CB(skb)->dma,
+					 NSS_EMPTY_BUFFER_ALLOC, DMA_FROM_DEVICE);
+		dev_kfree_skb_any(skb);
+	}
+
+	kvfree(core->lent);
+	kvfree(core->lent_free);
+	core->lent = NULL;
+	core->lent_free = NULL;
+	core->lent_free_n = 0;
+	core->lent_size = 0;
+}
+
+static int nss_lent_init(struct nss_core *core, u32 n)
+{
+	u32 i;
+
+	spin_lock_init(&core->lent_lock);
+
+	core->lent = kvcalloc(n, sizeof(*core->lent), GFP_KERNEL);
+	core->lent_free = kvmalloc_array(n, sizeof(*core->lent_free),
+					 GFP_KERNEL);
+	if (!core->lent || !core->lent_free) {
+		kvfree(core->lent);
+		kvfree(core->lent_free);
+		core->lent = NULL;
+		core->lent_free = NULL;
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < n; i++)
+		core->lent_free[i] = i;
+	core->lent_free_n = n;
+	core->lent_size = n;
+
+	return 0;
+}
+
+static int nss_refill(struct nss_core *core, int budget)
+{
+	struct nss_h2n_ring *ring = &core->h2n[NSS_H2N_RING_EMPTY_BUF];
+	struct nss_if_mem_map *map = core->if_map;
+	u32 size = NSS_EMPTY_BUFFER_ALLOC;
+	int filled = 0;
+	int ret;
+
+	guard(spinlock_bh)(&ring->lock);
+
+	while (filled < budget) {
+		u32 next = (ring->hlos_index + 1) & (NSS_RING_ENTRIES - 1);
+		struct h2n_descriptor *desc;
+		struct sk_buff *skb;
+		dma_addr_t dma;
+
+		if (atomic_read(&core->buffers_queued) + filled >= core->pool_size)
+			break;
+
+		if (next == READ_ONCE(map->h2n_nss_index[NSS_H2N_RING_EMPTY_BUF]))
+			break;
+
+		/* Custody of these buffers passes to the firmware for as long
+		 * as it likes, so they are allocated outright rather than
+		 * carved out of the per-CPU fragment cache, where each one in
+		 * flight would pin the whole page it came from.
+		 */
+		skb = alloc_skb(size, GFP_ATOMIC);
+		if (!skb)
+			break;
+
+		dma = dma_map_single(core->dev, skb->head, size,
+				     DMA_FROM_DEVICE);
+		if (dma_mapping_error(core->dev, dma)) {
+			kfree_skb(skb);
+			break;
+		}
+
+		NSS_SKB_CB(skb)->dma = dma;
+
+		ret = nss_lent_take(core, skb);
+		if (ret < 0) {
+			dma_unmap_single(core->dev, dma, size, DMA_FROM_DEVICE);
+			kfree_skb(skb);
+			break;
+		}
+		NSS_SKB_CB(skb)->slot = ret;
+
+		desc = &ring->desc[ring->hlos_index];
+		desc->buffer = dma;
+		desc->buffer_len = size;
+		desc->payload_len = 0;
+		desc->payload_offs = 0;
+		desc->buffer_type = NSS_H2N_BUFFER_EMPTY;
+		desc->bit_flags = 0;
+		desc->interface_num = 0;
+		desc->opaque = (uintptr_t)skb;
+
+		ring->hlos_index = next;
+		filled++;
+	}
+
+	if (filled) {
+		dma_wmb();
+		WRITE_ONCE(map->h2n_hlos_index[NSS_H2N_RING_EMPTY_BUF],
+			   ring->hlos_index);
+		atomic_add(filled, &core->buffers_queued);
+		nss_doorbell(core, NSS_H2N_INTR_EMPTY_BUF);
+	}
+
+	return filled;
+}
+
+/* The firmware is up the first time it asks for buffers. */
+static void nss_check_booted(struct nss_core *core)
+{
+	if (core->running)
+		return;
+
+	core->running = true;
+	complete(&core->booted);
+	dev_info(core->dev, "core %u booted\n", core->id);
+}
+
+static int nss_poll_sos(struct napi_struct *napi, int budget)
+{
+	struct nss_irq_ctx *ctx = container_of(napi, struct nss_irq_ctx, napi);
+	struct nss_core *core = ctx->core;
+
+	nss_check_booted(core);
+	/* Every free slot rather than a poll-sized batch. The firmware asks
+	 * when its own pool is low and takes what it needs, so a partial
+	 * answer leaves it short and it has to ask again.
+	 */
+	nss_refill(core, NSS_RING_ENTRIES);
+
+	napi_complete(napi);
+	enable_irq(ctx->irq);
+
+	return 0;
+}
+
+/* Take back whatever the firmware has returned. A buffer comes back either as
+ * a packet on a data queue or as an unused one on the return queue; both are
+ * released here, because nothing above this driver consumes them yet.
+ */
+static int nss_poll_n2h(struct napi_struct *napi, int budget)
+{
+	struct nss_irq_ctx *ctx = container_of(napi, struct nss_irq_ctx, napi);
+	struct nss_core *core = ctx->core;
+	struct nss_n2h_ring *ring;
+	struct nss_if_mem_map *map;
+	u32 nss_index, count;
+	int done = 0;
+	int qid;
+
+	/* Ring 0 carries buffers the firmware is giving back unused; rings 1
+	 * to 4 are the four data queues.
+	 */
+	if (ctx->cause == NSS_CAUSE_EMPTY_BUFFER_QUEUE)
+		qid = NSS_N2H_RING_EMPTY_BUF;
+	else
+		qid = ctx->cause - NSS_CAUSE_DATA_QUEUE_0 + 1;
+
+	ring = &core->n2h[qid];
+	map = core->if_map;
+
+	nss_index = READ_ONCE(map->n2h_nss_index[qid]);
+	count = (nss_index - ring->hlos_index) & (NSS_RING_ENTRIES - 1);
+	count = min_t(u32, count, budget);
+	dma_rmb();
+
+	while (done < count) {
+		struct n2h_descriptor *desc = &ring->desc[ring->hlos_index];
+		struct sk_buff *skb = (struct sk_buff *)(uintptr_t)desc->opaque;
+
+		/* The message buffer comes back on this ring like everything
+		 * else, and is the host's own: it is answered rather than
+		 * freed, and it was never one of the donated buffers.
+		 */
+		core->rx_type[desc->buffer_type & 7]++;
+		if (desc->interface_num < NSS_INTERFACE_MAX)
+			core->rx_iface[desc->interface_num]++;
+
+		/* A returned descriptor is only safe to act on when the cookie
+		 * names an skb this driver lent AND that skb still records the
+		 * DMA address the descriptor carries. The firmware is the other
+		 * side of a trust boundary: a cookie that is a plausible but
+		 * wrong pointer skb_put()s into freed memory, and a DMA address
+		 * that is not the skb's unmaps a wild range - both from softirq,
+		 * both fatal. When the two disagree it cannot be told which is
+		 * the faithful field, so the only safe act is neither: leak the
+		 * one buffer, count it, and step over the slot. A message
+		 * completion carries no donated buffer and is handled first.
+		 */
+		if (!nss_msg_complete(core, desc)) {
+			bool ours = skb && virt_addr_valid((void *)skb) &&
+				    NSS_SKB_CB(skb)->dma == desc->buffer;
+
+			if (!ours) {
+				atomic64_inc(&core->rx_desync);
+				dev_warn_ratelimited(core->dev,
+						     "n2h: desync cookie %llx buf %x dma %llx type %u q %d - leaked\n",
+						     desc->opaque, desc->buffer,
+						     skb && virt_addr_valid((void *)skb) ?
+						     (u64)NSS_SKB_CB(skb)->dma : 0,
+						     desc->buffer_type, qid);
+			/* A buffer this driver transmitted comes back on the
+			 * same ring, and its descriptor still carries the
+			 * offset and length of the frame that was sent. Read
+			 * as a receive it is reserved and put a second time
+			 * over data already there, which walks the tail off
+			 * the end of the allocation. What the host sent is a
+			 * completion and nothing else, so it is claimed here
+			 * before any of it is believed.
+			 */
+			} else if (NSS_SKB_CB(skb)->tx) {
+				if (!nss_lent_claim(core, NSS_SKB_CB(skb)->slot, skb)) {
+					core->tx_dup++;
+					dev_warn_ratelimited(core->dev,
+							     "tx buffer returned twice: q %d type %u if %u\n",
+							     qid, desc->buffer_type,
+							     desc->interface_num);
+					goto next;
+				}
+				atomic64_inc(&core->tx_done);
+				/* A frame sent to a host-side node that the
+				 * firmware did not route comes back in its own
+				 * buffer, as a packet rather than a completion.
+				 */
+				if (nss_redir_recv(core, desc, skb))
+					goto next;
+				dma_unmap_single(core->dev, NSS_SKB_CB(skb)->dma,
+						 skb_end_pointer(skb) - skb->head,
+						 nss_tx_dir(skb));
+				dev_kfree_skb_any(skb);
+			} else {
+				/* Before the stack owns the buffer and its cb. */
+				if (!nss_lent_claim(core, NSS_SKB_CB(skb)->slot, skb)) {
+					atomic64_inc(&core->rx_desync);
+					goto next;
+				}
+				atomic_dec(&core->buffers_queued);
+				if (nss_redir_recv(core, desc, skb) ||
+				    nss_mesh_recv(core, napi, desc, skb) ||
+				    nss_data_recv(core, napi, desc, skb))
+					goto next;
+				dma_unmap_single(core->dev, NSS_SKB_CB(skb)->dma,
+						 NSS_EMPTY_BUFFER_ALLOC,
+						 DMA_FROM_DEVICE);
+				nss_ext_take(core, desc, skb);
+				nss_notify_recv(core, desc, skb);
+				dev_kfree_skb_any(skb);
+			}
+		}
+next:
+		ring->hlos_index = (ring->hlos_index + 1) &
+				   (NSS_RING_ENTRIES - 1);
+		done++;
+	}
+
+	if (done)
+		WRITE_ONCE(map->n2h_hlos_index[qid], ring->hlos_index);
+
+	/* Top the ring up rather than replacing only what came back. The
+	 * firmware holds one buffer per connection it accelerates, for the
+	 * sync message that connection will send, so a pool kept level with
+	 * returns settles at a ring's worth and every create rule after that
+	 * is refused for want of a buffer. The ceiling is the host's, not the
+	 * firmware's, which takes whatever it is offered.
+	 */
+	nss_refill(core, NSS_RING_ENTRIES);
+
+	if (done < budget) {
+		napi_complete(napi);
+		enable_irq(ctx->irq);
+	}
+
+	return done;
+}
+
+/* A core that has dumped is finished. Stock brings the whole box down here,
+ * on the argument that the data plane is gone either way; this driver keeps
+ * the box routing on the host, reads the firmware log, and restarts the core.
+ */
+static int nss_poll_coredump(struct napi_struct *napi, int budget)
+{
+	struct nss_irq_ctx *ctx = container_of(napi, struct nss_irq_ctx, napi);
+	struct nss_core *core = ctx->core;
+
+	dev_err(core->dev, "core %u has crashed\n", core->id);
+	nss_log_dump(core, "coredump");
+	nss_core_fault(core);
+
+	napi_complete(napi);
+
+	/* The line is deliberately left masked: the core is not coming back
+	 * without a reset, and re-arming would only invite the same interrupt
+	 * again.
+	 */
+	return 0;
+}
+
+static irqreturn_t nss_isr(int irq, void *data)
+{
+	struct nss_irq_ctx *ctx = data;
+
+	disable_irq_nosync(irq);
+	napi_schedule(&ctx->napi);
+
+	return IRQ_HANDLED;
+}
+
+typedef int (*nss_poll_t)(struct napi_struct *napi, int budget);
+
+static nss_poll_t nss_poll_fn(enum nss_cause cause)
+{
+	switch (cause) {
+	case NSS_CAUSE_EMPTY_BUFFER_SOS:
+		return nss_poll_sos;
+	case NSS_CAUSE_EMPTY_BUFFER_QUEUE:
+	case NSS_CAUSE_DATA_QUEUE_0:
+	case NSS_CAUSE_DATA_QUEUE_1:
+	case NSS_CAUSE_DATA_QUEUE_2:
+	case NSS_CAUSE_DATA_QUEUE_3:
+		return nss_poll_n2h;
+	case NSS_CAUSE_COREDUMP_COMPLETE:
+		return nss_poll_coredump;
+	default:
+		/* Paged buffers, transmit unblocking and the profiler are not
+		 * used by this driver, so their lines are left unclaimed:
+		 * they are edge triggered, and nothing here would act on
+		 * them.
+		 */
+		return NULL;
+	}
+}
+
+int nss_rings_start(struct nss_core *core)
+{
+	struct platform_device *pdev = to_platform_device(core->dev);
+	unsigned int cpu;
+	int i, ret;
+
+	core->ndev = alloc_netdev_dummy(0);
+	if (!core->ndev)
+		return -ENOMEM;
+
+	/* Empty buffers fill the table up to the pool ceiling, so transmitted
+	 * frames need room of their own beside them.
+	 */
+	ret = nss_lent_init(core, 2 * nss_pool_ceiling());
+	if (ret)
+		goto err;
+
+	for (i = 0; i < NSS_CAUSE_MAX; i++) {
+		struct nss_irq_ctx *ctx = &core->irq[i];
+		nss_poll_t poll = nss_poll_fn(i);
+
+		ctx->core = core;
+		ctx->cause = i;
+
+		if (!poll)
+			continue;
+
+		ctx->irq = platform_get_irq(pdev, i);
+		if (ctx->irq < 0) {
+			ret = ctx->irq;
+			goto err;
+		}
+
+		ret = request_irq(ctx->irq, nss_isr, IRQF_NO_AUTOEN,
+				  dev_name(core->dev), ctx);
+		if (ret)
+			goto err;
+
+		/* One CPU per data queue, which the firmware spreads
+		 * host-bound frames over by flow.
+		 */
+		if (i >= NSS_CAUSE_DATA_QUEUE_0 &&
+		    i <= NSS_CAUSE_DATA_QUEUE_3) {
+			cpu = cpumask_local_spread(i - NSS_CAUSE_DATA_QUEUE_0,
+						   NUMA_NO_NODE);
+			irq_set_affinity_and_hint(ctx->irq, cpumask_of(cpu));
+		}
+
+		netif_napi_add_weight(core->ndev, &ctx->napi, poll,
+				      NSS_NAPI_WEIGHT);
+		napi_enable(&ctx->napi);
+		ctx->napi_added = true;
+		enable_irq(ctx->irq);
+	}
+
+	return 0;
+
+err:
+	nss_rings_stop(core);
+
+	return ret;
+}
+
+/* Wait out any receive poll already running.
+ *
+ * A poll that has read a callback the WLAN driver is withdrawing is holding a
+ * pointer into memory that driver is about to free, and clearing the pointer
+ * does not reach a poll that read it a moment earlier.
+ */
+void nss_rings_quiesce(struct nss_core *core)
+{
+	int i;
+
+	for (i = 0; i < NSS_CAUSE_MAX; i++)
+		if (core->irq[i].napi_added)
+			napi_synchronize(&core->irq[i].napi);
+}
+
+void nss_rings_stop(struct nss_core *core)
+{
+	int i;
+
+	for (i = 0; i < NSS_CAUSE_MAX; i++) {
+		struct nss_irq_ctx *ctx = &core->irq[i];
+
+		if (!ctx->napi_added)
+			continue;
+
+		/* The poll first: it ends by re-enabling the line, which must
+		 * still be claimed. A disabled NAPI ignores the interrupt.
+		 */
+		napi_disable(&ctx->napi);
+		irq_update_affinity_hint(ctx->irq, NULL);
+		free_irq(ctx->irq, ctx);
+		netif_napi_del(&ctx->napi);
+		ctx->napi_added = false;
+	}
+
+	if (core->ndev) {
+		free_netdev(core->ndev);
+		core->ndev = NULL;
+	}
+
+	/* After the poll is gone, because it is the other side of the table. */
+	nss_lent_reclaim(core);
+}
diff --git a/package/kernel/nss-wifi-drv/src/nss_wifili.c b/package/kernel/nss-wifi-drv/src/nss_wifili.c
new file mode 100644
index 0000000000..85bee100b3
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_wifili.c
@@ -0,0 +1,2818 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bringing wifili up against rings the host owns.
+ *
+ * The initialisation message is the largest structure in this ABI and the one
+ * with the most room to be silently misread: a field whose offset moved
+ * between firmware lines is accepted, stored, and produces a data plane that
+ * does not work for reasons nothing reports. It can be checked without a
+ * radio, and it is checked here before there is one.
+ *
+ * The method is refusal: each one-field corruption is refused with its own
+ * error code, so each arm below confirms one offset, and the valid arm that
+ * follows them confirms that the whole structure is acceptable.
+ *
+ * The rings are the host's own coherent memory and nothing consumes them.
+ * That is enough for every check here, because what is under test is the
+ * message rather than the data plane.
+ */
+
+#include <linux/container_of.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/ieee80211.h>
+#include <linux/if_ether.h>
+#include <linux/igmp.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
+#include <net/addrconf.h>
+#include <net/if_inet6.h>
+#include <net/ip.h>
+#include <net/mld.h>
+
+#include "nss_drv.h"
+#include <linux/soc/qcom/nss_wifi.h>
+
+/* Small on purpose. Nothing drains these, and the receive ring the firmware
+ * fills from its own pool is the one that would cost something if it were not.
+ */
+#define NSS_WIFILI_RING_ENTRIES		32
+#define NSS_WIFILI_ENTRY_WORDS		8
+/* Transmit descriptors per pool. The firmware holds one for every frame in
+ * flight and refuses the frame when it cannot get one, silently as far as the
+ * host is concerned - only the firmware's own desc_alloc_fail counter shows
+ * it, and at 64 it read three times the number of frames that got through.
+ * A descriptor is under 128 bytes, so this many still fit the page below.
+ */
+#define NSS_WIFILI_TX_DESC		512
+#define NSS_WIFILI_TX_PROCESSQ		1024
+
+/* The firmware carves both kinds out of the memory given here, at a stride
+ * of its own for each, and a block smaller than the declared count leads to
+ * a range trap. The size follows the count: every pool's descriptors plus one
+ * spare per pool.
+ */
+#define NSS_WIFILI_TX_DESC_STRIDE	80
+#define NSS_WIFILI_TX_DESC_EXT_STRIDE	160
+
+#define NSS_WIFILI_TX_DESC_MEM(pools, stride) \
+	PAGE_ALIGN(((NSS_WIFILI_TX_DESC + 1) * (pools)) * (stride))
+
+/* The receive buffer the hardware would be programmed with, and the tag block
+ * in front of it. Both are bounds-checked by the firmware, which is why they
+ * are here rather than left zero.
+ */
+#define NSS_WIFILI_TLV_SIZE		256
+#define NSS_WIFILI_RX_BUF_LEN		2048
+
+/* This SoC, as the firmware enumerates targets. */
+#define NSS_WIFILI_TARGET_QCA8074V2	24
+
+/* Where the per-radio rings begin, which is what tells the firmware to read
+ * their write pointer out of the second shadow array rather than a register.
+ */
+#define NSS_WIFILI_LMAC_RING_START	128
+
+enum nss_wifili_ring_id {
+	NSS_WIFILI_RING_TCL,
+	NSS_WIFILI_RING_TX_COMP,
+	NSS_WIFILI_RING_REO_DEST,
+	NSS_WIFILI_RING_REO_REINJECT,
+	NSS_WIFILI_RING_RX_REL,
+	NSS_WIFILI_RING_REO_EXCEPTION,
+	NSS_WIFILI_RING_MAX,
+};
+
+/* Which of the deliberate faults to introduce, or none. */
+enum nss_wifili_fault {
+	NSS_WIFILI_FAULT_NONE,
+	NSS_WIFILI_FAULT_RING_ALIGN,
+	NSS_WIFILI_FAULT_RING_DIR,
+	NSS_WIFILI_FAULT_RING_ENTRIES,
+	NSS_WIFILI_FAULT_TARGET,
+	NSS_WIFILI_FAULT_TLV_SIZE,
+	NSS_WIFILI_FAULT_RX_BUF_LEN,
+};
+
+struct nss_wifili_mem {
+	void *cpu;
+	dma_addr_t dma;
+	size_t size;
+};
+
+struct nss_wifili_ctx {
+	struct nss_wifili_mem ring[NSS_WIFILI_RING_MAX];
+	struct nss_wifili_mem shadow;
+	struct nss_wifili_mem doorbell;
+	struct nss_wifili_mem txdesc;
+	struct nss_wifili_mem txdescext;
+};
+
+/* The one core that runs wifili. The WLAN driver is loaded and unloaded
+ * independently of this one and knows nothing about which core is which, so
+ * the binding lives here.
+ */
+static struct nss_core *nss_wifili_core;
+static DEFINE_MUTEX(nss_wifili_lock);
+
+/* One wifili instance: what the WLAN driver said about its rings, and what
+ * the firmware made of them. Instance 0 carries the radios inside the SoC,
+ * the others radios on their own chip, each under an interface and a node
+ * type of its own.
+ */
+struct nss_wifili_soc {
+	struct nss_wifi_soc desc;
+	struct nss_wifi_pdev pdev[NSS_WIFILI_MAX_PDEV_NUM_MSG];
+	int radio_if[NSS_WIFILI_MAX_PDEV_NUM_MSG];
+	u8 pdevs;
+	bool used;
+	bool started;
+	/* The device of the radios whose rings the firmware reaps. Every
+	 * interface on it is the firmware's, with or without a virtual device
+	 * of its own. The bus device outlives the WLAN driver, so its address
+	 * stays its own.
+	 */
+	struct device *radio;
+	struct nss_wifili_mem txdesc;
+	struct nss_wifili_mem txdescext;
+	struct nss_wifili_device_stats stats;
+	u32 stats_seen;
+};
+
+static const struct {
+	u32 if_num;
+	u32 node;
+} nss_wifili_soc_if[] = {
+	{ NSS_INTERFACE_WIFILI, NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_INTERNAL },
+	{ NSS_INTERFACE_WIFILI_EXT0, NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_EXTERNAL0 },
+	{ NSS_INTERFACE_WIFILI_EXT1, NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_EXTERNAL1 },
+};
+
+static struct nss_wifili_soc nss_wifili_socs[ARRAY_SIZE(nss_wifili_soc_if)];
+
+static u32 nss_wifili_soc_ifnum(const struct nss_wifili_soc *soc)
+{
+	return nss_wifili_soc_if[soc - nss_wifili_socs].if_num;
+}
+
+/* A registered instance, under nss_wifili_lock. */
+static struct nss_wifili_soc *nss_wifili_soc_get(int id)
+{
+	if (id < 0 || id >= ARRAY_SIZE(nss_wifili_socs) ||
+	    !nss_wifili_socs[id].used)
+		return NULL;
+
+	return &nss_wifili_socs[id];
+}
+
+/* The instance a firmware message is about, from the softirq that delivers
+ * it. The callbacks it carries are withdrawn before the instance is reused.
+ */
+static struct nss_wifili_soc *nss_wifili_soc_of(u32 if_num)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(nss_wifili_soc_if); i++)
+		if (nss_wifili_soc_if[i].if_num == NSS_INTERFACE_NUM_GET(if_num))
+			return &nss_wifili_socs[i];
+
+	return NULL;
+}
+
+bool nss_wifili_is_soc(u32 if_num)
+{
+	return nss_wifili_soc_of(if_num);
+}
+
+bool nss_wifili_owns(const struct net_device *dev)
+{
+	int i;
+
+	if (!dev->dev.parent)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(nss_wifili_socs); i++)
+		if (dev->dev.parent == READ_ONCE(nss_wifili_socs[i].radio))
+			return true;
+
+	return false;
+}
+
+void nss_wifili_bind(struct nss_core *core)
+{
+	guard(mutex)(&nss_wifili_lock);
+	nss_wifili_core = core;
+}
+
+/* Keep what the WLAN driver says; starting the firmware is a separate act,
+ * because a running core takes the hardware with it. Returns the instance.
+ */
+int nss_wifi_soc_register(const struct nss_wifi_soc *desc)
+{
+	struct nss_wifili_soc *soc;
+	int i;
+
+	guard(mutex)(&nss_wifili_lock);
+
+	if (desc->num_tcl > NSS_WIFI_MAX_TCL_RINGS ||
+	    desc->num_reo > NSS_WIFI_MAX_REO_RINGS ||
+	    desc->num_pdevs > NSS_WIFILI_MAX_PDEV_NUM_MSG)
+		return -EINVAL;
+
+	for (i = desc->external; i < ARRAY_SIZE(nss_wifili_socs); i++)
+		if (!nss_wifili_socs[i].used)
+			break;
+	if (i == ARRAY_SIZE(nss_wifili_socs) || (!desc->external && i))
+		return -EBUSY;
+
+	soc = &nss_wifili_socs[i];
+	soc->desc = *desc;
+	soc->pdevs = 0;
+	memset(soc->radio_if, 0xff, sizeof(soc->radio_if));
+	soc->used = true;
+
+	return i;
+}
+EXPORT_SYMBOL_GPL(nss_wifi_soc_register);
+
+static void nss_wifili_soc_stop(struct nss_core *core,
+				struct nss_wifili_soc *soc);
+static void nss_wifili_forget(struct nss_core *core);
+
+static bool nss_wifili_any_started(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(nss_wifili_socs); i++)
+		if (nss_wifili_socs[i].started)
+			return true;
+
+	return false;
+}
+
+void nss_wifi_soc_unregister(int id)
+{
+	struct nss_core *core;
+	struct nss_wifili_soc *soc;
+
+	guard(mutex)(&nss_wifili_lock);
+
+	soc = nss_wifili_soc_get(id);
+	if (!soc)
+		return;
+
+	/* The WLAN driver is about to free the rings this reaches into, and a
+	 * receive poll that read the callback a moment ago is still holding
+	 * it, so the withdrawal is not complete until that poll has ended.
+	 */
+	WRITE_ONCE(soc->desc.link_desc_return, NULL);
+	WRITE_ONCE(soc->desc.rx_80211, NULL);
+	WRITE_ONCE(soc->desc.peer_stats, NULL);
+	soc->used = false;
+	soc->pdevs = 0;
+
+	core = nss_wifili_core;
+	if (!core)
+		return;
+
+	/* A firmware started on those rings keeps reaping them after they are
+	 * freed and after they are allocated again for the next WLAN
+	 * instance, whose entries it then resolves against descriptors it
+	 * never issued. A running one is told to let go of them. A dead one
+	 * is halted, but only once every radio it lent buffers to has
+	 * stopped, which is when the last of their resets gets here.
+	 */
+	if (soc->started && core->running) {
+		scoped_guard(mutex, &core->lock)
+			nss_wifili_soc_stop(core, soc);
+	} else if (soc->started) {
+		soc->started = false;
+		if (!nss_wifili_any_started()) {
+			nss_core_stop(core);
+			nss_wifili_forget(core);
+		}
+	} else {
+		nss_rings_quiesce(core);
+	}
+}
+EXPORT_SYMBOL_GPL(nss_wifi_soc_unregister);
+
+static bool nss_wifili_described(const struct nss_wifili_soc *soc)
+{
+	return soc->used && soc->pdevs == soc->desc.num_pdevs;
+}
+
+int nss_wifi_pdev_register(int id, const struct nss_wifi_pdev *pdev)
+{
+	struct nss_wifili_soc *soc;
+
+	guard(mutex)(&nss_wifili_lock);
+
+	soc = nss_wifili_soc_get(id);
+	if (!soc || soc->pdevs >= soc->desc.num_pdevs)
+		return -EINVAL;
+
+	soc->pdev[soc->pdevs++] = *pdev;
+
+	pr_info("nss-wifi-drv: radio %u rxdma id %u base %#x x%u hw %#x/%#x swdesc %u\n",
+		pdev->radio_id, pdev->rxdma.id, pdev->rxdma.base,
+		pdev->rxdma.num_entries, pdev->rxdma.hwreg[0],
+		pdev->rxdma.hwreg[1], pdev->num_rx_swdesc);
+
+	/* After a reset of the WLAN driver, which is the last thing it does
+	 * before its interfaces come back.
+	 */
+	if (nss_wifili_core && nss_wifili_described(soc))
+		nss_core_resume(nss_wifili_core);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(nss_wifi_pdev_register);
+
+/* Reset the WLAN driver because the core runs Wi-Fi (@started): the radios
+ * hold buffers it lent, freed once they have stopped, and the reset halts the
+ * core on its way down. Or because a running core ran Wi-Fi before a halt:
+ * the reset is what registers the radios' interfaces with it.
+ */
+bool nss_wifili_reset(struct nss_core *core, bool started)
+{
+	bool reset = false;
+	int i;
+
+	guard(mutex)(&nss_wifili_lock);
+
+	if (!core->wifi_on || core->wifili_started != started ||
+	    (!started && !core->running))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(nss_wifili_socs); i++) {
+		struct nss_wifili_soc *soc = &nss_wifili_socs[i];
+
+		if (!soc->used || !soc->desc.reset ||
+		    (started && !soc->started))
+			continue;
+
+		soc->desc.reset(soc->desc.priv);
+		reset = true;
+	}
+
+	return reset;
+}
+
+/* The one message the firmware sends unasked that must be acted on.
+ *
+ * It reaps rings holding MSDU-link descriptors it cannot put back, because
+ * the ring that returns one to the idle list stays with the WLAN driver, and
+ * hands each one back here instead. An unreturned descriptor is gone from the
+ * idle list for good, and an empty idle list stops receive on every radio
+ * rather than only on the path that emptied it - so late is the same as never
+ * and this may not be deferred.
+ */
+static DEFINE_SPINLOCK(nss_wifili_stats_lock);
+
+/* What the firmware says about its own receive path. Empty rings and full
+ * rings that drop look identical from the host, and these are what tell them
+ * apart.
+ */
+static void nss_wifili_soc_stats_print(struct seq_file *s,
+				       const struct nss_wifili_soc *soc)
+{
+	struct nss_wifili_device_stats st;
+	u32 seen;
+	int i;
+
+	spin_lock_bh(&nss_wifili_stats_lock);
+	st = soc->stats;
+	seen = soc->stats_seen;
+	spin_unlock_bh(&nss_wifili_stats_lock);
+
+	seq_printf(s, "wifili %u reports %u\n", nss_wifili_soc_ifnum(soc),
+		   seen);
+	if (!seen)
+		return;
+
+	for (i = 0; i < NSS_WIFILI_MAX_PDEV_NUM_MSG; i++)
+		seq_printf(s, "radio%d replenished %u hw_desc_unavailable %u  pool no_pb %u alloc %u alloc_fail %u\n",
+			   i, st.rxdma_stats[i].rx_buf_replenished,
+			   st.rxdma_stats[i].rx_hw_desc_unavailable,
+			   st.rx_sw_pool_stats[i].rx_no_pb,
+			   st.rx_sw_pool_stats[i].desc_alloc,
+			   st.rx_sw_pool_stats[i].desc_alloc_fail);
+
+	for (i = 0; i < NSS_WIFILI_MAX_REO_DATA_RINGS_MSG; i++)
+		seq_printf(s, "reo%d reaped %u error %u invalid_cookie %u defrag %u\n",
+			   i, st.rxreo_stats[i].ring_reaped,
+			   st.rxreo_stats[i].ring_error,
+			   st.rxreo_stats[i].invalid_cookie,
+			   st.rxreo_stats[i].defrag_reaped);
+
+	seq_printf(s, "wbm invalid_buf_mgr %u src_rxdma %u src_reo %u src_invalid %u\n",
+		   st.rxwbm_stats.invalid_buf_mgr,
+		   st.rxwbm_stats.err_src_rxdma,
+		   st.rxwbm_stats.err_src_reo,
+		   st.rxwbm_stats.err_src_invalid);
+}
