diff --git a/package/kernel/mac80211/patches/nss-wifi/915-ath11k-keep-NSS-vdevs-on-ethernet-with-a-monitor-interface.patch b/package/kernel/mac80211/patches/nss-wifi/915-ath11k-keep-NSS-vdevs-on-ethernet-with-a-monitor-interface.patch
new file mode 100644
index 0000000000..f24a32d1df
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/915-ath11k-keep-NSS-vdevs-on-ethernet-with-a-monitor-interface.patch
@@ -0,0 +1,76 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: keep NSS vdevs on ethernet with a monitor interface
+
+mac80211 withdraws the encapsulation and decapsulation offloads while a
+monitor interface exists, and ath11k then sets the WLAN firmware vdev to
+native Wi-Fi. The NSS firmware vdev keeps the ethernet mode it was
+registered with and still receives every frame as ethernet, so the
+transmit descriptors it builds no longer match the WLAN vdev. Under the
+offload, set access point and station vdevs to ethernet in both
+directions whatever mac80211 grants; frames mac80211 sends as 802.11
+are already converted before they reach the NSS firmware.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
+index 2fcd870..339fc21 100644
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -7003,15 +7003,19 @@ static int ath11k_mac_setup_vdev_create_params(struct ath11k_vif *arvif,
+  * what the hardware encapsulation and decapsulation this driver has already
+  * been told to use produce.
+  */
+-/* The mode the WLAN firmware was given for this direction a moment ago, in
+- * ath11k_mac_op_update_vif_offload(). The NSS firmware has to declare the same
+- * one, and mac80211 grants the encapsulation offload rather than the driver
+- * choosing it, so it is read back here rather than derived from frame_mode.
++/*
++ * The mode the WLAN firmware is given for one direction of a vdev, which the
++ * NSS firmware has to declare as well. An NSS access point or station vdev
++ * is ethernet whatever mac80211 grants: every frame reaches the NSS firmware
++ * as ethernet, and the NSS vdev keeps the mode it was registered with while
++ * mac80211 withdraws the offload for as long as a monitor interface exists.
+  */
+ static u8 ath11k_nss_vdev_mode(struct ath11k_base *ab,
+ 			       struct ieee80211_vif *vif, u32 offload_flag)
+ {
+-	if (vif->offload_flags & offload_flag)
++	if (vif->offload_flags & offload_flag ||
++	    (ab->nss_offload && (vif->type == NL80211_IFTYPE_AP ||
++				 vif->type == NL80211_IFTYPE_STATION)))
+ 		return ATH11K_HW_TXRX_ETHERNET;
+ 	if (test_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags))
+ 		return ATH11K_HW_TXRX_RAW;
+@@ -7112,13 +7116,8 @@ static void ath11k_mac_op_update_vif_offload(struct ieee80211_hw *hw,
+ 		vif->offload_flags &= ~(IEEE80211_OFFLOAD_ENCAP_ENABLED |
+ 					IEEE80211_OFFLOAD_DECAP_ENABLED);
+ 
+-	if (vif->offload_flags & IEEE80211_OFFLOAD_ENCAP_ENABLED)
+-		param_value = ATH11K_HW_TXRX_ETHERNET;
+-	else if (test_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags))
+-		param_value = ATH11K_HW_TXRX_RAW;
+-	else
+-		param_value = ATH11K_HW_TXRX_NATIVE_WIFI;
+-
++	param_value = ath11k_nss_vdev_mode(ab, vif,
++					   IEEE80211_OFFLOAD_ENCAP_ENABLED);
+ 	ret = ath11k_wmi_vdev_set_param_cmd(ar, arvif->vdev_id,
+ 					    param_id, param_value);
+ 	if (ret) {
+@@ -7128,13 +7127,8 @@ static void ath11k_mac_op_update_vif_offload(struct ieee80211_hw *hw,
+ 	}
+ 
+ 	param_id = WMI_VDEV_PARAM_RX_DECAP_TYPE;
+-	if (vif->offload_flags & IEEE80211_OFFLOAD_DECAP_ENABLED)
+-		param_value = ATH11K_HW_TXRX_ETHERNET;
+-	else if (test_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags))
+-		param_value = ATH11K_HW_TXRX_RAW;
+-	else
+-		param_value = ATH11K_HW_TXRX_NATIVE_WIFI;
+-
++	param_value = ath11k_nss_vdev_mode(ab, vif,
++					   IEEE80211_OFFLOAD_DECAP_ENABLED);
+ 	ret = ath11k_wmi_vdev_set_param_cmd(ar, arvif->vdev_id,
+ 					    param_id, param_value);
+ 	if (ret) {
diff --git a/package/kernel/mac80211/patches/nss-wifi/916-ath11k-convert-station-vdev-802.11-frames-for-the-NSS-firmware.patch b/package/kernel/mac80211/patches/nss-wifi/916-ath11k-convert-station-vdev-802.11-frames-for-the-NSS-firmware.patch
new file mode 100644
index 0000000000..4129123798
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/916-ath11k-convert-station-vdev-802.11-frames-for-the-NSS-firmware.patch
@@ -0,0 +1,44 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: convert station vdev 802.11 frames for the NSS firmware
+
+Frames mac80211 sends as 802.11, which include every EAPOL frame, are
+converted to ethernet before they go to the NSS firmware. The conversion
+takes the receiver's interface type and is always given a station's, and
+ieee80211_data_to_8023() rejects a ToDS frame for a station. On a
+station vdev every such frame is dropped and the 4-way handshake never
+completes. Pass an access point's interface type for a station vdev.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
+index 339fc21..1aa3679 100644
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -6613,11 +6613,12 @@ static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
+ 	 * The conversion is the subsystem's own, and it is written for the
+ 	 * receiving side: it refuses a frame travelling away from the
+ 	 * distribution system on an access point, which is every frame an
+-	 * access point sends. A frame leaving here is bit for bit the frame a
+-	 * station receives, so it is converted as that station would - the
+-	 * address it is told to expect is the frame's own first address,
+-	 * which is what makes the check it performs vacuous rather than
+-	 * wrong.
++	 * access point sends. A frame leaving here is bit for bit the frame
++	 * its receiver gets, so it is converted as the receiver would: as a
++	 * station for an access point's frame, as an access point for a
++	 * station's - the address it is told to expect is the frame's own
++	 * first address, which is what makes the check it performs vacuous
++	 * rather than wrong.
+ 	 */
+ 	/* A mesh device carries 802.11, without the QoS control the
+ 	 * hardware inserts itself.
+@@ -6644,6 +6645,8 @@ static void ath11k_mac_op_tx(struct ieee80211_hw *hw,
+ 
+ 		if (!(info_flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+ 		    ieee80211_data_to_8023(skb, hdr->addr1,
++					   vif->type == NL80211_IFTYPE_STATION ?
++					   NL80211_IFTYPE_AP :
+ 					   NL80211_IFTYPE_STATION)) {
+ 			ieee80211_free_txskb(ar->hw, skb);
+ 			return;
diff --git a/package/kernel/mac80211/patches/nss-wifi/917-ath11k-authorise-open-network-peers-in-the-NSS-firmware.patch b/package/kernel/mac80211/patches/nss-wifi/917-ath11k-authorise-open-network-peers-in-the-NSS-firmware.patch
