diff --git a/package/kernel/mac80211/patches/nss-wifi/904-ath11k-tell-the-NSS-firmware-about-a-station.patch b/package/kernel/mac80211/patches/nss-wifi/904-ath11k-tell-the-NSS-firmware-about-a-station.patch
new file mode 100644
index 0000000000..981d496380
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/904-ath11k-tell-the-NSS-firmware-about-a-station.patch
@@ -0,0 +1,99 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: tell the NSS firmware about a station
+
+The firmware places a frame for a station it knows, so a station this
+driver creates has to be created there too. The message carries the
+identifier, the hardware address-search index and the transmit hash, all
+of which the WLAN firmware supplies through the peer map that peer
+creation already waits for, so the values are read from the host record
+while it is held and the message is sent after the lock is dropped.
+
+The delete goes ahead of the deletion rather than after it. The firmware
+names a peer by the identifier the host record carries, and by the time
+the unmap event runs that record is gone; sending it here, under the
+mutex the whole peer lifecycle is serialised by, means no message ever
+has to leave a context that cannot sleep.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/peer.c
++++ b/drivers/net/wireless/ath/ath11k/peer.c
+@@ -5,6 +5,8 @@
+  */
+ 
+ #include "core.h"
++
++#include <linux/soc/qcom/nss_wifi.h>
+ #include "peer.h"
+ #include "debug.h"
+ 
+@@ -353,6 +355,25 @@ int ath11k_peer_delete(struct ath11k *ar
+ 
+ 	lockdep_assert_held(&ar->conf_mutex);
+ 
++	/* Ahead of the deletion, because the firmware names a peer by the
++	 * identifier the host record carries and that record is gone by the
++	 * time the unmap event runs.
++	 */
++	if (ar->ab->nss_offload) {
++		struct ath11k_peer *peer;
++		u16 peer_id = 0;
++
++		spin_lock_bh(&ar->ab->base_lock);
++		peer = ath11k_peer_find(ar->ab, vdev_id, addr);
++		if (peer)
++			peer_id = peer->peer_id;
++		spin_unlock_bh(&ar->ab->base_lock);
++
++		if (peer)
++			nss_wifi_peer_delete(ar->ab->nss_soc, vdev_id, addr,
++					     peer_id);
++	}
++
+ 	ret = __ath11k_peer_delete(ar, vdev_id, addr);
+ 	if (ret)
+ 		return ret;
+@@ -372,6 +393,7 @@ int ath11k_peer_create(struct ath11k *ar
+ {
+ 	struct ath11k_peer *peer;
+ 	struct ath11k_sta *arsta;
++	u16 peer_id, ast_idx, ast_hash;
+ 	int ret, fbret;
+ 
+ 	lockdep_assert_held(&ar->conf_mutex);
+@@ -457,9 +479,35 @@ int ath11k_peer_create(struct ath11k *ar
+ 
+ 	ar->num_peers++;
+ 
++	peer_id = peer->peer_id;
++	ast_idx = peer->hw_peer_id;
++	ast_hash = peer->ast_hash;
++
+ 	spin_unlock_bh(&ar->ab->base_lock);
+ 	mutex_unlock(&ar->ab->tbl_mtx_lock);
+ 
++	/* Outside the lock, because telling the firmware is a message that
++	 * waits for its answer. Everything the message carries was read while
++	 * the record was held, and the record cannot go before this returns:
++	 * the delete runs under the mutex this call already holds.
++	 */
++	if (ar->ab->nss_offload) {
++		/* A firmware that will not take the peer is a peer that is not
++		 * offloaded, not a peer that may not exist. Failing the
++		 * creation here deletes it, and for an access point's own
++		 * address that is the radio itself: the interface never comes
++		 * up and no station can associate, which is a far larger
++		 * failure than the one being reported.
++		 */
++		ret = nss_wifi_peer_create(ar->ab->nss_soc, param->vdev_id,
++					   param->peer_addr, peer_id, ast_idx,
++					   ast_hash);
++		if (ret)
++			ath11k_warn(ar->ab, "peer %pM is not offloaded: %d\n",
++				    param->peer_addr, ret);
++		ret = 0;
++	}
++
+ 	return 0;
+ 
+ cleanup:
diff --git a/package/kernel/mac80211/patches/nss-wifi/905-ath11k-tell-the-NSS-firmware-how-frames-are-protected.patch b/package/kernel/mac80211/patches/nss-wifi/905-ath11k-tell-the-NSS-firmware-how-frames-are-protected.patch
new file mode 100644
index 0000000000..b75aed1c0a
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/905-ath11k-tell-the-NSS-firmware-how-frames-are-protected.patch
@@ -0,0 +1,78 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: tell the NSS firmware how frames are protected
+
+The firmware builds the transmit descriptor, and the descriptor carries
+the encryption the hardware is to apply. It takes that from the virtual
+device, not from the frame, so nothing tells it until this does: left
+unsaid the encryption is none, and a station that has just installed a
+pairwise key discards every frame that follows. The symptom is an
+association that authenticates and never authorises.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -6,6 +6,7 @@
+ 
+ #include <net/mac80211.h>
+ #include <linux/soc/qcom/nss_wifi.h>
++/* nss_wifi_vdev_security() */
+ #include <net/cfg80211.h>
+ #include <linux/etherdevice.h>
+ #include <linux/bitfield.h>
+@@ -4507,6 +4508,7 @@ static int ath11k_mac_op_set_key(struct
+ 	const u8 *peer_addr;
+ 	int ret = 0;
+ 	u32 flags = 0;
++	u16 nss_peer_id = 0;
+ 
+ 	/* BIP needs to be done in software */
+ 	if (key->cipher == WLAN_CIPHER_SUITE_AES_CMAC ||
+@@ -4620,6 +4622,10 @@ static int ath11k_mac_op_set_key(struct
+ 	spin_lock_bh(&ab->base_lock);
+ 	peer = ath11k_peer_find(ab, arvif->vdev_id, peer_addr);
+ 	if (peer && cmd == SET_KEY) {
++		/* Read here because the firmware names a peer by it and the
++		 * calls that carry it cannot be made under this lock.
++		 */
++		nss_peer_id = peer->peer_id;
+ 		peer->keys[key->keyidx] = key;
+ 		if (key->flags & IEEE80211_KEY_FLAG_PAIRWISE) {
+ 			peer->ucast_keyidx = key->keyidx;
+@@ -4660,6 +4666,36 @@ static int ath11k_mac_op_set_key(struct
+ 
+ 	spin_unlock_bh(&ab->base_lock);
+ 
++	/* The firmware builds the transmit descriptor, so the cipher the
++	 * hardware is to apply has to reach it. Left unsaid it is none, and a
++	 * station that has just installed a key discards everything that
++	 * follows.
++	 *
++	 * The device-wide cipher covers transmit. Receive undoes the
++	 * protection itself wherever the hardware cannot - every fragment and
++	 * every message integrity check - and consults a value held per peer,
++	 * so that one is sent as well, for the pairwise key and the group key
++	 * alike. A peer the firmware holds unauthorised has its received
++	 * frames counted and dropped, so it is authorised in the same breath.
++	 */
++	if (ar->ab->nss_offload && cmd == SET_KEY) {
++		bool group = !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE);
++		const u8 *mic = NULL;
++
++		if (key->cipher == WLAN_CIPHER_SUITE_TKIP &&
++		    key->keylen >= NL80211_TKIP_DATA_OFFSET_RX_MIC_KEY + 8)
++			mic = key->key + NL80211_TKIP_DATA_OFFSET_RX_MIC_KEY;
++
++		if (!group)
++			nss_wifi_vdev_security(arvif->nss_ifnum, key->cipher);
++
++		if (nss_peer_id) {
++			nss_wifi_peer_security(ab->nss_soc, nss_peer_id, group,
++					       key->cipher, mic);
++			nss_wifi_peer_authorize(ab->nss_soc, nss_peer_id);
++		}
++	}
++
+ exit:
+ 	mutex_unlock(&ar->conf_mutex);
+ 	return ret;
diff --git a/package/kernel/mac80211/patches/nss-wifi/906-ath11k-let-a-supplicant-see-an-offloaded-key-exchange.patch b/package/kernel/mac80211/patches/nss-wifi/906-ath11k-let-a-supplicant-see-an-offloaded-key-exchange.patch
new file mode 100644
index 0000000000..1f60e93d14
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/906-ath11k-let-a-supplicant-see-an-offloaded-key-exchange.patch
@@ -0,0 +1,47 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: let a supplicant see an offloaded key exchange
+
+An offloaded frame is delivered on the virtual device's network device and
+never enters mac80211, so the control port mac80211 offers over netlink
+carries nothing once the NSS firmware owns the data path. A supplicant that
+takes the offer stops reading the interface, and the key exchange it is
+waiting for arrives somewhere it is no longer looking: no station reaches
+authorised, whatever the firmware does with the frames.
+
+The capability is a wiphy feature bit and mac80211 sets it for every driver,
+so it is withdrawn here rather than in mac80211, and only while the offload
+is on. A supplicant then falls back to the interface itself, which is where
+the frames are.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+Index: backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
+===================================================================
+--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/mac.c
++++ backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
+@@ -10826,6 +10826,25 @@ static int __ath11k_mac_register(struct
+ 	    ab->hw_params.bios_sar_capa)
+ 		ar->hw->wiphy->sar_capa = ab->hw_params.bios_sar_capa;
+ 
++	/* Before registration, because the capability is read off the wiphy
++	 * once it is published.
++	 */
++	if (ab->nss_offload) {
++		static const enum nl80211_ext_feature_index over_nl[] = {
++			NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211,
++			NL80211_EXT_FEATURE_CONTROL_PORT_NO_PREAUTH,
++			NL80211_EXT_FEATURE_CONTROL_PORT_OVER_NL80211_TX_STATUS,
++		};
++		struct wiphy *wiphy = ar->hw->wiphy;
++		int f;
++
++		for (f = 0; f < ARRAY_SIZE(over_nl); f++) {
++			enum nl80211_ext_feature_index ft = over_nl[f];
++
++			wiphy->ext_features[ft / 8] &= ~BIT(ft % 8);
++		}
++	}
++
+ 	ret = ieee80211_register_hw(ar->hw);
+ 	if (ret) {
+ 		ath11k_err(ar->ab, "ieee80211 registration failed: %d\n", ret);
diff --git a/package/kernel/mac80211/patches/nss-wifi/907-ath11k-let-the-flow-table-reach-the-NSS-firmware.patch b/package/kernel/mac80211/patches/nss-wifi/907-ath11k-let-the-flow-table-reach-the-NSS-firmware.patch
new file mode 100644
index 0000000000..3c711131ee
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/907-ath11k-let-the-flow-table-reach-the-NSS-firmware.patch
@@ -0,0 +1,84 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: let the flow table reach the NSS firmware
+
+The kernel offers a flow it has accepted into its software fast path to
+whatever hardware is registered on the device the flow arrives at, through
+that device's traffic-control entry point. For a wireless interface the
+subsystem forwards that to the driver of the radio, and a driver with
+nothing to say returns a refusal, which is why nothing has ever been
+offered a wireless flow.
+
+Answering it is what lets the firmware carry a station's connections
+instead of exceptioning every packet of them to the host. Only the flow
+table's own block is taken, and only while the offload owns the data path;
+everything else is refused exactly as before.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+Index: backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
+===================================================================
+--- backports-7.2.orig/drivers/net/wireless/ath/ath11k/mac.c
++++ backports-7.2/drivers/net/wireless/ath/ath11k/mac.c
+@@ -10254,6 +10254,53 @@ static int ath11k_mac_op_sta_state(struc
+ 	return ret;
+ }
+ 
++static int ath11k_mac_op_net_setup_tc(struct ieee80211_hw *hw,
++				      struct ieee80211_vif *vif,
++				      struct net_device *dev,
++				      enum tc_setup_type type, void *type_data)
++{
++	struct ath11k *ar = hw->priv;
++
++	/* Frames only bypass the host while the firmware owns the rings, so a
++	 * rule pushed at any other time would be one no hardware acts on.
++	 */
++	if (!ar->ab->nss_offload)
++		return -EOPNOTSUPP;
++
++	switch (type) {
++	case TC_SETUP_FT:
++		return nss_flow_setup_block(dev, type_data);
++	default:
++		return -EOPNOTSUPP;
++	}
++}
++
++/* The path resolver walks from the bridge to the port that owns the
++ * destination and asks that port's driver whether the path ends there.
++ * Under the offload it does - the firmware transmits on the interface
++ * itself - and saying so is what lets a station's flow carry its real
++ * ingress instead of the bridge's, which is nothing the firmware knows.
++ * The subsystem only asks once it has resolved the destination to a
++ * station it holds.
++ */
++static int ath11k_mac_op_net_fill_forward_path(struct ieee80211_hw *hw,
++					       struct ieee80211_vif *vif,
++					       struct ieee80211_sta *sta,
++					       struct net_device_path_ctx *ctx,
++					       struct net_device_path *path)
++{
++	struct ath11k_vif *arvif = ath11k_vif_to_arvif(vif);
++
++	if (!arvif->ar->ab->nss_offload || arvif->nss_ifnum < 0)
++		return -EOPNOTSUPP;
++
++	path->type = DEV_PATH_ETHERNET;
++	path->dev = ctx->dev;
++	ctx->dev = NULL;
++
++	return 0;
++}
++
+ static const struct ieee80211_ops ath11k_ops = {
+ 	.tx				= ath11k_mac_op_tx,
+ 	.wake_tx_queue			= ieee80211_handle_wake_tx_queue,
+@@ -10291,6 +10338,8 @@ static const struct ieee80211_ops ath11k
+ 	.flush				= ath11k_mac_op_flush,
+ 	.flush_sta			= ath11k_mac_op_flush_sta,
+ 	.sta_statistics			= ath11k_mac_op_sta_statistics,
++	.net_setup_tc			= ath11k_mac_op_net_setup_tc,
++	.net_fill_forward_path		= ath11k_mac_op_net_fill_forward_path,
+ 	CFG80211_TESTMODE_CMD(ath11k_tm_cmd)
