diff --git a/package/kernel/mac80211/patches/ath11k/953-wifi-ath11k-apply-the-160-MHz-NSS-ratio-to-the-radio.patch b/package/kernel/mac80211/patches/ath11k/953-wifi-ath11k-apply-the-160-MHz-NSS-ratio-to-the-radio.patch
new file mode 100644
index 0000000000..f4d63b5ec3
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/953-wifi-ath11k-apply-the-160-MHz-NSS-ratio-to-the-radio.patch
@@ -0,0 +1,87 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Sun, 11 Oct 2026 12:29:20 +0200
+Subject: [PATCH] wifi: ath11k: apply the 160 MHz NSS ratio to the radio
+
+The firmware reports the NSS a radio supports at 160 MHz as a ratio of
+its 80 MHz NSS. Peer assoc applies that ratio to the peer's NSS instead,
+so on a radio with a 1:2 ratio a two-stream peer is sent one stream at
+160 MHz. The HE 160 and 80+80 MCS maps copy the 80 MHz map, so a
+4-chain radio with that ratio offers 4 streams at 160 MHz where it
+supports 2.
+
+Take the 160 MHz NSS from the radio's TX chains, as ath12k does since
+commit a82ce08775bc ("wifi: ath12k: add extended NSS bandwidth support
+for 160 MHz"), and limit the 160 and 80+80 MCS maps to the ratio when
+the firmware reports one.
+
+Tested-on: IPQ8074 hw2.0 AHB WLAN.HK.2.9.0.1-02146-QCAHKSWPL_SILICONZ-1
+
+Link: https://lore.kernel.org/all/20261011123631.1664734-1-julius@bairaktaris.de/
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+ drivers/net/wireless/ath/ath11k/mac.c |   24 +++++++++++++++++-------
+ 1 file changed, 17 insertions(+), 7 deletions(-)
+
+--- a/drivers/net/wireless/ath/ath11k/mac.c
++++ b/drivers/net/wireless/ath/ath11k/mac.c
+@@ -2261,7 +2261,7 @@ static void ath11k_peer_assoc_h_vht(stru
+ 
+ 	if (arg->peer_phymode == MODE_11AC_VHT160 ||
+ 	    arg->peer_phymode == MODE_11AC_VHT80_80) {
+-		tx_nss = ath11k_get_nss_160mhz(ar, max_nss);
++		tx_nss = ath11k_get_nss_160mhz(ar, ar->num_tx_chains);
+ 		rx_nss = min(arg->peer_nss, tx_nss);
+ 		arg->peer_bw_rxnss_override = ATH11K_BW_NSS_MAP_ENABLE;
+ 
+@@ -2571,7 +2571,7 @@ static void ath11k_peer_assoc_h_he(struc
+ 
+ 	if (arg->peer_phymode == MODE_11AX_HE160 ||
+ 	    arg->peer_phymode == MODE_11AX_HE80_80) {
+-		tx_nss = ath11k_get_nss_160mhz(ar, max_nss);
++		tx_nss = ath11k_get_nss_160mhz(ar, ar->num_tx_chains);
+ 		rx_nss = min(arg->peer_nss, tx_nss);
+ 		arg->peer_bw_rxnss_override = ATH11K_BW_NSS_MAP_ENABLE;
+ 
+@@ -5923,7 +5923,7 @@ static void ath11k_mac_set_hemcsmap(stru
+ 				    struct ieee80211_sta_he_cap *he_cap,
+ 				    int band)
+ {
+-	u16 txmcs_map, rxmcs_map;
++	u16 txmcs_map, rxmcs_map, txmcs_map_160, rxmcs_map_160;
+ 	u32 i;
+ 
+ 	rxmcs_map = 0;
+@@ -5941,18 +5941,28 @@ static void ath11k_mac_set_hemcsmap(stru
+ 		else
+ 			rxmcs_map |= IEEE80211_HE_MCS_NOT_SUPPORTED << (i * 2);
+ 	}
++
++	txmcs_map_160 = txmcs_map;
++	rxmcs_map_160 = rxmcs_map;
++	if (cap->nss_ratio_enabled) {
++		for (i = ath11k_get_nss_160mhz(ar, ar->num_tx_chains); i < 8; i++)
++			txmcs_map_160 |= IEEE80211_HE_MCS_NOT_SUPPORTED << (i * 2);
++		for (i = ath11k_get_nss_160mhz(ar, ar->num_rx_chains); i < 8; i++)
++			rxmcs_map_160 |= IEEE80211_HE_MCS_NOT_SUPPORTED << (i * 2);
++	}
++
+ 	he_cap->he_mcs_nss_supp.rx_mcs_80 =
+ 		cpu_to_le16(rxmcs_map & 0xffff);
+ 	he_cap->he_mcs_nss_supp.tx_mcs_80 =
+ 		cpu_to_le16(txmcs_map & 0xffff);
+ 	he_cap->he_mcs_nss_supp.rx_mcs_160 =
+-		cpu_to_le16(rxmcs_map & 0xffff);
++		cpu_to_le16(rxmcs_map_160);
+ 	he_cap->he_mcs_nss_supp.tx_mcs_160 =
+-		cpu_to_le16(txmcs_map & 0xffff);
++		cpu_to_le16(txmcs_map_160);
+ 	he_cap->he_mcs_nss_supp.rx_mcs_80p80 =
+-		cpu_to_le16(rxmcs_map & 0xffff);
++		cpu_to_le16(rxmcs_map_160);
+ 	he_cap->he_mcs_nss_supp.tx_mcs_80p80 =
+-		cpu_to_le16(txmcs_map & 0xffff);
++		cpu_to_le16(txmcs_map_160);
+ }
+ 
+ static int ath11k_mac_copy_he_cap(struct ath11k *ar,
diff --git a/package/kernel/mac80211/patches/nss-wifi/900-ath11k-describe-the-data-path-rings-to-the-NSS-firmware.patch b/package/kernel/mac80211/patches/nss-wifi/900-ath11k-describe-the-data-path-rings-to-the-NSS-firmware.patch
new file mode 100644
index 0000000000..87682ef06f
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/900-ath11k-describe-the-data-path-rings-to-the-NSS-firmware.patch
@@ -0,0 +1,269 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: describe the data-path rings to the NSS firmware
+
+The NSS cores can reap the WLAN hardware's rings themselves, which takes
+the Wi-Fi data path off the host entirely, but they have to be told where
+those rings are. Everything needed is already known where the data path is
+set up, so copy it into a plain description and hand it over once.
+
+Describing is not handing over. The firmware is started by a separate
+deliberate act, and until then this driver owns its rings exactly as
+before, which is what keeps an image carrying this at stock behaviour.
+
+The one value that is converted rather than copied is the ring register
+address: the offsets this driver keeps are into its own mapping, and the
+firmware has no such mapping, so they go over with the register window's
+physical base added.
+
+The description also carries this driver's own hw-restart. The firmware's
+buffers sit in these rings, so a firmware that stops is freed only after
+the radios have stopped, and it restarts on the rings described next.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/dp.c
++++ b/drivers/net/wireless/ath/ath11k/dp.c
+@@ -13,6 +13,12 @@
+ #include "dp_rx.h"
+ #include "peer.h"
+ 
++#include <linux/platform_device.h>
++#include <linux/soc/qcom/nss_wifi.h>
++
++#define ATH11K_NSS_TARGET_IPQ8074	24
++#define ATH11K_NSS_TARGET_IPQ6018	25
++
+ static void ath11k_dp_htt_htc_tx_complete(struct ath11k_base *ab,
+ 					  struct sk_buff *skb)
+ {
+@@ -869,6 +875,174 @@ done:
+ }
+ EXPORT_SYMBOL(ath11k_dp_service_srng);
+ 
++/* Describe this data path to the NSS firmware driver.
++ *
++ * The firmware can reap these rings itself, which takes the Wi-Fi data path
++ * off the host entirely, but it has to be told where they are. Everything it
++ * needs is already known here, so it is copied into a plain description and
++ * handed over once. Nothing is given away by describing it: the firmware is
++ * started by a separate deliberate act, and until then this driver owns its
++ * rings exactly as before.
++ *
++ * The ring register addresses this driver keeps are offsets into its own
++ * mapping, and the firmware has no such mapping - it writes them as absolute
++ * addresses. So they are handed over with the register window's physical base
++ * added, which is the one thing here that has to be converted rather than
++ * copied.
++ */
++/* The buffer manager the firmware names in a receive buffer it fills, as a
++ * release ring number. Read off the entries it writes, not assumed.
++ */
++
++/* The target as the firmware enumerates it, which is its own numbering and
++ * not this driver's hardware revision. The NSS firmware drives only the
++ * radios inside the SoC.
++ */
++static u32 ath11k_nss_target(struct ath11k_base *ab)
++{
++	switch (ab->hw_rev) {
++	case ATH11K_HW_IPQ8074:
++		return ATH11K_NSS_TARGET_IPQ8074;
++	case ATH11K_HW_IPQ6018_HW10:
++		return ATH11K_NSS_TARGET_IPQ6018;
++	default:
++		return 0;
++	}
++}
++
++static void ath11k_nss_wifi_ring(struct nss_wifi_ring *r,
++				 struct ath11k_base *ab, u32 ring_id,
++				 u32 reg_base)
++{
++	struct hal_srng *srng = &ab->hal.srng_list[ring_id];
++
++	r->id = srng->ring_id;
++	r->dir = srng->ring_dir;
++	r->num_entries = srng->num_entries;
++	r->entry_size = srng->entry_size;
++	r->flags = srng->flags;
++	r->base = srng->ring_base_paddr;
++	r->hwreg[0] = reg_base + srng->hwreg_base[0];
++	r->hwreg[1] = reg_base + srng->hwreg_base[1];
++}
++
++/* ath11k's own hw-restart. The NSS firmware's buffers sit in these rings, so
++ * a firmware that stops is freed and started again behind it.
++ */
++static void ath11k_nss_reset(void *priv)
++{
++	struct ath11k_base *ab = priv;
++
++	queue_work(ab->workqueue_aux, &ab->reset_work);
++}
++
++static void ath11k_nss_wifi_describe(struct ath11k_base *ab)
++{
++	struct ath11k_dp *dp = &ab->dp;
++	struct nss_wifi_soc *soc;
++	struct resource *res;
++	u32 reg_base;
++	int i;
++
++	if (!ath11k_nss_target(ab))
++		return;
++
++	res = platform_get_resource(to_platform_device(ab->dev),
++				    IORESOURCE_MEM, 0);
++	if (!res)
++		return;
++
++	reg_base = res->start;
++
++	soc = kzalloc(sizeof(*soc), GFP_KERNEL);
++	if (!soc)
++		return;
++
++	soc->dev_base = reg_base;
++	soc->shadow_rd = ab->hal.rdp.paddr;
++	soc->shadow_wr = ab->hal.wrp.paddr;
++	soc->lmac_ring_start = HAL_SRNG_RING_ID_LMAC1_ID_START;
++	soc->target_type = ath11k_nss_target(ab);
++	soc->tlv_size = ab->hw_params.hal_desc_sz;
++	soc->rx_buf_len = DP_RX_BUFFER_SIZE;
++	soc->num_tcl = ab->hw_params.hal_params->num_tx_rings;
++	soc->num_reo = DP_REO_DST_RING_MAX;
++	soc->num_pdevs = ab->num_radios;
++	soc->priv = ab;
++	soc->reset = ath11k_nss_reset;
++
++	for (i = 0; i < soc->num_tcl; i++) {
++		ath11k_nss_wifi_ring(&soc->tcl[i], ab,
++				     dp->tx_ring[i].tcl_data_ring.ring_id,
++				     reg_base);
++		ath11k_nss_wifi_ring(&soc->txcomp[i], ab,
++				     dp->tx_ring[i].tcl_comp_ring.ring_id,
++				     reg_base);
++	}
++
++	for (i = 0; i < soc->num_reo; i++)
++		ath11k_nss_wifi_ring(&soc->reo_dest[i], ab,
++				     dp->reo_dst_ring[i].ring_id, reg_base);
++
++	ath11k_nss_wifi_ring(&soc->reo_reinject, ab,
++			     dp->reo_reinject_ring.ring_id, reg_base);
++	/* Not the release ring this driver reaps. The firmware fills the
++	 * receive-DMA ring from its own pool and names those buffers with its
++	 * own buffer manager, and the buffer manager is what decides which
++	 * release ring the hardware hands a buffer back on. Handing over the
++	 * ring the buffers name is the one the driver already owns: the value
++	 * the firmware writes into a receive entry is a buffer-manager id, and
++	 * a manager id is the release ring's number plus the first software
++	 * manager, not the number itself.
++	 */
++	ath11k_nss_wifi_ring(&soc->rx_rel, ab, dp->rx_rel_ring.ring_id,
++			     reg_base);
++	ath11k_nss_wifi_ring(&soc->reo_exception, ab,
++			     dp->reo_except_ring.ring_id, reg_base);
++
++	ab->nss_soc = nss_wifi_soc_register(soc);
++	if (ab->nss_soc < 0)
++		ath11k_warn(ab, "NSS firmware would not take the ring description\n");
++
++	kfree(soc);
++}
++
++
++static void ath11k_nss_wifi_describe_pdev(struct ath11k_base *ab, int id)
++{
++	struct ath11k *ar = ab->pdevs[id].ar;
++	struct nss_wifi_pdev pdev = {};
++	struct resource *res;
++
++	if (ab->nss_soc < 0)
++		return;
++
++	res = platform_get_resource(to_platform_device(ab->dev),
++				    IORESOURCE_MEM, 0);
++	if (!res)
++		return;
++
++	ath11k_nss_wifi_ring(&pdev.rxdma, ab,
++			     ar->dp.rx_refill_buf_ring.refill_buf_ring.ring_id,
++			     res->start);
++	pdev.radio_id = id;
++	/* The hardware MAC this radio's address-search table belongs to. The
++	 * transmit command carries it, and the search for a frame's peer runs
++	 * against that table alone, so a radio whose index is not its own
++	 * hardware MAC finds nothing and every frame is released unsent.
++	 */
++	pdev.lmac_id = ar->lmac_id;
++	/* The firmware holds a software descriptor for every buffer in flight,
++	 * so a pool the size of the ring cannot keep the ring full. It accepts
++	 * up to three ring depths.
++	 */
++	pdev.num_rx_swdesc = 3 * DP_RXDMA_BUF_RING_SIZE;
++	pdev.target_pdev_id = ar->pdev->pdev_id;
++
++	if (nss_wifi_pdev_register(ab->nss_soc, &pdev))
++		ath11k_warn(ab, "NSS firmware would not take radio %d\n", id);
++}
++
+ void ath11k_dp_pdev_free(struct ath11k_base *ab)
+ {
+ 	struct ath11k *ar;
+@@ -914,6 +1088,14 @@ int ath11k_dp_pdev_alloc(struct ath11k_b
+ 	int ret;
+ 	int i;
+ 
++	/* Not from where the rest of the SoC's rings are allocated: the
++	 * reorder destination rings are set up later than that, and a
++	 * description taken there carries them as an address of zero with no
++	 * entries. The firmware accepts that, but neither receive nor transmit
++	 * completions then move.
++	 */
++	ath11k_nss_wifi_describe(ab);
++
+ 	/* TODO:Per-pdev rx ring unlike tx ring which is mapped to different AC's */
+ 	for (i = 0; i < ab->num_radios; i++) {
+ 		ar = ab->pdevs[i].ar;
+@@ -929,6 +1111,8 @@ int ath11k_dp_pdev_alloc(struct ath11k_b
+ 				    i);
+ 			goto err;
+ 		}
++
++		ath11k_nss_wifi_describe_pdev(ab, i);
+ 	}
+ 
+ 	return 0;
+@@ -1025,6 +1209,10 @@ void ath11k_dp_free(struct ath11k_base *
+ 	struct ath11k_dp *dp = &ab->dp;
+ 	int i;
+ 
++	if (ab->nss_soc >= 0)
++		nss_wifi_soc_unregister(ab->nss_soc);
++	ab->nss_soc = -1;
++
+ 	ath11k_dp_link_desc_cleanup(ab, dp->link_desc_banks,
+ 				    HAL_WBM_IDLE_LINK, &dp->wbm_idle_ring);
+ 
+--- a/drivers/net/wireless/ath/ath11k/core.c
++++ b/drivers/net/wireless/ath/ath11k/core.c
+@@ -2962,6 +2962,7 @@ struct ath11k_base *ath11k_core_alloc(st
+ 	init_completion(&ab->restart_completed);
+ 
+ 	ab->dev = dev;
++	ab->nss_soc = -1;
+ 	ab->hif.bus = bus;
+ 
+ 	return ab;
+--- a/drivers/net/wireless/ath/ath11k/core.h
++++ b/drivers/net/wireless/ath/ath11k/core.h
+@@ -935,6 +935,8 @@ struct ath11k_base {
+ 	struct ath11k_wmi_base wmi_ab;
+ 	struct completion fw_ready;
+ 	int num_radios;
++	/* The NSS firmware's instance for these radios, or negative. */
++	int nss_soc;
+ 	/* HW channel counters frequency value in hertz common to all MACs */
+ 	u32 cc_freq_hz;
+ 
diff --git a/package/kernel/mac80211/patches/nss-wifi/901-ath11k-stop-driving-the-rings-the-NSS-firmware-owns.patch b/package/kernel/mac80211/patches/nss-wifi/901-ath11k-stop-driving-the-rings-the-NSS-firmware-owns.patch
new file mode 100644
index 0000000000..869bf066d6
--- /dev/null
+++ b/package/kernel/mac80211/patches/nss-wifi/901-ath11k-stop-driving-the-rings-the-NSS-firmware-owns.patch
@@ -0,0 +1,193 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] ath11k: stop driving the rings the NSS firmware owns
+
+The NSS firmware reaps and fills the data-path rings once its Wi-Fi data
+plane is started, so this driver has to be off them before it is. It is not
+enough to stop servicing them: a frame this driver puts on the transmit ring
+completes with a software cookie the firmware resolves against its own
+descriptor table, and a buffer this driver puts in the receive-DMA ring comes
+back under a cookie the firmware never minted.
+
+nss_offload, off by default, is read once at probe. Interrupt registration,
+the data-path service loop and the MSI group lookup are all driven from
+hw_params.ring_mask, which is a pointer inside a per-device copy of the
+hardware table, so pointing it at a copy carrying only the reorder-status mask
+is the whole of the handover for the seven it drops. The
+receive-DMA pre-fill is skipped, hash-based receive steering is off because
+the firmware pairs one reorder-destination ring with one radio's buffer pool,
+and transmit is refused at the single site that produces an entry. The
+reorder engine sends an unhashed frame to the ring its first destination
+map gives the peer's default route, and that map is set so route n is
+REO2SWn: the firmware reaps one ring per radio, REO2SW1 upward, and the
+hash pattern sent the second radio's frames to REO2SW3, which nothing
+reaps.
+
+Management frames leave over WMI above the refusal, so a station still
+associates. No data crosses the air while the offload is on.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/drivers/net/wireless/ath/ath11k/core.c
++++ b/drivers/net/wireless/ath/ath11k/core.c
+@@ -38,6 +38,22 @@ bool ath11k_ftm_mode;
+ module_param_named(ftm_mode, ath11k_ftm_mode, bool, 0444);
+ MODULE_PARM_DESC(ftm_mode, "Boots up in factory test mode");
+ 
++bool ath11k_nss_offload;
++module_param_named(nss_offload, ath11k_nss_offload, bool, 0644);
++MODULE_PARM_DESC(nss_offload, "Hand the data-path rings to the NSS firmware");
++
++bool ath11k_nss_keep_mask;
++module_param_named(nss_keep_mask, ath11k_nss_keep_mask, bool, 0644);
++MODULE_PARM_DESC(nss_keep_mask, "Leave the ring mask alone while offloading");
++
++bool ath11k_nss_hash;
++module_param_named(nss_hash, ath11k_nss_hash, bool, 0644);
++MODULE_PARM_DESC(nss_hash, "Keep hash-based receive steering while offloading");
++
++bool ath11k_nss_prefill;
++module_param_named(nss_prefill, ath11k_nss_prefill, bool, 0644);
++MODULE_PARM_DESC(nss_prefill, "Fill the receive-DMA ring from here as well");
++
