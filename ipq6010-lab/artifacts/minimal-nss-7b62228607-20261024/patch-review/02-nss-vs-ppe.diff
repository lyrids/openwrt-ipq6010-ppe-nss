++ * @IEEE80211_MESH_PATH_OFFLD_CMD_DELETE_MPATH: path deleted
++ * @IEEE80211_MESH_PATH_OFFLD_CMD_ADD_MPP: proxy added
++ * @IEEE80211_MESH_PATH_OFFLD_CMD_UPDATE_MPP: proxy changed
++ * @IEEE80211_MESH_PATH_OFFLD_CMD_DELETE_MPP: proxy deleted
++ */
++enum ieee80211_mesh_path_offld_cmd {
++	IEEE80211_MESH_PATH_OFFLD_CMD_ADD_MPATH,
++	IEEE80211_MESH_PATH_OFFLD_CMD_UPDATE_MPATH,
++	IEEE80211_MESH_PATH_OFFLD_CMD_DELETE_MPATH,
++	IEEE80211_MESH_PATH_OFFLD_CMD_ADD_MPP,
++	IEEE80211_MESH_PATH_OFFLD_CMD_UPDATE_MPP,
++	IEEE80211_MESH_PATH_OFFLD_CMD_DELETE_MPP,
++};
++
++/**
++ * enum ieee80211_mesh_path_offld_action - mesh path event from a device
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_REFRESH: path in use, refresh it
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_DEL: path to a proxied address
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_EXP: path expired
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_LEARN: proxy learned, not yet added
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_ADD: proxy added by the device
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_UPDATE: proxy changed or in use
++ * @IEEE80211_MESH_PATH_OFFLD_ACTION_PATH_NOT_FOUND: no path to a destination
++ */
++enum ieee80211_mesh_path_offld_action {
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_REFRESH,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_DEL,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_EXP,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_LEARN,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_ADD,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_UPDATE,
++	IEEE80211_MESH_PATH_OFFLD_ACTION_PATH_NOT_FOUND,
++};
++
++#define IEEE80211_MESH_PATH_ACTIVE	BIT(0)
++#define IEEE80211_MESH_PATH_RESOLVING	BIT(1)
++#define IEEE80211_MESH_PATH_FIXED	BIT(3)
++#define IEEE80211_MESH_PATH_RESOLVED	BIT(4)
