diff --git a/package/kernel/mac80211/patches/nss-wifi/903-ath11k-hand-data-frames-to-the-NSS-firmware.patch b/package/kernel/mac80211/patches/nss-wifi/903-ath11k-hand-data-frames-to-the-NSS-firmware.patch
