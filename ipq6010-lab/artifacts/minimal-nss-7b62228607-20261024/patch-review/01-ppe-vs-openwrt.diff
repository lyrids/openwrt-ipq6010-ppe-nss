@@ -0,0 +1,79 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Sun, 4 Oct 2026 15:20:14 +0200
+Subject: [PATCH] net/mlx5e: Ignore FLOW_ACTION_PRIORITY on flowtable offload
+
+The next patch makes the flowtable emit FLOW_ACTION_PRIORITY for flows
+with a non-zero skb->priority, which on IPv4 includes the priority
+ip_forward() derives from the TOS by default. mlx5 would reject these
+rules and stop offloading flows it offloads today.
+
+The eswitch does not use skb->priority for these flows, so accept the
+action on flowtable flows and ignore it. tc flower rules with skbedit
+priority are still rejected.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+ .../net/ethernet/mellanox/mlx5/core/Makefile  |  2 +-
+ .../mellanox/mlx5/core/en/tc/act/act.c        |  1 +
+ .../mellanox/mlx5/core/en/tc/act/act.h        |  1 +
+ .../mellanox/mlx5/core/en/tc/act/prio.c       | 22 +++++++++++++++++++
+ 4 files changed, 25 insertions(+), 1 deletion(-)
+ create mode 100644 drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/prio.c
+
+--- a/drivers/net/ethernet/mellanox/mlx5/core/Makefile
++++ b/drivers/net/ethernet/mellanox/mlx5/core/Makefile
+@@ -53,7 +53,7 @@ mlx5_core-$(CONFIG_MLX5_CLS_ACT)     +=
+ 					en/tc/act/accept.o en/tc/act/mark.o en/tc/act/goto.o \
+ 					en/tc/act/tun.o en/tc/act/csum.o en/tc/act/pedit.o \
+ 					en/tc/act/vlan.o en/tc/act/vlan_mangle.o en/tc/act/mpls.o \
+-					en/tc/act/mirred.o en/tc/act/mirred_nic.o \
++					en/tc/act/mirred.o en/tc/act/mirred_nic.o en/tc/act/prio.o \
+ 					en/tc/act/ct.o en/tc/act/sample.o en/tc/act/ptype.o \
+ 					en/tc/act/redirect_ingress.o en/tc/act/police.o
+ 
+--- a/drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/act.c
++++ b/drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/act.c
+@@ -23,6 +23,7 @@ static struct mlx5e_tc_act *tc_acts_fdb[
+ 	[FLOW_ACTION_ADD] = &mlx5e_tc_act_pedit,
+ 	[FLOW_ACTION_CSUM] = &mlx5e_tc_act_csum,
+ 	[FLOW_ACTION_PTYPE] = &mlx5e_tc_act_ptype,
++	[FLOW_ACTION_PRIORITY] = &mlx5e_tc_act_prio,
+ 	[FLOW_ACTION_SAMPLE] = &mlx5e_tc_act_sample,
+ 	[FLOW_ACTION_POLICE] = &mlx5e_tc_act_police,
+ 	[FLOW_ACTION_CT] = &mlx5e_tc_act_ct,
+--- a/drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/act.h
++++ b/drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/act.h
+@@ -81,6 +81,7 @@ extern struct mlx5e_tc_act mlx5e_tc_act_
+ extern struct mlx5e_tc_act mlx5e_tc_act_tun_encap;
+ extern struct mlx5e_tc_act mlx5e_tc_act_tun_decap;
+ extern struct mlx5e_tc_act mlx5e_tc_act_csum;
++extern struct mlx5e_tc_act mlx5e_tc_act_prio;
+ extern struct mlx5e_tc_act mlx5e_tc_act_pedit;
+ extern struct mlx5e_tc_act mlx5e_tc_act_vlan;
+ extern struct mlx5e_tc_act mlx5e_tc_act_vlan_mangle;
+--- /dev/null
++++ b/drivers/net/ethernet/mellanox/mlx5/core/en/tc/act/prio.c
+@@ -0,0 +1,22 @@
++// SPDX-License-Identifier: GPL-2.0 OR Linux-OpenIB
++
++#include "act.h"
++#include "en/tc_priv.h"
++
++static int
++tc_act_parse_prio(struct mlx5e_tc_act_parse_state *parse_state,
++		  const struct flow_action_entry *act,
++		  struct mlx5e_priv *priv,
++		  struct mlx5_flow_attr *attr)
++{
++	/* The eswitch does not apply skb->priority to flowtable flows. */
++	if (mlx5e_is_ft_flow(parse_state->flow))
++		return 0;
++
++	NL_SET_ERR_MSG_MOD(parse_state->extack, "skbedit priority is not supported");
++	return -EOPNOTSUPP;
++}
++
++struct mlx5e_tc_act mlx5e_tc_act_prio = {
++	.parse_action = tc_act_parse_prio,
++};
diff --git a/target/linux/generic/pending-6.18/708-01-netfilter-flowtable-teardown-direct-xmit-flows-when-the-fdb-entry-moves.patch b/target/linux/generic/pending-6.18/708-01-netfilter-flowtable-teardown-direct-xmit-flows-when-the-fdb-entry-moves.patch
new file mode 100644
index 0000000000..251f5b9501
--- /dev/null
+++ b/target/linux/generic/pending-6.18/708-01-netfilter-flowtable-teardown-direct-xmit-flows-when-the-fdb-entry-moves.patch
@@ -0,0 +1,294 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Fri, 2 Oct 2026 23:30:00 +0200
+Subject: [PATCH] netfilter: flowtable: tear down direct xmit flows when the
+ fdb entry moves
+
+A direct xmit flow that reaches a bridge port keeps sending to that port
+when the host moves to another port of the bridge, and packets from the
+other side keep the flow from timing out.
+
+The gc now checks the fdb entry through nf_br_utils_hook and tears the
+flow down when the entry points to another port. An entry that aged out
+does not tear it down, because offloaded packets do not refresh it.
+
+The bridge port is found from out.hw_ifidx through the vlan devices that
+the forward path has below the port. The vid is the bridge vlan in the
+encap stack, or the pvid of the port for an untagged port of a
+vlan_filtering bridge.
+
+Reported-by: Eric Woudstra <ericwouds@gmail.com>
+Link: https://lore.kernel.org/netfilter-devel/20250925182623.114045-1-ericwouds@gmail.com/
+Link: https://lore.kernel.org/netfilter-devel/20261017235849.1066624-2-julius@bairaktaris.de/
+Co-developed-by: Pablo Neira Ayuso <pablo@netfilter.org>
+Signed-off-by: Pablo Neira Ayuso <pablo@netfilter.org>
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/include/net/netfilter/nf_flow_table.h
++++ b/include/net/netfilter/nf_flow_table.h
+@@ -136,7 +136,10 @@ struct flow_offload_tuple {
+ 	u8				dir:2,
+ 					xmit_type:3,
+ 					encap_num:2,
+-					in_vlan_ingress:2;
++					in_vlan_ingress:2,
++					bridge_path:1,
++					bridge_vlan:1,
++					port_vlans:2;
+ 	u16				mtu;
