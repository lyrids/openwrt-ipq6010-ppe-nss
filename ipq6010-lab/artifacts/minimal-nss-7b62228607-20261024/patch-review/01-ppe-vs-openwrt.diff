diff --git a/target/linux/qualcommax/patches-6.18/0957-net-dsa-tag_oob-drop-a-frame-whose-tag-cannot-be-added.patch b/target/linux/qualcommax/patches-6.18/0957-net-dsa-tag_oob-drop-a-frame-whose-tag-cannot-be-added.patch
new file mode 100644
index 0000000000..7ff257d19a
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/0957-net-dsa-tag_oob-drop-a-frame-whose-tag-cannot-be-added.patch
@@ -0,0 +1,22 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] net: dsa: tag_oob: drop a frame whose tag cannot be added
+
+skb_ext_add() allocates with GFP_ATOMIC and returns NULL when that
+fails, and oob_tag_xmit() then writes the port through the NULL
+pointer. Return NULL instead, so the core drops the frame.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/net/dsa/tag_oob.c
++++ b/net/dsa/tag_oob.c
+@@ -16,6 +16,9 @@ static struct sk_buff *oob_tag_xmit(stru
+ 	struct dsa_oob_tag_info *tag_info = skb_ext_add(skb, SKB_EXT_DSA_OOB);
+ 	struct dsa_port *dp = dsa_user_to_port(dev);
+ 
++	if (!tag_info)
++		return NULL;
++
+ 	tag_info->port = dp->index;
+ 
+ 	return skb;
diff --git a/target/linux/qualcommax/patches-6.18/0966-net-dsa-tag_oob-let-the-switch-send-frames-it-routed-to-the-CPU.patch b/target/linux/qualcommax/patches-6.18/0966-net-dsa-tag_oob-let-the-switch-send-frames-it-routed-to-the-CPU.patch
new file mode 100644
index 0000000000..265559368d
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/0966-net-dsa-tag_oob-let-the-switch-send-frames-it-routed-to-the-CPU.patch
@@ -0,0 +1,61 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] net: dsa: tag_oob: let the switch send frames it routed to the CPU
+
+A switch that routes a flow in hardware towards a device it cannot reach
+delivers the finished frame to the CPU port, marked with the flow it
+matched. Add a tagger_data hook, set through connect_tag_protocol, that
+lets the switch driver send such a frame on to the flow's egress device.
+
+Assisted-by: Claude:claude-opus-5-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+--- a/include/linux/dsa/oob.h
++++ b/include/linux/dsa/oob.h
+@@ -7,10 +7,18 @@
+ 
+ #include <linux/skbuff.h>
+ 
++struct dsa_switch;
++
+ struct dsa_oob_tag_info {
+ 	u16 port;
+ };
+ 
++/* Set by the switch driver in connect_tag_protocol */
++struct dsa_oob_tagger_data {
++	bool (*flow_xmit)(struct dsa_switch *ds, struct sk_buff *skb,
++			  u32 flow);
++};
++
+ int dsa_oob_tag_push(struct sk_buff *skb, struct dsa_oob_tag_info *ti);
+ int dsa_oob_tag_pop(struct sk_buff *skb, struct dsa_oob_tag_info *ti);
+ #endif
+--- a/net/dsa/tag_oob.c
++++ b/net/dsa/tag_oob.c
+@@ -39,11 +39,27 @@ static struct sk_buff *oob_tag_rcv(struc
+ 	return skb;
+ }
+ 
++static int oob_connect(struct dsa_switch *ds)
++{
++	ds->tagger_data = kzalloc(sizeof(struct dsa_oob_tagger_data),
++				  GFP_KERNEL);
++
++	return ds->tagger_data ? 0 : -ENOMEM;
++}
++
++static void oob_disconnect(struct dsa_switch *ds)
++{
++	kfree(ds->tagger_data);
++	ds->tagger_data = NULL;
++}
++
+ static const struct dsa_device_ops oob_tag_dsa_ops = {
+ 	.name	= OOB_NAME,
+ 	.proto	= DSA_TAG_PROTO_OOB,
+ 	.xmit	= oob_tag_xmit,
+ 	.rcv	= oob_tag_rcv,
++	.connect = oob_connect,
++	.disconnect = oob_disconnect,
+ };
+ 
+ MODULE_LICENSE("GPL");
