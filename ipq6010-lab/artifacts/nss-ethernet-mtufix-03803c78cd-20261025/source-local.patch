+		return false;
+	flow_rule_match_meta(rule, &meta);
+	if (ppe_flow_port_by_ifindex(priv, meta.key->ingress_ifindex) < 0)
+		return false;
+	flow_action_for_each(i, act, &rule->action)
+		if (act->id == FLOW_ACTION_REDIRECT)
