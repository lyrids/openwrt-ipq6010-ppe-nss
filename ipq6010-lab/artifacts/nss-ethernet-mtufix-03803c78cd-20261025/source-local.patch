+static bool nss_ethernet_port(struct nss_core *core, int ifindex)
+{
+	struct net_device *dev;
+	u32 mtu;
+
+	guard(rcu)();
+	dev = dev_get_by_index_rcu(&init_net, ifindex);
+	return dev && dsa_user_dev_check(dev) &&
+	       nss_flow_ifnum(core, ifindex, &mtu) >= 0;
