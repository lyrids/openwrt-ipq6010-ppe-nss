+	if (IS_ERR(dp))
 		return -ENODEV;
 
+#ifdef DSA_TAG_PROTO_QCA_8021Q_VALUE
+	if (dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_QCA_8021Q)
