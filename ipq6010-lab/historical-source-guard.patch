diff --git a/package/kernel/nss-wifi-drv/src/nss_flow.c b/package/kernel/nss-wifi-drv/src/nss_flow.c
index bb34bf3646..69abafdc6f 100644
--- a/package/kernel/nss-wifi-drv/src/nss_flow.c
+++ b/package/kernel/nss-wifi-drv/src/nss_flow.c
@@ -380,9 +380,19 @@ int nss_flow_port(struct nss_core *core, int ifindex, u16 flow_vid, u32 *mtu,
 	if (!dev || !dsa_user_dev_check(dev))
 		return -ENODEV;
 	dp = dsa_port_from_netdev(dev);
